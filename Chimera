--============================================================================--
function Chimera:BuildVFlyGUI()
    if self.UI.VFlyScreenGui then self.UI.VFlyScreenGui:Destroy() end
    
    local ScreenGui = Create.Element("ScreenGui", { 
        Name = "VFlyGUI", 
        Parent = PlayerGui, 
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, 
        ResetOnSpawn = false, 
        Enabled = false, 
        DisplayOrder = 100 
    })
    self.UI.VFlyScreenGui = ScreenGui
    -- FIX RACE : VFlySetEnabled existe AVANT la fin du build (Panic / le toggle GUI
    -- principal peuvent l'appeler pendant que le task.spawn de build tourne encore)
    Chimera.VFlySetEnabled = Chimera.VFlySetEnabled or function() end

    task.spawn(function()
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local TweenService = game:GetService("TweenService")
        local UserInputService = game:GetService("UserInputService")
        local Camera = workspace.CurrentCamera
        local LocalPlayer = Players.LocalPlayer
        
        -- =====================================================================
        -- VARIABLES D'ÉTAT (LOGIQUE 2.8)
        -- =====================================================================
        local flySpeed = 100
        Chimera.State.flyKeyMode = Chimera.State.flyKeyMode or "WASD"
        local verticalFlyInput = 0
        local isFlyOn, isDestroyerOn, isNoclipOn, isGravityOn = false, false, false, false
        
        local flyBV, flyBG, cameraPart = nil, nil, nil
        local noclipLoop, gravityLoop, destroyerLoop = nil, nil, nil
        local antiGravityForce = nil
        local originalOcclusionMode = LocalPlayer.DevCameraOcclusionMode
        
        local destroyedItems = {}
        local immuneItems = {}
        local originalCollisionStates = {}
        local ActiveModifiers = {}
        local flyConnections = {} -- Toutes les connexions globales, libérées à la fermeture du HUD
        local DESTROY_RADIUS = 15
        local TileSetters = {} -- Contrôleurs visuels des tuiles (pour tout réinitialiser d'un coup)

        -- =====================================================================
        -- FONCTIONS PHYSIQUES (LOGIQUE 2.8 BRUTE)
        -- =====================================================================
        local function cleanupFlyMovers() 
            if flyBV then flyBV:Destroy(); flyBV = nil end 
            if flyBG then flyBG:Destroy(); flyBG = nil end 
            if cameraPart then cameraPart:Destroy(); cameraPart = nil end 
            pcall(function() Camera.CameraSubject = LocalPlayer.Character.Humanoid end)
            LocalPlayer.DevCameraOcclusionMode = originalOcclusionMode 
        end

        local function startFlyLoop() 
            cleanupFlyMovers()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("Humanoid") then return end
            local hum = char.Humanoid
            local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            local target = hum.SeatPart or hrp
            
            originalOcclusionMode = LocalPlayer.DevCameraOcclusionMode
            LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
            
            cameraPart = Instance.new("Part", workspace)
            cameraPart.Name = "ChimeraFlyCam"; cameraPart.Transparency = 1; cameraPart.Anchored = true; cameraPart.CanCollide = false
            Camera.CameraSubject = cameraPart
            
            flyBV = Instance.new("BodyVelocity", target); flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            flyBG = Instance.new("BodyGyro", target); flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9); flyBG.P = 20000
            
            while isFlyOn and target.Parent and char.Parent do
                cameraPart.CFrame = hrp.CFrame
                flyBG.CFrame = Camera.CFrame
                
                local moveDir = Vector3.new(0, 0, 0)
                local mode = Chimera.State.flyKeyMode
                local Fwd = (mode == "ZQSD" and Enum.KeyCode.Z or Enum.KeyCode.W)
                local Back = Enum.KeyCode.S
                local Left = (mode == "ZQSD" and Enum.KeyCode.Q or Enum.KeyCode.A)
                local Right = Enum.KeyCode.D

                if UserInputService:IsKeyDown(Fwd) then moveDir += Vector3.new(0, 0, -1) end
                if UserInputService:IsKeyDown(Back) then moveDir += Vector3.new(0, 0, 1) end
                if UserInputService:IsKeyDown(Left) then moveDir += Vector3.new(-1, 0, 0) end
                if UserInputService:IsKeyDown(Right) then moveDir += Vector3.new(1, 0, 0) end
                
                -- Support Mobile (MoveDirection) si pas de touches pressées
                if moveDir.Magnitude == 0 and hum.MoveDirection.Magnitude > 0 then
                    local camRel = Camera.CFrame:VectorToObjectSpace(hum.MoveDirection)
                    moveDir = Vector3.new(camRel.X, 0, camRel.Z)
                end

                local finalVector = (Camera.CFrame.LookVector * -moveDir.Z) + (Camera.CFrame.RightVector * moveDir.X)
                flyBV.Velocity = (finalVector * flySpeed) + Vector3.new(0, verticalFlyInput * flySpeed, 0)
                RunService.Heartbeat:Wait()
            end
            cleanupFlyMovers()
        end

        -- =====================================================================
        -- DESTROYER INTELLIGENT v2 (bbox-aware : plus de flicker sur sols/murs)
        -- Fantôme = la BBOX touche la sphère ; Restore = elle ne la touche plus.
        -- Exclusions : votre perso, votre véhicule, persos/NPCs, parts déjà invisibles.
        -- =====================================================================
        local seenThisFrame = {}

        local function restoreDestroyedPart(part, data)
            if part and part.Parent then
                pcall(function()
                    part.Transparency = data.OriginalTransparency
                    part.CanCollide = data.OriginalCanCollide
                    part.Anchored = data.OriginalAnchored
                end)
            end
        end

        -- Restore TOUS les objets fantômés (désactivation, vol coupé, fermeture du HUD)
        local function restoreAllDestroyed()
            for part, data in pairs(destroyedItems) do
                restoreDestroyedPart(part, data)
                destroyedItems[part] = nil
            end
        end

        local function stopDestroyerLoop(restoreEverything)
            if destroyerLoop then destroyerLoop:Disconnect(); destroyerLoop = nil end
            if restoreEverything then restoreAllDestroyed() end
        end

        local function startDestroyerLoop()
            if destroyerLoop then destroyerLoop:Disconnect(); destroyerLoop = nil end
            destroyerLoop = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                -- FIX : perso disparu (mort/respawn) -> on rend TOUT (avant : figé fantôme)
                if not hrp then restoreAllDestroyed(); return end
                local center = hrp.Position

                -- FIX : vol coupé (ou destroyer désactivé) -> on rend TOUT,
                -- sinon le joueur marchait dans le vide sur des objets invisibles
                if not (isFlyOn and isDestroyerOn) then
                    restoreAllDestroyed()
                    return
                end

                -- PHASE 1 : on fantôme les objets dont la BBOX intersecte le rayon
                local params = OverlapParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { char }
                local parts = workspace:GetPartBoundsInRadius(center, DESTROY_RADIUS, params)

                for k in pairs(seenThisFrame) do seenThisFrame[k] = nil end
                local hum = char:FindFirstChildOfClass("Humanoid")
                local seatModel = (hum and hum.SeatPart and hum.SeatPart.Parent) or nil

                for _, part in ipairs(parts) do
                    seenThisFrame[part] = true
                    if part.Parent and not destroyedItems[part]
                        and not part:IsDescendantOf(char)
                        and not part.Parent:FindFirstChildOfClass("Humanoid")
                        and not (seatModel and (part == seatModel or part:IsDescendantOf(seatModel)))
                        and part.Transparency < 0.95 then
                        destroyedItems[part] = { OriginalTransparency = part.Transparency, OriginalCanCollide = part.CanCollide, OriginalAnchored = part.Anchored }
                        pcall(function() part.CanCollide = false; part.Transparency = 0.65 end)
                    end
                end

                -- PHASE 2 (FIX FLICKER) : on restaure ce qui n'a PAS été vu cette frame.
                -- Avant : comparaison à la distance du CENTRE de la part -> les grosses parts
                -- (sols, murs) flickeraient ou ne se fantômaient jamais. Critère maintenant
                -- symétrique avec la détection (bbox <-> rayon).
                for part, data in pairs(destroyedItems) do
                    if not part.Parent then
                        destroyedItems[part] = nil
                    elseif not seenThisFrame[part] then
                        restoreDestroyedPart(part, data)
                        destroyedItems[part] = nil
                    end
                end
            end)
        end

        local function startNoclip()
            isNoclipOn = true
            if noclipLoop then noclipLoop:Disconnect(); noclipLoop = nil end
            noclipLoop = RunService.Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                end
            end)
        end

        -- FIX : on rend les collisions au personnage quand on coupe le noclip
        local function stopNoclip()
            isNoclipOn = false
            if noclipLoop then noclipLoop:Disconnect(); noclipLoop = nil end
            if LocalPlayer.Character then
                for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                    if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then pcall(function() v.CanCollide = true end) end
                end
            end
        end

        -- =====================================================================
        -- CONSTRUCTION UI (DESIGN 2.9)
        -- =====================================================================
        local MainWidth = 232
        local MainFrame = Create.GlassPanel(ScreenGui, {
            Name = "GeminiMain",
            Size = UDim2.new(0, MainWidth, 0, 360),
            Position = UDim2.new(1, -MainWidth - 20, 0.5, -180),
            BackgroundColor3 = Color3.fromRGB(12, 12, 18),
            BackgroundTransparency = 0.12
        })
        self.UI.VFlyMainFrame = MainFrame
        self.UI.VFlyUIScale = Create.Element("UIScale", { Parent = MainFrame })

        -- FIX CRASH : le bouton de minimisation n'était jamais créé -> erreur nil au clic
        -- FIX v4.4 : pastille minimisee = cercle de verre avec icone avion (avant :
        -- carre "—" fige) + DRAG souris/tactile + position memorisee entre minimises
        local MinButton = Create.Element("TextButton", {
            Name = "VFlyMinButton", Parent = ScreenGui,
            Size = UDim2.new(0, 54, 0, 54), Position = UDim2.new(1, -MainWidth - 20, 0.5, -180),
            BackgroundColor3 = Theme.Current.Primary, BackgroundTransparency = 0.15,
            Text = "", AutoButtonColor = false, Visible = false, ZIndex = 5
        })
        MinButton:SetAttribute("ThemeType", "PrimaryGlass")
        Create.Element("UICorner", { Parent = MinButton, CornerRadius = UDim.new(1, 0) })
        local vflyMinStroke = Create.Element("UIStroke", { Parent = MinButton, Color = Theme.Current.Accent, Thickness = 1.2, Transparency = 0.45 })
        vflyMinStroke:SetAttribute("ThemeType", "AccentStroke")
        -- reflet liquid glass : arc superieur
        local minSheen = Create.Element("Frame", { Parent = MinButton, Size = UDim2.new(1, -14, 0, 11), Position = UDim2.new(0.5, 0, 0, 5), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.88, BorderSizePixel = 0, ZIndex = 6 })
        Create.Element("UICorner", { Parent = minSheen, CornerRadius = UDim.new(0, 7) })
        Create.Element("ImageLabel", { Name = "MinIcon", Parent = MinButton, Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(0.5, 0, 0.42, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Image = "rbxassetid://10709791437", ImageColor3 = Theme.Current.Accent, ZIndex = 6 })
        local minLbl = Create.Element("TextLabel", { Parent = MinButton, Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 0.66, 0), BackgroundTransparency = 1, Text = "FLY", Font = Enum.Font.GothamBold, TextSize = 8, TextColor3 = Theme.Current.TextSecondary, ZIndex = 6 })
        minLbl:SetAttribute("ThemeType", "TextSecondary")
        self.UI.VFlyMinButton = MinButton

        -- DRAG de la pastille (souris + tactile) : un tap SANS mouvement restaure le HUD
        if self.State.VFlyMinPos then MinButton.Position = self.State.VFlyMinPos end
        local hudBusy = false -- v4.5 : verrou pendant les animations minimize/restore
        local pillDrag, pillMoved, pillStart, pillOrigin = false, false, nil, nil
        MinButton.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                pillDrag, pillMoved = true, false
                pillStart, pillOrigin = i.Position, MinButton.Position
                TweenService:Create(MinButton, TweenInfo.new(0.15), { BackgroundTransparency = 0.05 }):Play()
            end
        end)
        MinButton.InputChanged:Connect(function(i)
            if pillDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - pillStart
                if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then pillMoved = true end
                MinButton.Position = UDim2.new(pillOrigin.X.Scale, pillOrigin.X.Offset + d.X, pillOrigin.Y.Scale, pillOrigin.Y.Offset + d.Y)
            end
        end)
        MinButton.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                pillDrag = false
                self.State.VFlyMinPos = MinButton.Position
                TweenService:Create(MinButton, TweenInfo.new(0.2), { BackgroundTransparency = 0.15 }):Play()
                -- FIX v4.5 : restauration ANIMEE (la pastille se replie, le HUD pop)
                if not pillMoved and not hudBusy then
                    hudBusy = true
                    local shrink = TweenService:Create(MinButton, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 0) })
                    shrink:Play()
                    shrink.Completed:Wait()
                    MinButton.Visible = false
                    MinButton.Size = UDim2.new(0, 54, 0, 54)
                    MainFrame.Visible = true
                    MainFrame.ClipsDescendants = true
                    MainFrame.Size = UDim2.new(0, 0, 0, 0)
                    MainFrame.BackgroundTransparency = 1
                    local pop = TweenService:Create(MainFrame, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, MainWidth, 0, 360), BackgroundTransparency = 0.12 })
                    pop:Play()
                    pop.Completed:Connect(function()
                        MainFrame.ClipsDescendants = false
                        hudBusy = false
                    end)
                end
            end
        end)

        local Header = Create.Element("Frame", {Parent = MainFrame, Size = UDim2.new(1,0,0,42), BackgroundTransparency = 1})
        -- FIX VISUEL : la couleur du titre suit maintenant le thème (avant : bleu en dur)
        local accentHex = string.format("#%02X%02X%02X", math.floor(Theme.Current.Accent.R * 255 + 0.5), math.floor(Theme.Current.Accent.G * 255 + 0.5), math.floor(Theme.Current.Accent.B * 255 + 0.5))
        -- POIGNEE visible : petite barre de grip = zone de drag évidente (souris ET doigt)
        local Grip = Create.Element("Frame", {Parent = Header, Size = UDim2.new(0, 38, 0, 4), Position = UDim2.new(0.5, 0, 0, 5), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Theme.Current.TextSecondary, BackgroundTransparency = 0.5, BorderSizePixel = 0, ZIndex = 3})
        Create.Element("UICorner", {Parent = Grip, CornerRadius = UDim.new(1, 0)})
        local Title = Create.Element("TextLabel", {Parent = Header, Size = UDim2.new(1,-56,0,20), Position = UDim2.new(0,14,0,16), Text = "FLIGHT <font color='" .. accentHex .. "'>// HUD</font>", Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1,1,1), TextSize = 12, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1})
        local MinBtn = Create.Element("TextButton", {Parent = Header, Size = UDim2.new(0,26,0,26), Position = UDim2.new(1,-10,0,12), AnchorPoint = Vector2.new(1,0), Text = "—", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Color3.new(1,1,1), BackgroundColor3 = Theme.Current.Secondary, BackgroundTransparency = 0.26, AutoButtonColor = false})
        Create.Element("UICorner", {Parent = MinBtn, CornerRadius = UDim.new(1, 0)})
        Create.Element("UIStroke", {Parent = MinBtn, Color = Color3.new(1,1,1), Thickness = 1.4, Transparency = 0.7})
        local minScaler = Create.Element("UIScale", { Parent = MinBtn })
        MinBtn.MouseEnter:Connect(function()
            TweenService:Create(MinBtn, TweenInfo.new(0.16), { BackgroundTransparency = 0.12 }):Play()
            TweenService:Create(minScaler, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Scale = 1.08 }):Play()
        end)
        MinBtn.MouseLeave:Connect(function()
            TweenService:Create(MinBtn, TweenInfo.new(0.22), { BackgroundTransparency = 0.26 }):Play()
            TweenService:Create(minScaler, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
        end)
        -- SIGNATURE DE MARQUE : liseré dégradé GradientA->B sous le header (base blanche +
        -- UIGradient 2 keypoints 0/1 -> recoloré automatiquement par le sweep d'ApplyTheme)
        local headerUnderline = Create.Element("Frame", {Parent = MainFrame, Size = UDim2.new(1, -28, 0, 2), Position = UDim2.new(0.5, 0, 0, 42), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.25, BorderSizePixel = 0, ZIndex = 3})
        Create.Element("UICorner", {Parent = headerUnderline, CornerRadius = UDim.new(1, 0)})
        Create.Element("UIGradient", {Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB), Parent = headerUnderline})

