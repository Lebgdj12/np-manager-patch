function Chimera:ToggleObjectController(requestState, OnSuccessCallback)
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local Camera = workspace.CurrentCamera
    local LocalPlayer = Players.LocalPlayer
    local StarterGui = game:GetService("StarterGui")

    -- === LOGIQUE OFF (RESTAURATION EXACTE CHIMERA) ===
    if not requestState then
        local LastPos = nil
        if self.State.ObjectControllerActive then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then LastPos = char.HumanoidRootPart.CFrame end
        end

        self.State.ObjectControllerActive = false
        
        -- Nettoyage des boucles
        if self.State.ObjectControllerLoop then self.State.ObjectControllerLoop:Disconnect(); self.State.ObjectControllerLoop = nil end
        if self.State.ObjectControllerTrollLoop then self.State.ObjectControllerTrollLoop:Disconnect(); self.State.ObjectControllerTrollLoop = nil end
        if self.State.InternalResetEvent then self.State.InternalResetEvent:Fire(); self.State.InternalResetEvent = nil end
        
        pcall(function() StarterGui:SetCore("ResetButtonCallback", true) end)
        
        -- Respawn Handler (Restauration des stats sauvegardées)
        local respawnConn; respawnConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
            local newHum = newChar:WaitForChild("Humanoid", 10)
            local newRoot = newChar:WaitForChild("HumanoidRootPart", 10)
            
            if newHum and newRoot then
                task.wait(0.1)
                if self.State.ObjectTpOnRespawn and LastPos then newRoot.CFrame = LastPos end
                
                -- On remet ta vitesse et ton saut d'origine
                newHum.WalkSpeed = self.State.ObjectRestoreWS or 16
                newHum.JumpPower = self.State.ObjectRestoreJP or 50
                
                -- On débloque les états
                newHum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
                newHum.PlatformStand = false
                newHum.Sit = false
            end
            if respawnConn then respawnConn:Disconnect() end
        end)

        -- Mort pour réinitialiser le personnage proprement (FE obligatoy)
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then hum.Health = 0 end
            char:BreakJoints()
        end
        
        return "OFF"
    end

    -- === LOGIQUE ON (START) ===
    local Character = LocalPlayer.Character
    local Tool = Character:FindFirstChildWhichIsA("Tool") or LocalPlayer.Backpack:FindFirstChildWhichIsA("Tool")
    
    if not Tool then
        self:ShowNotification("notif_feature_toggled", "Erreur", "Aucun outil trouvé !")
        return "ERROR"
    end

    -- Sauvegarde des stats actuelles avant transformation
    local currentHum = Character:FindFirstChild("Humanoid")
    if currentHum then
        self.State.ObjectRestoreWS = currentHum.WalkSpeed
        self.State.ObjectRestoreJP = currentHum.JumpPower
    end

    self.State.ObjectControllerActive = true
    self:ShowNotification("notif_feature_toggled", "Status", "Transformation...")

    task.spawn(function()
        if not self.State.ObjectControllerActive then return end
        local Handle = Tool:FindFirstChild("Handle") or Tool:FindFirstChildWhichIsA("BasePart", true)
        local Humanoid = Character:FindFirstChildWhichIsA("Humanoid")
        local RootPart = Character:FindFirstChild("HumanoidRootPart")
        
        if not Handle or not Humanoid or not RootPart then return end

        local StartCFrame = RootPart.CFrame 
        local ResetBindable = Instance.new("BindableEvent")
        self.State.InternalResetEvent = ResetBindable

        -- REPLICATE SIGNAL EXACT (Version Anthony)
        if getgenv().replicatesignal then pcall(function() replicatesignal(LocalPlayer.ConnectDiedSignalBackend) end) end
        wait(Players.RespawnTime + 0.15)
        
        if not self.State.ObjectControllerActive then return end

        -- Glitch de possession
        Humanoid:EquipTool(Tool)
        repeat task.wait() until Character:FindFirstChildWhichIsA("Tool")
        Humanoid:UnequipTools()
        repeat LocalPlayer:Move(Vector3.new(1/0, 1/0, 1/0)); task.wait() until Humanoid.Health == 0
        repeat task.wait() until not Character:FindFirstChildWhichIsA("BasePart")
        
        if not self.State.ObjectControllerActive then return end

        Humanoid:EquipTool(Tool)
        Camera.CameraSubject = Handle
        Handle.Name = "HumanoidRootPart"
        Handle.Parent = Character

        if OnSuccessCallback then OnSuccessCallback() end

        -- === PHYSIQUE BOOSTER ===
        local BodyPos = Instance.new("BodyPosition", Handle)
        local BodyGyro = Instance.new("BodyGyro", Handle)
        BodyPos.P, BodyPos.MaxForce = 10000, Vector3.new(math.huge, math.huge, math.huge)
        BodyPos.Position = StartCFrame.Position 
        BodyGyro.MaxTorque, BodyGyro.CFrame = Vector3.new(9e9, 9e9, 9e9), StartCFrame

        local Speed = 0
        local sineCounter = 0

        self.State.ObjectControllerLoop = RunService.RenderStepped:Connect(function()
            if not self.State.ObjectControllerActive or not Handle or not Handle.Parent then return end

            -- 1. DETECTION TYPE INPUT (Logique Originale Chimera)
            local inputType = UserInputService:GetLastInputType()
            local isKeyboard = (inputType == Enum.UserInputType.Keyboard or inputType == Enum.UserInputType.MouseMovement)
            
            -- 2. CONFIG DES TOUCHES (Le "Blocker" ZQSD vs WASD)
            local mode = self.State.ObjectControllerType
            local Fwd, Back, Left, Right, Down, Up
            if mode == "ZQSD" then
                Fwd, Back, Left, Right = Enum.KeyCode.Z, Enum.KeyCode.S, Enum.KeyCode.Q, Enum.KeyCode.D
                Down = Enum.KeyCode.A -- Le A de ZQSD pour descendre (souvent utilisé)
            else 
                Fwd, Back, Left, Right = Enum.KeyCode.W, Enum.KeyCode.S, Enum.KeyCode.A, Enum.KeyCode.D
                Down = Enum.KeyCode.Q -- Le Q de WASD pour descendre
            end
            Up = Enum.KeyCode.E

            local moveVec = Vector3.new(0,0,0)
            local vMove = 0
            local isMoving = false
            local targetMaxSpeed = self.State.ObjectSpeed or 1
            
            -- Calcul de base NewPos (Anthony Math)
            local NewPos = BodyGyro.CFrame - BodyGyro.CFrame.p + BodyPos.Position

            -- 3. LOGIQUE DE MOUVEMENT SÉPARÉE (Le Fix que tu voulais)
            if isKeyboard then
                -- On ne regarde QUE les touches définies par le mode (ZQSD ou WASD)
                -- Cela bloque les touches WASD natives de Roblox si tu es en mode ZQSD
                if UserInputService:IsKeyDown(Fwd) then moveVec += Vector3.new(0, 0, -1); isMoving = true end
                if UserInputService:IsKeyDown(Back) then moveVec += Vector3.new(0, 0, 1); isMoving = true end
                if UserInputService:IsKeyDown(Left) then moveVec += Vector3.new(-1, 0, 0); isMoving = true end
                if UserInputService:IsKeyDown(Right) then moveVec += Vector3.new(1, 0, 0); isMoving = true end
                if UserInputService:IsKeyDown(Up) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then vMove = 1; isMoving = true end
                if UserInputService:IsKeyDown(Down) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vMove = -1; isMoving = true end
                
                -- Application Keyboard
                NewPos = NewPos + (Camera.CFrame.LookVector * -moveVec.Z * Speed)
                NewPos = NewPos + (Camera.CFrame.RightVector * moveVec.X * Speed)
                NewPos = NewPos + Vector3.new(0, vMove * Speed, 0)
            else
                -- Mode Joystick (Si pas de clavier détecté ou si on bouge le stick)
                local joystickDir = Humanoid.MoveDirection
                if joystickDir.Magnitude > 0 then
                    isMoving = true
                    local camRel = Camera.CFrame:VectorToObjectSpace(joystickDir)
                    NewPos = NewPos + (Camera.CFrame.LookVector * -camRel.Z * Speed)
                    NewPos = NewPos + (Camera.CFrame.RightVector * camRel.X * Speed)
                end
            end

-- [DANS LA BOUCLE RENDERSTEPPED]
            
            -- 3. LOGIQUE DE MOUVEMENT (AVEC CHOIX DE LOGIQUE)
            if isMoving then
                if self.State.ObjectProgressiveSpeed then
                    -- Logique Anthony : Accélération progressive
                    Speed = math.min(Speed + 0.01, targetMaxSpeed)
                else
                    -- Logique Originale : Vitesse instantanée
                    Speed = targetMaxSpeed
                end
            else
                if self.State.ObjectProgressiveSpeed then
                    -- Freinage fluide
                    Speed = math.max(Speed * 0.9, 0)
                else
                    -- Arrêt net
                    Speed = 0
                end
            end

            -- 5. EFFET TILT & SINE HOVER
            -- On détermine si on avance ou recule pour le tilt
            local isFwd = false
            local isBck = false
            if isKeyboard then
                isFwd = UserInputService:IsKeyDown(Fwd)
                isBck = UserInputService:IsKeyDown(Back)
            else
                isFwd = (Humanoid.MoveDirection.Magnitude > 0 and Camera.CFrame:VectorToObjectSpace(Humanoid.MoveDirection).Z < -0.5)
            end

            if isFwd then
                BodyGyro.CFrame = Camera.CFrame * CFrame.Angles(-math.rad(Speed * 15), 0, 0)
            elseif isBck then
                BodyGyro.CFrame = Camera.CFrame * CFrame.Angles(math.rad(Speed * 15), 0, 0)
            else
                -- Sine Hover (Flottement à l'arrêt)
                sineCounter = sineCounter + 0.05
                BodyGyro.CFrame = Camera.CFrame
                NewPos = NewPos + Vector3.new(0, math.sin(sineCounter) / 40, 0)
            end

            BodyPos.Position = NewPos.p
        end)

        -- Fling (X)
