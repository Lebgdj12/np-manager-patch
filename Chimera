    -- === CAMLOCK V2 (HARD LOCK CAM + FOV + PREDICTION) ===
    -- =========================================================================
    
    -- 1. CONFIGURATION ET VARIABLES
    if not self.State.CamLockFOV then self.State.CamLockFOV = 120 end
    if not self.State.CamLockSmooth then self.State.CamLockSmooth = 0.15 end
