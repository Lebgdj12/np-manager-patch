Chimera.Config = {}
local ConfigFileName = "Chimera_SecureConfig_v4.chim" -- Extension personnalisée
local CryptoKey = "CHIMERA_SECRET_KEY_999" -- Clé de chiffrement

-- Fonctions de Chiffrement (XOR simple mais efficace)
local function Cipher(text, key)
    local result = {}
    for i = 1, #text do
        local keyChar = string.byte(key, (i - 1) % #key + 1)
        table.insert(result, string.char(bit32.bxor(string.byte(text, i), keyChar)))
    end
    return table.concat(result)
end

-- Encodage Base64 pour pouvoir écrire le binaire dans un fichier texte
local function to_base64(data)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    return ((data:gsub('.', function(x) 
        local r,b='',x:byte()
        for i=8,1,-1 do r=r..(b%2^i-b%2^(i-1)>0 and '1' or '0') end
        return r;
    end)..'0000'):gsub('%d%d%d?%d?%d?%d?', function(x)
        if (#x < 6) then return '' end
        local c=0
        for i=1,6 do c=c+(x:sub(i,i)=='1' and 2^(6-i) or 0) end
        return b:sub(c+1,c+1)
    end)..({ '', '==', '=' })[#data%3+1])
end

local function from_base64(data)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    data = string.gsub(data, '[^'..b..'=]', '')
    return (data:gsub('.', function(x)
        if (x == '=') then return '' end
        local r,f='',(b:find(x)-1)
        for i=6,1,-1 do r=r..(f%2^i-f%2^(i-1)>0 and '1' or '0') end
        return r;
    end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
        if (#x ~= 8) then return '' end
        local c=0
        for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end
        return string.char(c)
    end))
end

function Chimera.Config:Save(isSilent)
    if not writefile then return end

    local data = {
        Theme = Chimera.State.CurrentThemeName or "Abyss",
        UI = {
            Scale = Chimera.UI.MainUIScale and Chimera.UI.MainUIScale.Scale or 1,
            Blur = Chimera.State.isBlurActive or false,
            RestoreOnRespawn = Chimera.State.restoreOnRespawn or false,
            AnimSpeed = Theme.Animations.Speed or 0.2,
            NotifCorner = Chimera.State.NotifCorner or "bottom_right"
        },
        Chat = {
            TranslatorEnabled = Chimera.State.ChatTranslate or false,
            TargetLanguage = Chimera.State.ChatTranslateLang or "fr",
            AutoScroll = Chimera.State.ChatAutoScroll ~= false,
            InputMode = Chimera.State.ChatInputMode or "Normal"
        }
    }

    -- 1. JSON Encode
    local json = game:GetService("HttpService"):JSONEncode(data)
    -- 2. Chiffrement XOR
    local encrypted = Cipher(json, CryptoKey)
    -- 3. Base64 (pour l'écriture fichier)
    local finalContent = to_base64(encrypted)

    pcall(function() writefile(ConfigFileName, finalContent) end)
    
    if not isSilent then 
        Chimera:ShowNotification("Système", "Sauvegarde Cryptée OK !") 
    end
end

function Chimera.Config:Load()
    if not isfile or not isfile(ConfigFileName) then return end

    local success, content = pcall(function() return readfile(ConfigFileName) end)
    if success and content ~= "" then
        -- 1. Base64 Decode
        local decodedB64 = from_base64(content)
        -- 2. Dechiffrement XOR
        local decryptedJson = Cipher(decodedB64, CryptoKey)
        -- 3. JSON Decode
        local decoded = nil
        pcall(function() decoded = game:GetService("HttpService"):JSONDecode(decryptedJson) end)

        if not decoded then return end -- Fichier corrompu ou mauvaise clé

        -- Appliquer les réglages
        if decoded.Theme then Chimera:ApplyTheme(decoded.Theme, true) end

        if decoded.UI then
            if decoded.UI.Scale and Chimera.UI.MainUIScale then
                Chimera.UI.MainUIScale.Scale = decoded.UI.Scale
                if Chimera.UI.SliderControllers.UIScale then Chimera.UI.SliderControllers.UIScale:SetValue(decoded.UI.Scale) end
            end
            if decoded.UI.Blur ~= nil then
                Chimera.State.isBlurActive = decoded.UI.Blur
                if Chimera.State.isBlurActive then Create.Blur() end
            end
            if decoded.UI.RestoreOnRespawn ~= nil then Chimera.State.restoreOnRespawn = decoded.UI.RestoreOnRespawn end
            if decoded.UI.NotifCorner and Chimera.NotifCorners and Chimera.NotifCorners[decoded.UI.NotifCorner] then
                Chimera.State.NotifCorner = decoded.UI.NotifCorner
            end
            if decoded.UI.AnimSpeed then
                Theme.Animations.Speed = decoded.UI.AnimSpeed
