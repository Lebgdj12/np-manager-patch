local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local TweenService = game:GetService("TweenService") -- On a besoin de ça pour l'anim

-- On cherche l'interface principale
local existingGui = PlayerGui:FindFirstChild("ChimeraUI")

if existingGui then
    -- On cherche nos deux éléments principaux
    local mainFrame = existingGui:FindFirstChild("MainFrame")
    local minimizedBtn = existingGui:FindFirstChild("MinimizedButton")
    
    -- CAS 1 : L'interface est MINIMISÉE (Le bouton est visible)
    if minimizedBtn and minimizedBtn.Visible then
        -- On l'anime vers le centre
        minimizedBtn.AnchorPoint = Vector2.new(0.5, 0.5)
        TweenService:Create(minimizedBtn, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }):Play()
        
        -- On notifie (optionnel, tu as dit que tu n'en voulais pas, donc on peut commenter)
        -- print("Chimera: Interface minimisée détectée et recentrée.")
        
        return -- STOP : On arrête le nouveau script ici !
    end

    -- CAS 2 : L'interface est OUVERTE (MainFrame est visible ou devrait l'être)
    if mainFrame then
        mainFrame.Visible = true
        mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
        
        -- On s'assure que le contenu est visible (transparence)
        local content = mainFrame:FindFirstChild("MainContent")
        if content then content.BackgroundTransparency = 0.3 end -- Ou Theme.Glass.Transparency si dispo, mais ici on met 0.3 en dur pour être sûr
        
        TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }):Play()
        
        return -- STOP : On arrête le nouveau script ici !
    end
    
    -- CAS 3 : Le GUI existe mais est "vide" ou cassé (aucun frame trouvé)
    -- Dans ce cas, on détruit l'ancien pour laisser le nouveau se lancer
    existingGui:Destroy()
end

