    local function IsIgnoredPart(part)
        if not part then return false end
        if not part:IsA("BasePart") then return false end
        if part.Transparency >= 1 and part.Name ~= "HumanoidRootPart" then return true end
        return false
    end

    local function IsTeammate(model)
        if not self.State.TeamCheck then return false end
        local player = Players:GetPlayerFromCharacter(model)
        local settings = self.State.TeamCheckSettings 
        if settings.TeamObject and player then
            if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then return true end
        end
        if settings.TeamColor and player then
            if LocalPlayer.TeamColor and player.TeamColor and LocalPlayer.TeamColor == player.TeamColor then return true end
        end
        if settings.Attributes then
            local myCustomTeam = LocalPlayer:GetAttribute("Team") or LocalPlayer:GetAttribute("Squad"); local targetCustomTeam = model:GetAttribute("Team") or model:GetAttribute("Squad")
            if LocalPlayer.Character then local val = LocalPlayer.Character:FindFirstChild("Team") or LocalPlayer.Character:FindFirstChild("TeamName"); if val then myCustomTeam = val.Value end end
            local targetVal = model:FindFirstChild("Team") or model:FindFirstChild("TeamName"); if targetVal then targetCustomTeam = targetVal.Value end
            if myCustomTeam and targetCustomTeam and myCustomTeam == targetCustomTeam then return true end
        end
        if settings.BodyColor then
            local targetBody = model:FindFirstChild("Head") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChildWhichIsA("BasePart")
            if targetBody and LocalPlayer.Character then
                local myBody = LocalPlayer.Character:FindFirstChild("Head") or LocalPlayer.Character:FindFirstChild("Torso") or LocalPlayer.Character:FindFirstChild("UpperTorso") or LocalPlayer.Character:FindFirstChildWhichIsA("BasePart")
                if myBody and myBody.Color == targetBody.Color then return true end
            end
        end
        return false 
    end

    local function IsVisible(targetPart, targetModel)
        if not self.State.WallCheck then return true end
        local Origin, End = Camera.CFrame.Position, targetPart.Position
        local Direction = End - Origin
        local RayParams = RaycastParams.new(); RayParams.FilterType = Enum.RaycastFilterType.Blacklist
        local IgnoreList = {LocalPlayer.Character, targetModel, Camera}
        RayParams.FilterDescendantsInstances = IgnoreList; RayParams.IgnoreWater = true 
        local SafetyCounter = 0 
        while SafetyCounter < 10 do 
            SafetyCounter = SafetyCounter + 1
            local Result = Workspace:Raycast(Origin, Direction, RayParams)
            if not Result then return true end 
            if Result.Instance:IsDescendantOf(targetModel) then return true end 
            local HitPart = Result.Instance
            if HitPart.Transparency > 0.5 or not HitPart.CanCollide or HitPart.Name == "Handle" or string.find(string.lower(HitPart.Name), "glass") or string.find(string.lower(HitPart.Name), "window") then table.insert(IgnoreList, HitPart); RayParams.FilterDescendantsInstances = IgnoreList else return false end
        end
        return false
    end

    local function IsMyOwn(model)
        if not model then return false end
        if model == LocalPlayer.Character then return true end
        if model:IsDescendantOf(LocalPlayer.Character) then return true end
        return false
    end

    local function GetBodyCenter(model)
        if not model then return nil end
        if not model:IsA("Model") then if model:IsA("BasePart") and not IsIgnoredPart(model) then return model.Position else return nil end end
        local centerPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Chest")
        if centerPart then return centerPart.Position end
        if model.PrimaryPart then return model.PrimaryPart.Position end
        return model:GetPivot().Position + Vector3.new(0, 1.5, 0)
    end

    -- === SYSTEME DE CACHE UNIFIÉ (ANTI-LAG) ===
    -- Cette boucle met à jour la liste des cibles toutes les 0.5s au lieu de chaque frame
    local function StartCacheLoop()
        pcall(function() RunService:UnbindFromRenderStep("ChimeraCacheLoop") end)
        
        local LastUpdate = 0
        RunService:BindToRenderStep("ChimeraCacheLoop", Enum.RenderPriority.First.Value, function()
            if tick() - LastUpdate < 0.5 then return end -- Update 2x par seconde max
            LastUpdate = tick()
            
            if not self.State.AimbotStandard and not self.State.AimbotHard then return end

            local newCache = {}
            local signature = self.State.CurrentSignature
            
            -- Scan des joueurs (Toujours actif)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local char = p.Character
                    if not IsMyOwn(char) and not IsTeammate(char) then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        local hum = char:FindFirstChild("Humanoid")
                        if root and hum and hum.Health > 0 then
                            table.insert(newCache, char)
                        end
                    end
                end
            end

            -- Scan des objets (Uniquement si signature définie)
            if signature and signature.Type == "PartName" then
                -- Attention : GetDescendants reste lourd, on limite aux modèles proches si possible
                -- Pour simplicité, on garde Workspace mais avec le délai de 0.5s c'est OK
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and not IsMyOwn(obj) then
                         if obj:FindFirstChild(signature.KeyPart) then
                             if self.State.TeamCheck then
                                 if not IsTeammate(obj) then table.insert(newCache, obj) end
                             else
                                 table.insert(newCache, obj)
                             end
                         end
                    end
                end
            end
            
            GlobalTargetCache = newCache
        end)
    end
    StartCacheLoop()

