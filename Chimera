-- helper : cree une instance, regle ses proprietes, parent EN DERNIER (bonne pratique)
local function create(className, props)
        local inst = Instance.new(className)
        local parent = nil
        for key, value in pairs(props or {}) do
                if key == "Parent" then
                        parent = value
                else
                        inst[key] = value
                end
        end
        if parent then
                inst.Parent = parent
        end
        return inst
end

