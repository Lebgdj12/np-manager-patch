Chimera._ToggleBindings = {}
function Chimera:SyncToggleUI(key, on)
    local list = self._ToggleBindings[key]
    if not list then return end
    for _, c in ipairs(list) do
        pcall(function() if c and c.SetVisual then c:SetVisual(on and true or false) end end)
    end
end

