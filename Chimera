        Thickness = 1.2,
        Transparency = 0.65,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    })
    
    -- 3. Le texte
    local label = Create.Element("TextLabel", {
        Name = "ToggleLabel",
        Parent = container,
        Size = UDim2.new(1, -75, 1, 0),
        Position = UDim2.new(0, 15, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        Font = Theme.Fonts.Header,
        TextColor3 = Theme.Current.TextPrimary,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    })
    
    -- 4. Le rail du switch (Track) — ANCIEN STYLE (retour demandé) : rail verre,
    --    knob qui rebondit (Easing Back), tout s'allume à la COULEUR D'ACCENT du thème
    local switchTrack = Create.Element("Frame", {
        Name = "Track",
        Parent = container,
        Size = UDim2.new(0, 44, 0, 24),
        Position = UDim2.new(1, -15, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = Theme.Current.Secondary,
        BackgroundTransparency = 0.25
    })
    Create.Element("UICorner", {CornerRadius = UDim.new(1, 0), Parent = switchTrack})
    local trackStroke = Create.Element("UIStroke", {
        Name = "ToggleTrackStroke",
        Parent = switchTrack,
        Color = Theme.Current.TextSecondary,
        Thickness = 1,
        Transparency = 0.7
    })

    -- DÉGRADÉ DE MARQUE : le rail s'allume en GradientA -> GradientB quand le toggle est ON
    local trackGradFill = Create.Element("Frame", {
        Name = "GradFill",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = state and 0 or 1,
        BorderSizePixel = 0,
        ZIndex = 1,
        Parent = switchTrack
    })
    Create.Element("UICorner", { CornerRadius = UDim.new(1, 0), Parent = trackGradFill })
    Create.Element("UIGradient", {
        Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB),
        Rotation = 90,
        Parent = trackGradFill
    })

    -- 5. Le Knob (Le point qui glisse avec le rebond)
    local knob = Create.Element("Frame", {
        Name = "Knob",
        Parent = switchTrack,
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 3, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Theme.Current.TextSecondary,
        ZIndex = 2
    })
    Create.Element("UICorner", {CornerRadius = UDim.new(1, 0), Parent = knob})

    -- LOGIQUE D'ANIMATION LUXE (anciens toggles — jugés plus beaux par l'utilisateur)
    local function setVisualState(animated)
        local moveInfo = animated and TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out) or TweenInfo.new(0)
        local colorInfo = animated and TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out) or TweenInfo.new(0)

        local offColor = Theme.Current.TextSecondary

        if state then
            TweenService:Create(knob, moveInfo, {
                Position = UDim2.new(1, -3, 0.5, 0),
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1)
            }):Play()
            -- ON = rail en dégradé de marque (GradientA -> GradientB), bordure GradientB
            TweenService:Create(stroke, colorInfo, {Color = Theme.Current.GradientB, Transparency = 0.2}):Play()
            TweenService:Create(trackStroke, colorInfo, {Color = Theme.Current.GradientB, Transparency = 1}):Play()
            TweenService:Create(trackGradFill, colorInfo, {BackgroundTransparency = 0}):Play()
            TweenService:Create(label, colorInfo, {TextColor3 = Theme.Current.TextPrimary}):Play()
        else
            TweenService:Create(knob, moveInfo, {
                Position = UDim2.new(0, 3, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = offColor
            }):Play()
            TweenService:Create(stroke, colorInfo, {Color = Theme.Current.Secondary, Transparency = 0.65}):Play()
            TweenService:Create(trackStroke, colorInfo, {Color = Theme.Current.TextSecondary, Transparency = 0.7}):Play()
            TweenService:Create(switchTrack, colorInfo, {BackgroundColor3 = Theme.Current.Secondary, BackgroundTransparency = 0.25}):Play()
            TweenService:Create(trackGradFill, colorInfo, {BackgroundTransparency = 1}):Play()
            TweenService:Create(label, colorInfo, {TextColor3 = Theme.Current.TextPrimary}):Play()
            TweenService:Create(container, colorInfo, {BackgroundTransparency = 0.75, BackgroundColor3 = Theme.Current.Secondary}):Play()
        end
    end

    -- FIX ONE-SHOT v4.2 (root cause du "toggle bloque apres 1 cycle") :
    --   L'ancien contrat interpretait le retour du callback comme "l'etat reel de la feature".
    --   Or ToggleSpamTp & co retournent true pour dire "commande reussie"... Y COMPRIS a la
    --   desactivation -> le code se disait "la feature est encore ON" et re-flippait le visuel
    --   sur ON. Resultat : desactive logiquement mais affiche ON, et chaque clic suivant
    --   re-confirmit OFF puis re-flippait ON : le toggle paraissait mort.
    --   NOUVEAU CONTRAT : false = refus explicite (on revient a l'etat d'avant le clic),
    --   true / nil = l'etat demande est accepte. Plantage => retour a l'etat precedent + warn.
    --   Garde-fou : le debounce se relache toujours au bout de 6s (jamais de blocage permanent).
    local switching = false
    local function applyState(newState, animated)
        if switching then return end
        local requested = newState and true or false
        local previous = state
        state = requested
        setVisualState(animated)
        if callback then
            switching = true
            task.delay(6, function() switching = false end)
            local ok, result = pcall(callback, state)
            switching = false
            if not ok then
                state = previous
                setVisualState(animated)
                warn("[Chimera Toggle] " .. tostring(text) .. " : " .. tostring(result))
                pcall(function()
                    Chimera:ShowNotification("notif_toggle_error", tostring(text), tostring(result):sub(1, 120))
                end)
            elseif result == false then
                -- Refus explicite : le visuel revient a l'etat d'avant le clic
                state = previous
                setVisualState(animated)
            end
        end
        container:SetAttribute("IsOn", state)
    end

    -- EFFET DE CLIC PHYSIQUE (Le bouton s'écrase un peu)
    container.MouseButton1Down:Connect(function()
        TweenService:Create(container, TweenInfo.new(0.1), {Size = UDim2.new(1, -4, 0, 43)}):Play()
    end)

    container.MouseButton1Up:Connect(function()
        TweenService:Create(container, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Size = UDim2.new(1, 0, 0, 45)}):Play()
    end)

    -- FIX BUG MAJEUR : "Activated" ne se déclenche que si le clic DÉMARRE sur le toggle.
    -- (Avant : MouseButton1Up togglait même si le clic venait d'ailleurs, ex: drag de la fenêtre,
    --  ce qui déclenchait des activations parasites à chaque déplacement du GUI)
    container.Activated:Connect(function()
        applyState(not state, true)
    end)

    -- HOVER
    container.MouseEnter:Connect(function()
        if not state then
            TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.3}):Play()
        end
    end)
    container.MouseLeave:Connect(function()
        if not state then
            TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.65}):Play()
        end
    end)

    -- Init
    setVisualState(false)
    
    local controller = {}
    function controller:SwitchState(newState)
        applyState(newState, true)
    end
    function controller:SetVisual(newState)
        -- Change uniquement l'affichage (sans rappeler le callback)
        if switching then return end -- callback en cours : le sync externe ne doit pas ecraser ce toggle
        state = newState and true or false
        setVisualState(true)
        container:SetAttribute("IsOn", state)
    end
    function controller:GetState()
        return state
    end

    if featureKey then
        Chimera._ToggleBindings[featureKey] = Chimera._ToggleBindings[featureKey] or {}
        table.insert(Chimera._ToggleBindings[featureKey], controller)
    end
    
    return container, controller
end
function Create.Slider(parent, text, layoutOrder, min, max, default, callback)
    local dragging = false
    local editing = false -- v4.8 : vrai pendant l'edition de la valeur (bloque le drag)
    
    -- Pas d'arrondi adapté à la plage (fix : les sliders fins comme 0.01 -> 1 gardent leur précision)
    local range = (max - min)
    local step = (range <= 0.1 and 0.001) or (range <= 1 and 0.01) or (range <= 20 and 0.1) or 1
    local decimals = (step >= 1 and 0) or (step == 0.1 and 1) or (step == 0.01 and 2) or 3
    
    local function formatValue(v)
        if decimals == 0 then return tostring(math.floor(v + 0.5)) end
        return string.format("%." .. decimals .. "f", v)
    end
    
    -- 1. Conteneur principal (Même style que tes Toggles)
    local container = Create.Element("TextButton", {
        Name = text .. "Slider",
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = Theme.Current.Secondary,
        BackgroundTransparency = 0.75,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = layoutOrder
    })
    Create.Element("UICorner", {CornerRadius = UDim.new(0, 10), Parent = container})
    
    local stroke = Create.Element("UIStroke", {
        Parent = container,
        Color = Theme.Current.Secondary,
        Thickness = 1.2,
        Transparency = 0.65,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    })

    -- 2. Textes (Nom à gauche, Valeur à droite)
    local label = Create.Element("TextLabel", {
        Parent = container,
        Size = UDim2.new(0.6, 0, 0, 25),
        Position = UDim2.new(0, 15, 0, 5),
        BackgroundTransparency = 1,
        Text = text,
        Font = Theme.Fonts.Header,
        TextColor3 = Theme.Current.TextSecondary,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    -- v4.8 : TextButton (et non TextLabel) -> la valeur est CLIQUABLE et devient
    -- une TextBox d'edition directe. Visuel strictement identique.
    local valueLabel = Create.Element("TextButton", {
        Parent = container,
        Name = "ValueLabel",
        Size = UDim2.new(0.3, 0, 0, 25),
        Position = UDim2.new(1, -15, 0, 5),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        Text = formatValue(default),
        AutoButtonColor = false,
        Font = Theme.Fonts.Code,
        TextColor3 = Theme.Current.Accent,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 6
    })
    valueLabel:SetAttribute("ThemeType", "Accent")
    local currentValue = default

    -- 3. Le Rail (fond sombre, coins pleins)
    local track = Create.Element("Frame", {
        Parent = container,
        Size = UDim2.new(1, -30, 0, 8),
        Position = UDim2.new(0.5, 0, 0.75, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Current.Background,
        BackgroundTransparency = 0.35
    })
    Create.Element("UICorner", {CornerRadius = UDim.new(1, 0), Parent = track})

    -- 4. La Barre de progression — DÉGRADÉ DE MARQUE (GradientA -> GradientB, comme les toggles).
    -- Fill blanc + UIGradient de marque 2 keypoints 0/1 : recoloré automatiquement
    -- par le sweep d'ApplyTheme à chaque changement de thème. (L'attribut
    -- ThemeType="Accent" est RETIRÉ : il écraserait le blanc par l'accent -> gradient faux.)
    local fill = Create.Element("Frame", {
        Parent = track,
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0
    })
    Create.Element("UICorner", {CornerRadius = UDim.new(1, 0), Parent = fill})
    Create.Element("UIGradient", {
        Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB),
        Parent = fill
    })
    -- Reflet liquid glass sur le remplissage (signature visuelle commune aux notifs)
    local fillSheen = Create.Element("Frame", {
        Parent = fill, Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.72, BorderSizePixel = 0
    })
    Create.Element("UICorner", {CornerRadius = UDim.new(1, 0), Parent = fillSheen})

    -- 5. L'indicateur (barre verticale néon)
    local cursor = Create.Element("Frame", {
        Parent = fill,
        Size = UDim2.new(0, 5, 1, 6),
        Position = UDim2.new(1, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 3
    })
    Create.Element("UICorner", {CornerRadius = UDim.new(1, 0), Parent = cursor})
    
    -- L'effet de halo (Glow) autour du curseur
    local cursorStroke = Create.Element("UIStroke", {
        Parent = cursor,
        Color = Theme.Current.Accent,
        Thickness = 2,
        Transparency = 0.4
    })
    cursorStroke:SetAttribute("ThemeType", "Accent")

    -- LOGIQUE
    local function update(input, instant)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local value = math.floor(((max - min) * pos + min) / step + 0.5) * step
        
        if instant then
            -- FIX BUG : pendant le drag on applique DIRECTEMENT la taille
            -- (avant : un tween de 0.1s par frame s'empilait et rendait le drag saccadé)
            fill.Size = UDim2.new(pos, 0, 1, 0)
        else
            TweenService:Create(fill, TweenInfo.new(0.15, Enum.EasingStyle.Quart), {
                Size = UDim2.new(pos, 0, 1, 0)
            }):Play()
        end
        
        currentValue = value
        valueLabel.Text = formatValue(value)
        if callback then callback(value) end
        return value
    end

    -- INTERACTIONS
    container.InputBegan:Connect(function(input)
        if editing then return end -- v4.8 : edition en cours, on ne drague pas
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            -- v4.8 : un clic sur la valeur (coin droit) ne doit PAS sauter au max
            if input.Position.X >= valueLabel.AbsolutePosition.X - 6
                and input.Position.X <= valueLabel.AbsolutePosition.X + valueLabel.AbsoluteSize.X + 6 then
                return
            end
            dragging = true
            TweenService:Create(stroke, TweenInfo.new(0.25), {Color = Theme.Current.Accent, Transparency = 0.1}):Play()
            TweenService:Create(container, TweenInfo.new(0.25), {BackgroundColor3 = Theme.Current.Accent, BackgroundTransparency = 0.7}):Play()
            TweenService:Create(cursor, TweenInfo.new(0.25), {Size = UDim2.new(0, 7, 1, 10)}):Play()
            update(input, true)
        end
    end)

    local endedConn
    endedConn = game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            -- Retour au calme
            TweenService:Create(stroke, TweenInfo.new(0.25), {Color = Theme.Current.Secondary, Transparency = 0.65}):Play()
            TweenService:Create(container, TweenInfo.new(0.25), {BackgroundColor3 = Theme.Current.Secondary, BackgroundTransparency = 0.75}):Play()
            TweenService:Create(cursor, TweenInfo.new(0.25), {Size = UDim2.new(0, 5, 1, 6)}):Play()
        end
    end)

    local changedConn
    changedConn = game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input, true)
        end
    end)

    -- FIX FUITE MÉMOIRE : on déconnecte les connexions globales quand le slider est détruit
    container.Destroying:Connect(function()
        if endedConn then endedConn:Disconnect() endedConn = nil end
        if changedConn then changedConn:Disconnect() changedConn = nil end
    end)

    -- Contrôleur externe (utilisé par la config pour resynchroniser les sliders)
    -- v4.9.4 : raw = true -> accepte N'IMPORTE QUELLE valeur (même au-delà de min/max).
    -- La barre reste clampée visuellement (0-100%), mais la valeur et le callback
    -- reçoivent le chiffre brut tapé. Utilisé par l'éditeur textbox de la valeur.
    local controller = {}
    function controller:SetValue(v, raw)
        v = tonumber(v)
        if v == nil then
            if raw then return end
            v = min
        end
        if not raw then
            v = math.clamp(v, min, max)
            v = math.floor(v / step + 0.5) * step
        end
        local pos = math.clamp((v - min) / (max - min), 0, 1)
        TweenService:Create(fill, TweenInfo.new(0.15, Enum.EasingStyle.Quart), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
        currentValue = v
        valueLabel.Text = formatValue(v)
        if callback then pcall(callback, v) end
    end

    -- v4.8 : EDITEUR DE VALEUR — cliquer sur le nombre ouvre une TextBox.
    -- v4.9.4 : la valeur tapée n'est PLUS clampée (n'importe quel chiffre accepté,
    --          la barre se bloque visuellement au max/min mais le réglage s'applique).
    --          Virgule acceptée comme séparateur décimal, CaptureFocus différé
    --          (anti race condition mobile), Entrée OU clic ailleurs = applique.
    valueLabel.Activated:Connect(function()
        if editing then return end
        editing = true
        valueLabel.TextTransparency = 1
        local box = Create.Element("TextBox", {
            Name = "ValueBox",
            Parent = container,
            Size = UDim2.new(0.3, 0, 0, 25),
            Position = UDim2.new(1, -15, 0, 5),
            AnchorPoint = Vector2.new(1, 0),
            BackgroundColor3 = Theme.Current.Background,
            BackgroundTransparency = 0.2,
            Text = formatValue(currentValue),
            PlaceholderText = "...",
            TextColor3 = Theme.Current.Accent,
            Font = Theme.Fonts.Code,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Right,
            ClearTextOnFocus = false,
            ZIndex = 7
        })
        box:SetAttribute("ThemeType", "Accent")
        Create.Element("UICorner", {CornerRadius = UDim.new(0, 6), Parent = box})
        Create.Element("UIStroke", {Parent = box, Color = Theme.Current.Accent, Thickness = 1, Transparency = 0.35})
        task.defer(function() if box.Parent then box:CaptureFocus() end end)
        box.FocusLost:Connect(function()
            local n = tonumber((box.Text:gsub(",", ".")))
            editing = false
            if box.Parent then box:Destroy() end
            valueLabel.TextTransparency = 0
            if n then
                controller:SetValue(n, true) -- v4.9.4 : valeur brute, sans clamp
            else
                valueLabel.Text = formatValue(currentValue)
            end
        end)
    end)

    return container, controller
end
