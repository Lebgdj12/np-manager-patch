-- Helper pour récupérer le RootPart
local function GetRoot(player)
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

-- Stop toutes les animations du LocalPlayer
local function StopAnim()
    local char = game:GetService("Players").LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local tracks = char.Humanoid:GetPlayingAnimationTracks()
        for _, track in pairs(tracks) do track:Stop() end
    end
end

-- Jouer une animation par ID
local function PlayAnim(id)
    local char = game:GetService("Players").LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. id
        local track = char.Humanoid:LoadAnimation(anim)
        track:Play()
        return track
    end
end

-- Vélocité pour le trolling (Anti-Tomber)
local Velocity_Asset = Instance.new("BodyAngularVelocity")
Velocity_Asset.AngularVelocity = Vector3.new(0,0,0)
Velocity_Asset.MaxTorque = Vector3.new(50000,50000,50000)
Velocity_Asset.P = 1250
Velocity_Asset.Name = "BreakVelocity"

function Chimera:BuildPlayerPage(page)
    -- Initialisation
    if self.State.TeamCheck == nil then self.State.TeamCheck = false end
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local TweenService = game:GetService("TweenService")
    local MarketplaceService = game:GetService("MarketplaceService")
    local UserInputService = game:GetService("UserInputService")
    
    -- Variables Locales
    local loopConnection = nil
    local currentTrollAction = nil
    local lastTarget = nil
    local bringLoop = nil
    local activeAnimTrack = nil -- Pour gérer le switch d'animation
    
    -- === FONCTIONS UTILITAIRES ===
    local function GetRoot(player) return player.Character and player.Character:FindFirstChild("HumanoidRootPart") end
    local function GetHealth(player) if player.Character and player.Character:FindFirstChild("Humanoid") then return math.floor(player.Character.Humanoid.Health) end return 0 end
    local function GetDistance(player)
        local lp = Players.LocalPlayer
        if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            return math.floor((lp.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude)
        end return -1
    end

    local function StopAnim()
        local char = Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then 
            for _, t in pairs(char.Humanoid:GetPlayingAnimationTracks()) do t:Stop() end 
        end
        activeAnimTrack = nil
    end

    local function PlayAnim(id)
        local char = Players.LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local a = Instance.new("Animation"); a.AnimationId = "rbxassetid://"..id; 
            local t = char.Humanoid:LoadAnimation(a); t:Play(); 
            activeAnimTrack = t -- On stocke la track pour pouvoir la stopper/relancer
            return t
        end
    end

    local Velocity_Asset = Instance.new("BodyAngularVelocity"); Velocity_Asset.Name = "BreakVelocity"; Velocity_Asset.MaxTorque = Vector3.new(50000,50000,50000); Velocity_Asset.P = 1250

    local function StopTrollAction()
        if Chimera.SyncToggleUI then pcall(Chimera.SyncToggleUI, Chimera, "Trolls", false) end -- resync des toggles troll
        if loopConnection then loopConnection:Disconnect(); loopConnection = nil end
        StopAnim()
        local lp = Players.LocalPlayer
        if lp.Character then
            if lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character.HumanoidRootPart:FindFirstChild("BreakVelocity") then pcall(function() lp.Character.HumanoidRootPart.BreakVelocity:Destroy() end) end
            if lp.Character:FindFirstChild("Humanoid") then lp.Character.Humanoid.Sit = false; lp.Character.Humanoid.PlatformStand = false end
        end
        currentTrollAction = nil
    end

    -- SYSTÈME DE TROLL DYNAMIQUE (Supporte le changement de cible)
    local function StartTrollAction(actionName, animId, loopCallback)
        if currentTrollAction == actionName then StopTrollAction(); return false end
        
        -- Vérification initiale
        if not self.State.target or not self.State.target.Character then self:ShowNotification("notif_target_not_selected"); StopTrollAction(); return false end
        
        StopTrollAction()
        currentTrollAction = actionName
        
        -- Setup physique
        local root = GetRoot(Players.LocalPlayer)
        if root and not root:FindFirstChild("BreakVelocity") then Velocity_Asset:Clone().Parent = root end
        
        -- Lancement Animation initiale
        if animId then PlayAnim(animId) end
        
        -- Boucle
        local trackedTarget = self.State.target -- Pour détecter le changement
        
        loopConnection = RunService.Heartbeat:Connect(function()
            -- 1. Si la cible change en cours de route (Switch Target)
            if self.State.target ~= trackedTarget then
                trackedTarget = self.State.target -- On met à jour la cible traquée
                -- On relance l'animation pour être sûr (parfois ça bug au switch)
                if animId then StopAnim(); PlayAnim(animId) end
            end

            -- 2. Vérifications de validité
            if not self.State.target or not self.State.target.Parent then StopTrollAction(); return end
            
            local lp = Players.LocalPlayer
            if self.State.target.Character and lp.Character then
                local tr = GetRoot(self.State.target); local mr = GetRoot(lp)
                
                -- Callback de positionnement (Bang, Stand, etc.)
                if tr and mr then 
                    loopCallback(lp, self.State.target, mr, tr)
                    mr.Velocity = Vector3.zero; mr.RotVelocity = Vector3.zero 
                end
            else 
                -- Si le perso n'est pas chargé, on attend sans couper (pour le respawn)
                -- StopTrollAction() 
            end
        end)
        return true
    end

