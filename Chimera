-- OUTILS DE DÉCODAGE (MORSE & BASE64)
-- =============================================================================
local B64_MARKER = "▫" -- Le marqueur qu'on a défini pour l'envoi

local MorseReverse = {
    [".-"]="a", ["-..."]="b", ["-.-."]="c", ["-.."]="d", ["."]="e", ["..-."]="f", ["--."]="g", ["...."]="h", [".."]="i", [".---"]="j", ["-.-"]="k", [".-.."]="l", ["--"]="m", ["-."]="n", ["---"]="o", [".--."]="p", ["--.-"]="q", [".-."]="r", ["..."]="s", ["-"]="t", ["..-"]="u", ["...-"]="v", [".--"]="w", ["-..-"]="x", ["-.--"]="y", ["--.."]="z",
    [".----"]="1", ["..---"]="2", ["...--"]="3", ["....-"]="4", ["....."]="5", ["-...."]="6", ["--..."]="7", ["---.."]="8", ["----."]="9", ["-----"]="0", ["/"]=" "
}

local function SmartDecodeText(text)
    -- 1. DÉTECTION BASE64 (Via le marqueur)
    if text:find(B64_MARKER) then
        local clean = text:gsub(B64_MARKER, ""):gsub("[^%w%+/=]", "") -- Nettoyage
        local worked, res = pcall(function()
            local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
            return (clean:gsub('.', function(x) 
                if (x == '=') then return '' end
                local r,f='',(b:find(x)-1)
                for i=6,1,-1 do r=r..(f%2^i-f%2^(i-1)>0 and '1' or '0') end
                return r;
            end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
                if (#x ~= 8) then return '' end
                local c=0
                for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end
                return string.char(c)
            end))
        end)
        if worked and res and #res > 0 then return res, "[B64]" end
    end

    -- 2. DÉTECTION MORSE
    -- Si le texte contient uniquement des ., -, / ou espaces et fait plus de 4 caractères
    if text:match("^[%.%-%s/]+$") and #text > 4 then
        local res = ""
        for word in text:gmatch("[^%s]+") do
            res = res .. (MorseReverse[word] or "?")
        end
        return res, "[MORSE]"
    end

    return nil, nil
end

