-- POSITION DES NOTIFICATIONS (4 coins, réglable dans Paramètres) :
-- anchor/X/Y décrivent le slot de la carte la plus récente ; sideOff = point
-- d'entrée/sortie hors écran (côté du coin). Bas-droite = comportement
-- historique conservé par défaut. Coins hauts : yOff 70 (sous la topbar Roblox).
Chimera.NotifCorners = {
    top_right     = { anchor = Vector2.new(1, 0), xScale = 1, xOff = -16, yScale = 0, yOff = 70,  sideOff = 300 },
    top_left      = { anchor = Vector2.new(0, 0), xScale = 0, xOff = 16,  yScale = 0, yOff = 70,  sideOff = -300 },
    bottom_right  = { anchor = Vector2.new(1, 1), xScale = 1, xOff = -16, yScale = 1, yOff = -28, sideOff = 300 },
    bottom_left   = { anchor = Vector2.new(0, 1), xScale = 0, xOff = 16,  yScale = 1, yOff = -28, sideOff = -300 },
}
Chimera.NotifCornerOrder = { "top_right", "top_left", "bottom_right", "bottom_left" }

-- Empileur partagé : ré-aligne toutes les notifications vivantes dans le coin actif.
-- Sens adaptatif : coins BAS = pile vers le HAUT (historique), coins HAUTS = pile
-- vers le BAS. Idempotent et auto-correctif : appelé à l'entrée, à la sortie,
-- quand une carte change de taille ET au changement de coin.
local function restackNotifications()
    local corner = Chimera.NotifCorners[Chimera.State.NotifCorner] or Chimera.NotifCorners.bottom_right
    local goingDown = corner.anchor.Y == 0
    local targetY = corner.yOff
    for i = #Chimera.ActiveNotifications, 1, -1 do
        local frame = Chimera.ActiveNotifications[i]
        if frame and frame.Parent then
            TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(corner.xScale, corner.xOff, corner.yScale, targetY)
            }):Play()
            local stepH = frame.AbsoluteSize.Y + 10
            targetY = targetY + (goingDown and stepH or -stepH)
        end
    end
end
Chimera.RestackNotifications = restackNotifications

-- Info de sortie partagée (slide + fondu complet)
local NOTIF_OUT_INFO = TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

-- Fondu de sortie générique : glisse vers la droite ET rend transparent CHAQUE élément
-- (rendu identique garanti sur tous les appareils, aucun rendu texture GPU)
local function fadeOutCard(card, info)
    if not card or not card.Parent then return end
    for _, d in ipairs(card:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextBox") or d:IsA("TextButton") then
            TweenService:Create(d, info, { TextTransparency = 1 }):Play()
        elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
            TweenService:Create(d, info, { ImageTransparency = 1 }):Play()
        elseif d:IsA("UIStroke") then
            TweenService:Create(d, info, { Transparency = 1 }):Play()
        elseif d:IsA("GuiObject") then
            TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
        end
    end
    local outCorner = Chimera.NotifCorners[Chimera.State.NotifCorner] or Chimera.NotifCorners.bottom_right
    local out = TweenService:Create(card, info, {
        Position = UDim2.new(outCorner.xScale, outCorner.sideOff, card.Position.Y.Scale, card.Position.Y.Offset),
        BackgroundTransparency = 1
    })
    out:Play()
    out.Completed:Connect(function()
        if card and card.Parent then card:Destroy() end
    end)
end

function Chimera:ShowNotification(messageKey, ...)
    if not self.ScreenGui then return end

    -- 1. PARAMETRES (API inchangee : ShowNotification(cle, [duree, texteBouton, callback] | [args format]))
    local args = {...}
    local msgText = T(messageKey) or messageKey
    local duration = 5
    local buttonText, callback

    if type(args[1]) == "number" then
        duration, buttonText, callback = args[1], args[2], args[3]
    elseif #args > 0 then
        local success, formatted = pcall(string.format, msgText, unpack(args))
        if success then msgText = formatted end
    end
    duration = tonumber(duration) or 5

    -- 2. IDENTITE VISUELLE UNIQUE : dégradé de marque de l'app (GradientA -> GradientB)
    --    appliqué PARTOUT (point lumineux, barre de vie) — aucune couleur variable
    --    selon le type de notification, comme demandé.

    -- 3. LIMITE DE 3 : la plus ancienne sort en fondu complet
    while #Chimera.ActiveNotifications >= 3 do
        local oldest = table.remove(Chimera.ActiveNotifications, 1)
        fadeOutCard(oldest, NOTIF_OUT_INFO)
        restackNotifications()
    end

    -- 4. OVERLAY DEDIE (au-dessus de tout, inchangé)
    local notifOverlay = PlayerGui:FindFirstChild("ChimeraNotifGui")
    if not notifOverlay then
        notifOverlay = Create.Element("ScreenGui", {
            Name = "ChimeraNotifGui", Parent = PlayerGui, ResetOnSpawn = false, DisplayOrder = 9999, IgnoreGuiInset = true,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        })
    end
    -- FIX TEXTE INVISIBLE : en mode Global (défaut d'Instance.new), une carte à ZIndex élevé
    -- passe au-dessus de SES PROPRES enfants. Sibling garantit enfants > parents, toujours.
    notifOverlay.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    -- 5. CARTE = LE VERRE DE L'APP (Create.GlassPanel premium), taille compacte
    -- Coin lu à la création ; entrée/restack/sortie relisent le LEUR au moment T
    -- -> aucun tween ne peut cibler un coin périmé.
    local spawnCorner = Chimera.NotifCorners[Chimera.State.NotifCorner] or Chimera.NotifCorners.bottom_right
    -- ADAPTATIF MULTI-APPAREILS : le COIN est ancré en pourcentage d'écran (scale) -> la
    -- position s'adapte déjà toute seule à chaque appareil ; seule la LARGEUR est en pixels,
    -- on la borne donc sur les très petits écrans pour que la carte ne déborde JAMAIS
    -- (écrans normaux : 260px strictement inchangés).
    local notifCam = workspace.CurrentCamera
    local notifVpX = (notifCam and notifCam.ViewportSize.X) or 1280
    local notifWidth = math.clamp(math.floor(notifVpX * 0.68), 170, 260)
    local notif = Create.GlassPanel(notifOverlay, {
        Name = "ToastNotif",
        Size = UDim2.new(0, notifWidth, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(spawnCorner.xScale, spawnCorner.sideOff, spawnCorner.yScale, spawnCorner.yOff),
        AnchorPoint = spawnCorner.anchor,
        BackgroundTransparency = 0.14, -- un poil plus dense que les panneaux : flotte sur le JEU, pas sur le flou
        ZIndex = 1, -- ZIndex CROISSANTS : carte (1) < contenu (2+) — compatible Sibling ET Global
    })

    -- FIX REFLET : l'ombre douce du GlassPanel débordait de la carte (image étendue -18/+36) ;
    -- supprimée pour un toast net, sans halo noir qui dépasse
    local notifShadow = notif:FindFirstChild("Shadow")
    if notifShadow then notifShadow:Destroy() end

    -- Micro-effet "pop" élastique à l'apparition (preset Spring de l'app)
    local popScale = Create.Element("UIScale", { Scale = 0.92, Parent = notif })

    -- 6. CORPS (UIListLayout + AutomaticSize : hauteur toujours juste, texte jamais coupé)
    local body = Create.Element("Frame", {
        Name = "Body",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = notif,
    })
    Create.Element("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = body,
    })
    Create.Element("UIPadding", {
        PaddingTop = UDim.new(0, 11), PaddingBottom = UDim.new(0, 2),
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
        Parent = body,
    })

    -- 6a. Rangée principale : point lumineux EN DÉGRADÉ DE MARQUE + message blanc net
    local topRow = Create.Element("Frame", {
        Name = "TopRow", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 3, Parent = body,
    })
    Create.Element("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10),
        VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = topRow,
    })

    local statusHalo = Create.Element("Frame", {
        Name = "StatusHalo", Size = UDim2.new(0, 15, 0, 15),
        BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.78,
        BorderSizePixel = 0, LayoutOrder = 1, ZIndex = 4, Parent = topRow,
    })
    Create.Element("UICorner", { CornerRadius = UDim.new(1, 0), Parent = statusHalo })
    Create.Element("UIGradient", {
        Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB),
        Rotation = 90, Parent = statusHalo
    })
    local statusDot = Create.Element("Frame", {
        Name = "StatusDot", Size = UDim2.new(0, 7, 0, 7),
        Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 5, Parent = statusHalo,
    })
    Create.Element("UICorner", { CornerRadius = UDim.new(1, 0), Parent = statusDot })
    Create.Element("UIGradient", {
        Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB),
        Rotation = 90, Parent = statusDot
    })

    local label = Create.Element("TextLabel", {
        Name = "Message",
        Size = UDim2.new(1, -49, 0, 0),      -- 49 = halo (15) + gap (10) + zone sécurité croix (24)
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = msgText,
        TextColor3 = Theme.Current.TextPrimary,
        TextSize = 14,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        LayoutOrder = 2,
        ZIndex = 4,
        Parent = topRow,
    })

    -- 6b. Bouton d'action (optionnel, API inchangée)
    local dismiss -- forward declaration : le bouton et le ✕ ferment la carte
    if buttonText and callback then
        local actionRow = Create.Element("Frame", {
            Name = "ActionRow", Size = UDim2.new(1, 0, 0, 40),
            BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 3, Parent = body,
        })
        local btnPart = Create.Button(actionRow, buttonText, 1, function()
            pcall(callback)
            if dismiss then dismiss() end
        end, UDim2.new(1, 0, 0, 28))
        btnPart.Position = UDim2.new(0, 0, 0, 7)
    end

    -- 6c. Barre de vie : capsule inset, remplissage EN DÉGRADÉ DE MARQUE (GradientA -> GradientB)
    local progRow = Create.Element("Frame", {
        Name = "ProgressRow", Size = UDim2.new(1, 0, 0, 12),
        BackgroundTransparency = 1, LayoutOrder = 3, ZIndex = 3, Parent = body,
    })
    local progTrack = Create.Element("Frame", {
        Name = "Track", Size = UDim2.new(1, -28, 0, 3), Position = UDim2.new(0.5, 0, 1, -5),
        AnchorPoint = Vector2.new(0.5, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.88, BorderSizePixel = 0, ZIndex = 4, Parent = progRow,
    })
    Create.Element("UICorner", { CornerRadius = UDim.new(1, 0), Parent = progTrack })
    local progBar = Create.Element("Frame", {
        Name = "Fill", Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0, ZIndex = 5, Parent = progTrack,
    })
    Create.Element("UICorner", { CornerRadius = UDim.new(1, 0), Parent = progBar })
    Create.Element("UIGradient", {
        Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB),
        Rotation = 0, Parent = progBar
    })

    -- 7. BOUTON FERMER : croix typographique (×) en TextSecondary, s'éclaire au survol, aucun emoji
    local closeBtn = Create.Element("TextButton", {
        Name = "Close", Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -6, 0, 6),
        AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1,
        Text = "\u{00D7}", TextColor3 = Theme.Current.TextSecondary,
        TextTransparency = 0, TextSize = 18, Font = Enum.Font.GothamBold,
        AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 6, Parent = notif,
        -- (6 > carte 1 : le ✕ reste cliquable et visible même en Global)
    })
    closeBtn.MouseEnter:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.12), { TextColor3 = Theme.Current.TextPrimary }):Play()
    end)
    closeBtn.MouseLeave:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.12), { TextColor3 = Theme.Current.TextSecondary }):Play()
    end)

    -- 8. FONDU D'ENTREE : snapshot de chaque transparence finale, tout a 1, puis retour
    -- (équivalent CanvasGroup mais avec les primitives de base : zéro artefact GPU)
    local fadeItems = {}
    local function collectFade(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then
            table.insert(fadeItems, { obj, "TextTransparency", obj.TextTransparency })
        end
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            table.insert(fadeItems, { obj, "ImageTransparency", obj.ImageTransparency })
        end
        if obj:IsA("UIStroke") then
            table.insert(fadeItems, { obj, "Transparency", obj.Transparency })
        elseif obj:IsA("GuiObject") then
            table.insert(fadeItems, { obj, "BackgroundTransparency", obj.BackgroundTransparency })
        end
    end
    collectFade(notif)
    for _, d in ipairs(notif:GetDescendants()) do collectFade(d) end
    for _, it in ipairs(fadeItems) do it[1][it[2]] = 1 end

    local entryTweens = {}
    local function fadeIn()
        local info = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        for _, it in ipairs(fadeItems) do
            local tw = TweenService:Create(it[1], info, { [it[2]] = it[3] })
            tw:Play()
            table.insert(entryTweens, tw)
        end
    end

    -- 9. CYCLE DE VIE idempotent (impossible de fermer deux fois, course timer/bouton impossible)
    local dismissed = false
    dismiss = function()
        if dismissed then return end
        dismissed = true
        for _, tw in ipairs(entryTweens) do tw:Cancel() end
        for i, v in ipairs(Chimera.ActiveNotifications) do
            if v == notif then table.remove(Chimera.ActiveNotifications, i) break end
        end
        restackNotifications() -- ré-empile les restantes pendant que celle-ci sort
        fadeOutCard(notif, NOTIF_OUT_INFO)
    end
    closeBtn.Activated:Connect(function() dismiss() end)

    -- Entrée : glissée depuis la droite + pop élastique (Spring) + fondu de tous les éléments
    task.defer(function()
        table.insert(Chimera.ActiveNotifications, notif)
        restackNotifications()
        local entryCorner = Chimera.NotifCorners[Chimera.State.NotifCorner] or Chimera.NotifCorners.bottom_right
        TweenService:Create(notif, TweenInfo.new(0.38, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(entryCorner.xScale, entryCorner.xOff, entryCorner.yScale, entryCorner.yOff)
        }):Play()
        local popTw = TweenService:Create(popScale, Theme.Animations.Presets.Spring, { Scale = 1 })
        popTw:Play()
        table.insert(entryTweens, popTw)
        fadeIn()
        -- Barre de vie (FIX conservé : duration jamais 0 -> TweenInfo valide)
        TweenService:Create(progBar, TweenInfo.new(math.max(duration, 0.1), Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 1, 0)
        }):Play()
    end)

    -- Timer de destruction
    task.delay(math.max(duration, 0.1), dismiss)

    -- Auto-correcteur : si la taille d'une carte change (layout tardif, reset graphique,
    -- changement de résolution), la pile se ré-aligne toute seule. Aucun chevauchement possible.
    notif:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if notif and notif.Parent then
            task.defer(restackNotifications)
        end
    end)
end

-- Change le coin des notifications : re-base chaque carte vivante dans le nouvel
-- anchor SANS saut visuel (la position absolue du top-left est préservée via
-- AbsolutePosition, et AnchorPoint + Position sont réécrits dans la MÊME frame
-- Lua -> aucun rendu intermédiaire), puis la pile se re-tween vers le nouveau
-- coin. Les entrées/sorties suivantes utilisent d'elles-mêmes le nouveau coin.
function Chimera:SetNotifCorner(key)
    local corner = self.NotifCorners[key]
    if not corner then return end
    self.State.NotifCorner = key
    for i = #self.ActiveNotifications, 1, -1 do
        local frame = self.ActiveNotifications[i]
        if frame and frame.Parent then
            local ap = frame.AbsolutePosition
            local sz = frame.AbsoluteSize
            frame.AnchorPoint = corner.anchor
            frame.Position = UDim2.new(0, ap.X + corner.anchor.X * sz.X, 0, ap.Y + corner.anchor.Y * sz.Y)
        end
    end
    self.RestackNotifications()
end

-- Cycle : haut droite -> haut gauche -> bas droite -> bas gauche -> ...
function Chimera:NextNotifCorner()
    local order = self.NotifCornerOrder
    local cur = self.State.NotifCorner or "bottom_right"
    local idx = 1
    for i, k in ipairs(order) do if k == cur then idx = i break end end
    local nextKey = order[(idx % #order) + 1]
    self:SetNotifCorner(nextKey)
    return nextKey
end
