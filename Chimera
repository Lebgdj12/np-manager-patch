        local trackGradFill = Create.Element("Frame", {Name = "GradFill", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = defaultState and 0 or 1, BorderSizePixel = 0, ZIndex = 1, Parent = switchTrack}); Create.Element("UICorner", {Parent = trackGradFill, CornerRadius = UDim.new(1, 0)}); Create.Element("UIGradient", {Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB), Rotation = 90, Parent = trackGradFill})
        
        -- Knob
