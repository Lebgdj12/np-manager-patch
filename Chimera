        end
        handle.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; dragDist = 0; dragStart = i.Position; startPos = frame.Position; if frame:GetAttribute("ThemeType") == "PrimaryGlass" then frame.BackgroundTransparency = 0.3 end end end)
