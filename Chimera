    -- Décodeur HTML minimal (titres propres)
    local function decodeHtmlEntities(s)
        s = tostring(s)
        s = s:gsub("&amp;", "&"):gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&quot;", '"'):gsub("&#39;", "'"):gsub("&#x27;", "'"):gsub("&nbsp;", " ")
        -- v4.9.6 : entités numériques (ZapMeta met &#039; dans les titres)
        s = s:gsub("&#(%d+);", function(n)
