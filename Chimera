            local targetUrl = (okR and type(rawUrl) == "string") and rawUrl or url
            local isHtml = false
            local okD, code = pcall(function() return game:HttpGet(targetUrl, true) end)
            if okD and type(code) == "string" and #code >= 10 then
                if code:find("<!DOCTYPE") or code:find("<!doctype") or code:find("<html") then
