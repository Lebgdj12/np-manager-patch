        -- rien ne tournait. Desormais : compilation, puis VRAIE execution (spawn + pcall),
        -- avec l'erreur de syntaxe OU de runtime notifiee.
        local function runLua(src)
            local func, syntaxErr = loadstring(src)
            if not func then
                self:ShowNotification("notif_search_execution_error", tostring(syntaxErr):sub(1, 150))
                return
            end
            -- v4.9.3 : avertissement obfuscation — les VM custom (bobloscript, moonsec,
            -- luraph, etc.) echouent souvent sur les executeurs gratuits/mobiles, donc le
            -- script se telecharge bien mais "ne s'execute pas". On previent l'utilisateur.
            local head = src:sub(1, 3000):lower()
            if head:find("obfuscat", 1, true) or head:find("bobloscript", 1, true) or head:find("moonsec", 1, true) or head:find("luraph", 1, true) or head:find("made with love, https://", 1, true) then
                self:ShowNotification("notif_search_obfuscated")
            end
            self:ShowNotification("notif_search_script_executed")
            task.spawn(function()
                local okR, runErr = pcall(func)
                if not okR then
                    warn("[Chimera] runtime script externe : " .. tostring(runErr))
                    self:ShowNotification("notif_search_execution_error", tostring(runErr):sub(1, 150))
                end
            end)
        end

        local function executeScript()
            if data.Key then self:ShowNotification("notif_search_key_required"); return end
            task.spawn(function()
                local src = data.Script
                -- FIX v4.4 : ScriptBlox met parfois une URL dans le champ "script" au lieu
                -- du code -> on la telecharge au lieu de loadstring("https://...") qui plantait
                if looksLikeUrl(src) then
                    self:ShowNotification("notif_search_script_downloading")
