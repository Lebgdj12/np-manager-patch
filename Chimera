                    if not code then
                        if isHtml then self:ShowNotification("notif_search_not_script") else self:ShowNotification("notif_search_request_failed") end
                        return
                    end
                    src = code
                elseif not src or src == "" then
                    -- Résultat web : le code est derrière une page -> conversion en URL brute
                    if not data.RawUrl then
                        -- v4.9.4 : page web classique (pas un fichier de script) -> on copie
