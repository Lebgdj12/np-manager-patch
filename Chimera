-- ONDE DE CLIC (v4.9.14 "Aurora") : cercle material-design qui naît sous le curseur/doigt
-- et se dissout. Blanc pur = invariant de thème (aucun remappage ApplyTheme nécessaire).
function Create.Ripple(button, inputPos)
    local ext = button.AbsoluteSize
    if ext.X <= 0 or ext.Y <= 0 then return end
    local lp = Vector2.new(inputPos.X, inputPos.Y) - button.AbsolutePosition
    lp = Vector2.new(math.clamp(lp.X, 0, ext.X), math.clamp(lp.Y, 0, ext.Y))
    local ripple = Create.Element("Frame", {
        Name = "Ripple",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, lp.X, 0, lp.Y),
        Size = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.72,
        BorderSizePixel = 0,
        ZIndex = 6,
        Parent = button
    })
    Create.Element("UICorner", { CornerRadius = UDim.new(1, 0), Parent = ripple })
    local target = math.max(ext.X, ext.Y) * 2.3
    TweenService:Create(ripple, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(0, target, 0, target), BackgroundTransparency = 1 }):Play()
    task.delay(0.5, function() if ripple and ripple.Parent then ripple:Destroy() end end)
end
function Create.Button(parent, text, layoutOrder, callback, size)
    size = size or UDim2.new(1, 0, 0, 42)
    
    -- 1. LE BOUTON (Élément racine, donc le MouseButton1Click fonctionnera)
    local button = Create.Element("TextButton", {
        Name = text .. "Button",
        Size = size,
        BackgroundColor3 = Theme.Current.Secondary,
