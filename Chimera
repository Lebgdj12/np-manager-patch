-- ═══════════════ MODE "TOITS ENLEVES" (voir l'interieur) ═══════════════
-- Cache (ou restaure) toutes les parts de la carte dont la base est plus
-- haut que ton perso + XRAY_CLEARANCE studs : toits et etages disparaissent,
-- l'interieur des batiments apparait. Le filtre suit ton altitude.

local XRAY_ATTR = "MinimapOrigT"

-- altitude de coupe actuelle : tout ce qui est plus haut que ton perso
-- (+ XRAY_CLEARANCE) doit etre cache en mode toits
local function currentCutY()
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if rootPart then
                return rootPart.Position.Y + CONFIG.XRAY_CLEARANCE
        end
        return nil
end

-- SWITCH TOITS ULTRA OPTIMISE (v2.3) : au lieu de re-scanner toutes les
-- parts toutes les 0.12s, les clones sont ranges dans une liste triee par
-- altitude. Les toits caches forment un SUFFIXE de cette liste : le
-- balayage ne touche que le delta entre l'ancienne et la nouvelle coupe
-- (recherche dichotomique). Toggle = O(nb de toits changes), repos = 0.
local function xrayLowerBound(value)
        local lo, hi = 1, #xraySorted + 1
        while lo < hi do
                local mid = math.floor((lo + hi) * 0.5)
                if xraySorted[mid].bottom <= value then
                        lo = mid + 1
                else
                        hi = mid
                end
        end
        return lo
end

local function xrayInsert(entry)
        local pos = xrayLowerBound(entry.bottom)
        table.insert(xraySorted, pos, entry)
        local aboveCut = xrayEnabled and xrayLastCut and entry.bottom > xrayLastCut
        if pos < xrayLastIdx then
                -- insere avant le suffixe cache : le suffixe se decale
                xrayLastIdx = xrayLastIdx + 1
                if xrayLastTarget then
                        xrayLastTarget = xrayLastTarget + 1
                end
        end
        if aboveCut then
                -- ne au-dessus de la coupe → cache direct, PEU IMPORTE sa place
                -- dans l'index (fix v2.4 : aucune fuite pendant une restauration
                -- en cours ; la regle "au-dessus de la coupe = cache" est absolue)
                entry.part.Transparency = 1
        end
end

local function xrayRemove(part)
        local n = #xraySorted
        if n == 0 then return end
        local bottom = part.Position.Y - part.Size.Y * 0.5
        -- FIX v2.4 : xrayLowerBound renvoie le 1er index STRICTEMENT superieur
        -- a "bottom". L'ancien code scannait vers l'AVANT a partir de la → il
        -- tombait tout de suite sur une altitude plus grande et ne supprimait
        -- JAMAIS rien. Les clones morts s'accumulaient dans l'index et
        -- corrompaient le mode toits au fil du temps ("des toits ne reviennent
        -- pas"). Les entrees de meme altitude sont juste AVANT : on remonte.
        local pos = xrayLowerBound(bottom) - 1
        while pos >= 1 and xraySorted[pos].bottom == bottom do
                if xraySorted[pos].part == part then
                        table.remove(xraySorted, pos)
                        if pos < xrayLastIdx then
                                xrayLastIdx = xrayLastIdx - 1
                        end
                        if xrayLastTarget and pos < xrayLastTarget then
                                xrayLastTarget = xrayLastTarget - 1
                        end
                        return
                end
                pos = pos - 1
        end
end

local function setXray(enabled)
        if xrayEnabled == enabled then return end
        xrayEnabled = enabled
        xrayDirty = true
        xrayLastTarget = nil
        if roofBtn then
                roofBtn.BackgroundColor3 = enabled and Color3.fromRGB(64, 158, 96) or Color3.fromRGB(18, 21, 30)
        end
        -- v2.5 : miroir d'état pour la GUI Chimera (SetAttribute avec la
        -- même valeur ne déclenche pas d'event -> pas de boucle)
        screenGui:SetAttribute("ChimeraRoofs", enabled)
end

local function toggleXray()
        setXray(not xrayEnabled)
end

-- balayage budgete : ne modifie QUE le delta reel, par paquets
local function sweepXray()
        if isBuilding then return end
        local n = #xraySorted
        if xrayEnabled then
                local cut = currentCutY()
                if not cut then return end
                local cutChanged = not xrayLastCut or math.abs(cut - xrayLastCut) > 0.35
                if not cutChanged and not xrayDirty and xrayLastIdx == xrayLastTarget then
                        return -- rien n'a bouge : zero calcul
                end
                xrayLastCut = cut
                xrayLastTarget = xrayLowerBound(cut)
        elseif xrayLastIdx <= n then
                xrayLastCut = nil
                xrayLastTarget = n + 1 -- tout restaurer
        else
                return -- desactive et rien de cache : zero calcul
        end
        xrayDirty = false

        local budget = CONFIG.XRAY_SWEEP_BUDGET
        -- FIX v2.4 (LE vrai bug des toits) : xrayLastIdx = PREMIER index cache,
        -- donc les toits caches forment le SUFFIXE [xrayLastIdx..n]. Si la
        -- cible descend sous xrayLastIdx, le suffixe GRANDIT → il faut CACHER.
        -- Si la cible monte au-dessus, le suffixe RETRECIT → il faut RESTAURER.
        -- L'ancien code faisait exactement l'inverse : le 1er appui sur TOITS
        -- ne cachait rien (juste la compta), le 2e cachait, et les mouvements
        -- d'altitude restaient/cachaient n'importe quoi → "des fois ils les
        -- replacent pas".
        if xrayLastTarget > xrayLastIdx then
                -- le suffixe cache retrecit : on RESTAURE [xrayLastIdx, target-1]
                local stop = math.min(xrayLastTarget - 1, xrayLastIdx + budget - 1)
                for i = xrayLastIdx, stop do
                        local e = xraySorted[i]
                        if xrayLastCut and e.bottom > xrayLastCut then
                                -- toujours au-dessus de la coupe → reste cache
                                -- (protege les objets apparus pendant une
                                -- restauration en cours)
                                e.part.Transparency = 1
                        else
                                e.part.Transparency = e.part:GetAttribute(XRAY_ATTR) or 0
                        end
                end
                xrayLastIdx = stop + 1
        elseif xrayLastTarget < xrayLastIdx then
                -- le suffixe cache grandit : on CACHE [target, xrayLastIdx-1]
                local start = math.max(xrayLastTarget, xrayLastIdx - budget)
                for i = start, xrayLastIdx - 1 do
                        xraySorted[i].part.Transparency = 1
                end
                xrayLastIdx = start
        end
end

if roofBtn then
