function Chimera:ApplyTheme(themeName, isLoading)
    local newThemeScheme = Theme.Schemes[themeName]
    if not newThemeScheme then return end
    
    Chimera.State.CurrentThemeName = themeName 
    local oldColors = Theme.Current -- FIX THEME GLOBAL : capture l'ancienne palette
    local newColors = newThemeScheme.Colors
    Theme.Current = newColors
    
    -- FIX "IL FAUT APPUYER 2 FOIS SUR LE THÈME" (3/3) : la notif et la sauvegarde
    -- auto sont DÉPLACÉES en fin d'ApplyTheme (après les sweeps, sous pcall) ->
    -- elles ne peuvent plus avorter le re-thémage ni être re-balayées par erreur.
    local allUIs = {self.ScreenGui}
    if self.UI.VFlyScreenGui then table.insert(allUIs, self.UI.VFlyScreenGui) end
    -- FIX TEXTURES : l'AimbotGUI etait absent du re-themage (restait a l'ancienne couleur)
    if self.UI.AimbotScreenGui then table.insert(allUIs, self.UI.AimbotScreenGui) end
    -- FIX COUVERTURE : notifs, launcher, crosshair et tout ScreenGui "Chimera*"
    -- etaient HORS re-themage -> leurs couleurs restaient figees sur l'ancien theme
    for _, child in ipairs(PlayerGui:GetChildren()) do
        if child:IsA("ScreenGui") and not table.find(allUIs, child) and string.sub(child.Name, 1, 7) == "Chimera" then
            table.insert(allUIs, child)
        end
    end

    -- =========================================================================
    -- PASS 1 : SWEEP GÉNÉRIQUE — désormais AVANT les branches taggées.
    -- FIX "IL FAUT APPUYER 2 FOIS SUR LE THÈME" (1/3) : le sweep tournait APRÈS les
    -- branches taggées. Or des couleurs du NOUVEAU thème coïncident avec des couleurs
    -- de l'ANCIEN thème sous une AUTRE clé (ex : Abyss.GradientB (191,90,242) ==
    -- Nebula.Accent) -> les éléments fraîchement recolorés en PASS 1 étaient RE-MAPPÉS
    -- par le sweep vers une autre couleur (l'accent paraissait faux). En balayant
    -- D'ABORD (aucun élément ne porte encore les couleurs du nouveau thème), plus
    -- aucune contamination croisée : les branches taggées gardent le dernier mot.
    -- FIX (2/3) : couleurs invariantes RÉSERVÉES. Success/Warning/Error sont
    -- identiques dans TOUS les thèmes et certains accents leur collent exactement
    -- (Crimson.Accent == Error, Evergreen.Accent == Success, Crimson.GradientA ==
    -- Warning) : quitter Crimson repeignait TOUS les éléments Error en couleur
    -- accent ! Tout RGB partagé avec une clé invariante est retiré du mapping
    -- (les éléments concernés restent stables ; les taggés sont recolorés en PASS 2).
    -- Garde-fous conservés : le blanc pur n'entre jamais dans la map (knobs,
    -- GradFill, flashes restent blancs) ; GradFill exclus du recoloriage de fond.
    -- =========================================================================
    local colorMap = {}
    local function ckey(c) return math.floor(c.R * 255 + 0.5) .. "," .. math.floor(c.G * 255 + 0.5) .. "," .. math.floor(c.B * 255 + 0.5) end
    local invariantRGB = {}
    for keySweep, valSweep in pairs(oldColors) do
        if newColors[keySweep] == valSweep then invariantRGB[ckey(valSweep)] = true end
    end
    for keySweep, oldVal in pairs(oldColors) do
        local newVal = newColors[keySweep]
        local ckSweep = ckey(oldVal)
        -- NB : les palettes ne contiennent que des Color3 -> pas besoin de typeof
        if oldVal ~= newVal and not invariantRGB[ckSweep] then
            colorMap[ckSweep] = newVal
        end
    end
    local oldGA, oldGB = oldColors.GradientA, oldColors.GradientB
    for _, gui in ipairs(allUIs) do
        for _, d in ipairs(gui:GetDescendants()) do
            pcall(function()
                if d:IsA("GuiObject") and d.Name ~= "GradFill" then
                    local m = colorMap[ckey(d.BackgroundColor3)]
                    if m then d.BackgroundColor3 = m end
                end
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    local m = colorMap[ckey(d.TextColor3)]
                    if m then d.TextColor3 = m end
                end
                if d:IsA("ImageLabel") or d:IsA("ImageButton") then
                    local m = colorMap[ckey(d.ImageColor3)]
                    if m then d.ImageColor3 = m end
                end
                if d:IsA("UIStroke") then
                    local m = colorMap[ckey(d.Color)]
                    if m then d.Color = m end
                end
                if d:IsA("ScrollingFrame") then
                    local m = colorMap[ckey(d.ScrollBarImageColor3)]
                    if m then d.ScrollBarImageColor3 = m end
                end
                if d:IsA("UIGradient") and oldGA and oldGB then
                    local kps = d.Color.Keypoints
                    if #kps == 2 and kps[1].Time == 0 and kps[2].Time == 1 and kps[1].Value == oldGA and kps[2].Value == oldGB then
                        d.Color = ColorSequence.new(newColors.GradientA, newColors.GradientB)
                    end
                end
            end)
        end
    end

    for _, gui in ipairs(allUIs) do
        for _, descendant in ipairs(gui:GetDescendants()) do
            pcall(function()
                local themeType = descendant:GetAttribute("ThemeType")
                -- FIX ROOT CAUSE THEME : le "return" anticipé sortait AVANT les branches
                -- ChimeraToggle/ChimeraTile/Switch pour tout élément sans ThemeType ->
                -- toggles, tuiles VFly et switchs ne suivaient JAMAIS le thème (code mort
                -- depuis l'origine). Le bloc taggé est désormais sous garde conditionnelle
                -- et les branches dédiées sont TOUJOURS atteintes.
                if themeType then
                if themeType:find("Glass") then descendant.BackgroundColor3 = (themeType:find("Background") and Theme.Current.Background or Theme.Current.Primary) end
                if themeType == "GlassBorder" then descendant.Color = Theme.Current.TextPrimary end
                if themeType == "Secondary" or themeType == "SecondaryGlass" then descendant.BackgroundColor3 = Theme.Current.Secondary end
                if themeType == "SecondaryStroke" then descendant.Color = Theme.Current.Secondary end
                if themeType == "Accent" then if descendant:IsA("TextLabel") then descendant.TextColor3 = Theme.Current.Accent else descendant.BackgroundColor3 = Theme.Current.Accent end end
                if themeType == "Warning" then descendant.BackgroundColor3 = Theme.Current.Warning; if descendant:FindFirstChild("Text") then descendant:FindFirstChild("Text").TextColor3 = Color3.new(1,1,1) end end
                if themeType == "DangerButton" then descendant.BackgroundColor3 = Theme.Current.Error; descendant.BackgroundTransparency = 0.84; if descendant:FindFirstChild("Text") then descendant:FindFirstChild("Text").TextColor3 = Color3.new(1, 1, 1) end end
                if themeType == "TextPrimary" then descendant.TextColor3 = Theme.Current.TextPrimary end
                if themeType == "TextSecondary" then if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then descendant.TextColor3 = Theme.Current.TextSecondary else descendant.ImageColor3 = Theme.Current.TextSecondary end end
                if themeType == "TextSecondaryKnob" then descendant.BackgroundColor3 = Theme.Current.TextSecondary end
                if themeType == "AccentScrollbar" then descendant.ScrollBarImageColor3 = Theme.Current.Accent end
                if themeType == "AccentSelector" then
                    descendant.BackgroundColor3 = Color3.new(1, 1, 1)
                    local g = descendant:FindFirstChildOfClass("UIGradient")
                    if g then g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(0.5, Theme.Current.Accent), ColorSequenceKeypoint.new(1, Theme.Current.Background) }) end
                end
                if themeType == "AccentGradientStroke" and descendant:IsA("UIStroke") then
                    local g = descendant:FindFirstChildOfClass("UIGradient")
                    if g then g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Theme.Current.Accent), ColorSequenceKeypoint.new(1, Theme.Current.GradientB or Theme.Current.Accent) }) end
                end
                if themeType == "AccentStroke" and descendant:IsA("UIStroke") then descendant.Color = Theme.Current.Accent end
                if themeType == "Icon" then local btn = descendant:FindFirstAncestorOfClass("TextButton"); if self.ActivePage and btn and btn.Name == self.ActivePage then descendant.ImageColor3 = Theme.Current.TextPrimary else descendant.ImageColor3 = Theme.Current.TextSecondary end end
                end -- fin du bloc taggé (themeType) : au-delà, traitement des éléments NON taggés
                if descendant:GetAttribute("ChimeraToggle") then
                    local isOn = descendant:GetAttribute("IsOn") == true
                    local track = descendant:FindFirstChild("Track")
                    local knob = descendant:FindFirstChild("Knob")
                    local tst = descendant:FindFirstChild("ToggleStroke")
                    local trkSt = descendant:FindFirstChild("ToggleTrackStroke")
                    local gradFill = track and track:FindFirstChild("GradFill")
                    if gradFill then
                        -- NOUVEAU STYLE : rail en dégradé de marque (GradientA -> GradientB)
                        -- FIX THEME : recalcule les couleurs du dégradé selon le thème ACTIF
                        local gFill = gradFill:FindFirstChildOfClass("UIGradient")
                        if gFill then gFill.Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB) end
                        gradFill.BackgroundTransparency = isOn and 0 or 1
                        if track then track.BackgroundColor3 = Theme.Current.Secondary; track.BackgroundTransparency = 0.25 end
                        if tst then tst.Color = isOn and Theme.Current.GradientB or Theme.Current.Secondary; tst.Transparency = isOn and 0.2 or 0.65 end
                        descendant.BackgroundColor3 = Theme.Current.Secondary
                        descendant.BackgroundTransparency = 0.75
                        if trkSt then trkSt.Color = isOn and Theme.Current.GradientB or Theme.Current.TextSecondary; trkSt.Transparency = isOn and 1 or 0.7 end
                    else
                        -- ANCIEN STYLE (toggles secondaires sans GradFill) : accent du thème
                        if isOn then
                            if track then track.BackgroundColor3 = Theme.Current.Accent; track.BackgroundTransparency = 0 end
                            if tst then tst.Color = Theme.Current.Accent end
                            descendant.BackgroundColor3 = Theme.Current.Accent
                        else
                            if track then track.BackgroundColor3 = Theme.Current.Secondary end
                            if tst then tst.Color = Theme.Current.Secondary end
                            descendant.BackgroundColor3 = Theme.Current.Secondary
                        end
                        if trkSt then trkSt.Color = isOn and Theme.Current.Accent or Theme.Current.TextSecondary end
                    end
                    if knob then knob.BackgroundColor3 = isOn and Color3.new(1,1,1) or Theme.Current.TextSecondary end
                    -- FIX v4.9.17 : label TOUJOURS blanc (lisible) — le rail néon indique l'état ON/OFF
                    local lblToggle = descendant:FindFirstChild("ToggleLabel")
                    if lblToggle then lblToggle.TextColor3 = Theme.Current.TextPrimary end
                end
                if descendant:GetAttribute("ChimeraTile") then
                    -- Tuiles VFly v4.12 : actif = DÉGRADÉ DE MARQUE (base blanche + BrandGrad),
                    -- inactif = verre neutre. Mêmes visuels que applyVisual (source unique = IsOn).
                    local isOn = descendant:GetAttribute("IsOn") == true
                    local tileIcon = descendant:FindFirstChildOfClass("ImageLabel")
                    local tileLbl = descendant:FindFirstChildOfClass("TextLabel")
                    local tileStroke = descendant:FindFirstChildOfClass("UIStroke")
                    local tileGrad = descendant:FindFirstChild("BrandGrad")
                    if isOn and tileGrad then
                        tileGrad.Enabled = true
                        tileGrad.Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB)
                        descendant.BackgroundColor3 = Color3.new(1, 1, 1)
                        descendant.BackgroundTransparency = 0.08
                        if tileStroke then tileStroke.Color = Theme.Current.GradientB; tileStroke.Transparency = 0.15 end
                        if tileIcon then tileIcon.ImageColor3 = Color3.new(1, 1, 1) end
                        if tileLbl then tileLbl.TextColor3 = Color3.new(1, 1, 1) end
                    else
                        if tileGrad then tileGrad.Enabled = false end
                        descendant.BackgroundColor3 = Theme.Current.Secondary
                        descendant.BackgroundTransparency = 0.35
                        if tileStroke then tileStroke.Color = Color3.new(1, 1, 1); tileStroke.Transparency = 0.86 end
                        if tileIcon then tileIcon.ImageColor3 = Theme.Current.TextSecondary end
                        if tileLbl then tileLbl.TextColor3 = Theme.Current.TextSecondary end
                    end
                end
                if descendant.Name == "Switch" then
                    local isOnSwitch = descendant:GetAttribute("IsOn")
                    local gfSwitch = descendant:FindFirstChild("GradFill")
                    if gfSwitch then
                        gfSwitch.BackgroundTransparency = isOnSwitch and 0 or 1
                        local gSwitch = gfSwitch:FindFirstChildOfClass("UIGradient")
                        if gSwitch then gSwitch.Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB) end
                    end
                    descendant.BackgroundColor3 = Theme.Current.Secondary
                    if descendant:FindFirstChild("Knob") then descendant.Knob.BackgroundColor3 = Theme.Current.TextPrimary end
                end
            end)
        end
    end

    -- FIX "IL FAUT APPUYER 2 FOIS SUR LE THÈME" (3/3) : notif + sauvegarde auto
    -- APRÈS le re-thémage, sous pcall. Avant, elles tournaient AVANT les sweeps :
    -- la notif (déjà aux couleurs du NOUVEAU thème) risquait d'être re-balayée,
    -- et surtout la moindre erreur transitoire de notif/sauvegarde AVORTAIT
    -- ApplyTheme avant le moindre recoloriage (l'UI gardait TOUTES les couleurs
    -- de l'ancien thème -> second clic nécessaire).
    if not isLoading then 
        pcall(function() self:ShowNotification("notif_theme_applied", newThemeScheme.Name) end)
        pcall(function() Chimera.Config:Save(true) end) 
    end

    if self.Pages[self.ActivePage] then 
        local pageData = self.Pages[self.ActivePage]
        if pageData.Label then pageData.Label.TextColor3 = Theme.Current.TextPrimary end
        if pageData.Icon then pageData.Icon.ImageColor3 = Theme.Current.TextPrimary end
        if self.UI.SidebarSelector then self.UI.SidebarSelector.BackgroundColor3 = Color3.new(1, 1, 1) end -- FIX : le vrai nom est SidebarSelector (SharedIndicator n'a jamais existé)
    end
end
