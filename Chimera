        local p = splitRow
        while p and p ~= workspace do
            local sc = p:FindFirstChildOfClass("UIScale")
            if sc then s = s * sc.Scale end
            p = p.Parent
        end
        if s < 0.05 then s = 1 end
        return px / s
    end
