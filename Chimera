UserInputService.InputChanged:Connect(function(input)
        local moveType = input.UserInputType
        if moveType ~= Enum.UserInputType.MouseMovement
                and moveType ~= Enum.UserInputType.Touch then
                return
        end
        if guiDragging and guiStartMouse then
                -- deplacement de la minimap par la poignee
                local delta = Vector2.new(input.Position.X, input.Position.Y) - guiStartMouse
                mapRoot.Position = UDim2.fromOffset(guiStartPos.X + delta.X, guiStartPos.Y + delta.Y)
        elseif isPanning and panLastInput then
                -- glisser sur la carte = regarder ailleurs
                local now = Vector2.new(input.Position.X, input.Position.Y)
                local deltaPx = now - panLastInput
                panLastInput = now
                if deltaPx.Magnitude > 0 then
                        local flat = smoothFlat or Vector3.new(0, 0, -1)
                        local right = Vector3.new(-flat.Z, 0, flat.X)
                        local spp = (2 * zoomCurrent) / math.max(mapContainer.AbsoluteSize.Y, 2)
                        panOffset = panOffset
                                + right * (-deltaPx.X * spp)
                                + flat * (deltaPx.Y * spp)
                        -- on ne s'eloigne pas plus loin que la carte elle-meme
                        local maxPan = math.clamp(2 * zoomCurrent, 400, CONFIG.TERRAIN_HALF * 0.95)
                        if panOffset.Magnitude > maxPan then
                                panOffset = panOffset.Unit * maxPan
                        end
                end
        end
end)

