                isBinding = false
                if bindConn then bindConn:Disconnect() end
                btnBind:FindFirstChild("Text").Text = assignedKey and assignedKey.Name:sub(1,3) or "..."
                return 
            end
            
            isBinding = true
            btnBind:FindFirstChild("Text").Text = "..."
            
            bindConn = game:GetService("UserInputService").InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    -- Nettoyage immédiat de l'écouteur de bind
                    isBinding = false
                    bindConn:Disconnect()

                    local key = input.KeyCode
                    
                    if key == Enum.KeyCode.Escape then
                        -- Unbind
                        if assignedKey then self.State.Keybinds[assignedKey] = nil end
                        assignedKey = nil
                        btnBind:FindFirstChild("Text").Text = "..."
                    else
                        -- Nettoyer l'ancienne clé du registre global
                        if assignedKey then self.State.Keybinds[assignedKey] = nil end
                        
                        -- Enregistrer la nouvelle clé
                        assignedKey = key
                        btnBind:FindFirstChild("Text").Text = key.Name:sub(1, 3)
                        
                        -- C'EST ICI : On insère la fonction ToggleLogic dans le registre global
                        self.State.Keybinds[key] = ToggleLogic
                        
                        -- Feedback immédiat
                        Chimera:ShowNotification("notif_feature_toggled", "Touche", key.Name)
                    end
                end
            end)
        end)
    -- v4.9 : on retourne le conteneur pour permettre d'ajouter des contrôles
    -- spécifiques à une rangée (ex : la flèche dépliable d'aimlock)
    return container
