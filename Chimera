    local currentFont = chatBypassFonts[1]

    local function ApplyBypass(text)
        local fontData = currentFont.Data
        local resultParts = {} 

        -- Gestion Arabe (Code existant)
        if currentFont.Name == "Style Arabe Pointillé" then
            local lines = {}
            for line in text:gmatch("([^\n]*)") do table.insert(lines, line) end
            local processedLines = {}
            for _, line in ipairs(lines) do
                local styledChars = {}
                for char in iter_graphemes(line) do table.insert(styledChars, fontData[char] or fontData[string.lower(char)] or char) end
                local reversed = {}; for i = #styledChars, 1, -1 do table.insert(reversed, styledChars[i]) end
                table.insert(processedLines, table.concat(reversed))
            end
            return table.concat(processedLines, "\n")
        end

        -- Conversion lettre par lettre
        for char in iter_graphemes(text) do
            -- On cherche la lettre dans ta table Data
            local replacement = fontData[char] or fontData[string.lower(char)] or char
            table.insert(resultParts, replacement)
        end

        -- Gestion Reverse (Optionnel)
        if currentFont.Reverse then
            local reversedParts = {}
            for i = #resultParts, 1, -1 do table.insert(reversedParts, resultParts[i]) end
            resultParts = reversedParts
        end

        local convertedText = table.concat(resultParts)

        -- >>> C'EST ICI QUE LA MAGIE OPÈRE <<<
        -- Ajout automatique du cadre ㍰۱ן ... ן۱㍰
        if currentFont.Prefix then convertedText = currentFont.Prefix .. convertedText end
