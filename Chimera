    -- === BODY LOCK (SÉLECTEUR + PROCHE + WALLCHECK) === --
    CreateAdvancedRow("Lock-On (Body)", 3, function(state)
        self.State.BodyLockActive = state

        if self.Connections.BodyLock then
            self.Connections.BodyLock:Disconnect()
            self.Connections.BodyLock = nil
        end

        if state then
            local RunService = game:GetService("RunService")
            local Players = game:GetService("Players")
            local LocalPlayer = Players.LocalPlayer
            local Workspace = game:GetService("Workspace")
            local Camera = workspace.CurrentCamera

            -- Fonction locale de Wall Check
            local function CheckVisibility(targetPart, targetModel)
                if not self.State.WallCheck then return true end -- Si WallCheck désactivé, on voit tout
                
                local origin = Camera.CFrame.Position
                local direction = targetPart.Position - origin
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {LocalPlayer.Character, targetModel}
                
                local result = Workspace:Raycast(origin, direction, params)
                return result == nil -- Visible si le rayon ne touche rien d'autre
            end

            self.Connections.BodyLock = RunService.RenderStepped:Connect(function()
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end

                local targetPart = nil
                local closestDist = math.huge -- On reset la distance à chaque frame

                -- ====================================================
                -- 1. PRIORITÉ ABSOLUE : SÉLECTEUR (Signature)
                -- ====================================================
                if self.State.CurrentSignature then
                    local sig = self.State.CurrentSignature
                    
                    -- On prépare une liste de candidats potentiels
                    local candidates = {}
                    
                    -- Optimisation : On regarde d'abord les joueurs
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then table.insert(candidates, p.Character) end
                    end
                    
                    -- Si c'est un objet, on regarde aussi le Workspace (attention au lag si trop d'objets)
                    if sig.Type == "PartName" then
                        for _, obj in ipairs(Workspace:GetDescendants()) do
                            if obj:IsA("Model") and obj ~= myChar then table.insert(candidates, obj) end
                        end
                    end

                    -- Scan des candidats pour trouver le plus proche
                    for _, model in ipairs(candidates) do
                        local match = false
                        -- Vérification correspondance nom ou humanoïde
                        if sig.Type == "Humanoid" and model:FindFirstChildOfClass("Humanoid") then match = true
                        elseif sig.Type == "PartName" and (model:FindFirstChild(sig.KeyPart) or model.Name == sig.KeyPart) then match = true end
                        
                        if match then
                            local part = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                            if part then
                                local dist = (myRoot.Position - part.Position).Magnitude
                                local maxDist = self.State.AimbotMaxDistance or 0 -- v4.9.3 FIX : distance max partagée (0 = illimitée)
                                -- On vérifie : 1. Distance max ? 2. Plus proche ? 3. Visible ? (Si WallCheck actif)
                                if not (maxDist > 0 and dist > maxDist) and dist < closestDist and CheckVisibility(part, model) then
                                    closestDist = dist
                                    targetPart = part
                                end
                            end
                        end
                    end
                end

                -- ====================================================
                -- 2. FALLBACK : JOUEUR LE PLUS PROCHE
                -- (Seulement si le sélecteur n'est pas actif ou n'a rien trouvé)
                -- ====================================================
                if not targetPart and not self.State.CurrentSignature then
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            -- Team Check
                            local isEnemy = true
                            if self.State.TeamCheck and LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team then
                                isEnemy = false
                            end

                            if isEnemy then
                                local h = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
                                if h then
                                    local dist = (myRoot.Position - h.Position).Magnitude
                                    local maxDist = self.State.AimbotMaxDistance or 0 -- v4.9.3 FIX : distance max partagée (0 = illimitée)
                                    -- On vérifie : 1. Distance max ? 2. Plus proche ? 3. Visible ?
                                    if not (maxDist > 0 and dist > maxDist) and dist < closestDist and CheckVisibility(h, p.Character) then
                                        closestDist = dist
                                        targetPart = h
                                    end
                                end
                            end
                        end
                    end
                end

                -- ====================================================
                -- APPLICATION DE LA ROTATION
