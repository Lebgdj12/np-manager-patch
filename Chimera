                if self.Connections.TrackPlayer then
                    self.Connections.TrackPlayer:Disconnect()
                    self.Connections.TrackPlayer = nil
                end
                return
            end

            local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if not myHum then return end

            local targetCharacterModel = nil
            self:RevalidateTarget()
            
            if self.State.target then
                targetCharacterModel = self.State.target.Character
            else
                targetCharacterModel = self.Functions:GetClosestTarget_Track()
            end

            if targetCharacterModel then
                local enemyHumanoid = targetCharacterModel:FindFirstChildOfClass("Humanoid")
                if enemyHumanoid and enemyHumanoid.Health > 0 then
                    local primaryPart = targetCharacterModel.PrimaryPart
                    if primaryPart then
                        pcall(myHum.MoveTo, myHum, primaryPart.Position)
                    end
                end
            end
        end)
    else
        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHum and myRoot then
            pcall(myHum.MoveTo, myHum, myRoot.Position)
        end
    end
    return true
