-- === AIMBOT HARD LOCK (VITESSE CORRIGÉE : RAPIDE SI SMOOTH BAS) === --
    local function RunHardLock(state)
        pcall(function() game:GetService("RunService"):UnbindFromRenderStep("ChimeraHardLockPriority") end)
        local TargetCache = {}; local LastScanTime = 0; local ScanInterval = 0.5 
        local PlayerAddedConn = nil; local PlayerRemovingConn = nil
        local VirtualTargetPos = nil
        
        if state then
            -- [[ AJOUT : NOTIFICATION SÉLECTEUR ]] --
            if not self.State.CurrentSignature then
                Chimera:ShowNotification("Attention N'oubliez pas de sélectionner une cible avec le Sélecteur !", "N'oubliez pas de sélectionner une cible avec le Sélecteur !")
            end
            -- [[ FIN AJOUT ]] --

            pcall(function() game.StarterGui:SetCoreGuiEnabled(2, true) end)
            PlayerAddedConn = Players.PlayerAdded:Connect(function() LastScanTime = 0 end); PlayerRemovingConn = Players.PlayerRemoving:Connect(function() LastScanTime = 0 end)
            
            local function RefreshTargetCache()
                if not self.State.CurrentSignature then return end
                local signature = self.State.CurrentSignature; local potentialEnemies = {}; local potentialEverything = {}
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and not IsMyOwn(obj) then
                        local match = false; if signature.Type == "Humanoid" then local h = obj:FindFirstChildOfClass("Humanoid"); if h and h.Health > 0 then match = true end elseif signature.Type == "PartName" then if obj:FindFirstChild(signature.KeyPart) then match = true end end
                        if match then 
                            local mainPart = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                            if mainPart and not IsIgnoredPart(mainPart) then
                                table.insert(potentialEverything, obj); if not IsTeammate(obj) then table.insert(potentialEnemies, obj) end 
                            end
                        end
                    end
                end
                if signature.Type == "PartName" and self.State.TeamCheck then TargetCache = potentialEnemies
                elseif #potentialEnemies == 0 and #potentialEverything > 0 and signature.Type == "PartName" and not self.State.TeamCheck then TargetCache = potentialEverything 
                else TargetCache = potentialEnemies end
            end

            game:GetService("RunService"):BindToRenderStep("ChimeraHardLockPriority", Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
                if not self.State.AimbotHard then 
                    pcall(function() game:GetService("RunService"):UnbindFromRenderStep("ChimeraHardLockPriority") end)
                    if PlayerAddedConn then PlayerAddedConn:Disconnect() end; if PlayerRemovingConn then PlayerRemovingConn:Disconnect() end; return 
                end
                
                if tick() - LastScanTime > ScanInterval then task.spawn(RefreshTargetCache); LastScanTime = tick() end
                local bestTargetPos = nil; local closestCriteria = math.huge; local myPos = (LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position) or Camera.CFrame.Position; local mouse = LocalPlayer:GetMouse()
                
                for _, model in pairs(TargetCache) do
                    if model and model.Parent then
                        local enemyPos = GetBodyCenter(model)
                        if enemyPos then
                            local partToCheck = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                            if partToCheck and not IsIgnoredPart(partToCheck) and IsVisible(partToCheck, model) then
                                local isValid = true
                                if self.State.MouseAssist then
                                    local sPos, onScreen = Camera:WorldToViewportPoint(enemyPos); local dist2D = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(sPos.X, sPos.Y)).Magnitude; if not onScreen or dist2D > 250 then isValid = false end
                                end
                                if isValid then local dist3D = (myPos - enemyPos).Magnitude; local maxDist = self.State.AimbotMaxDistance or 0; if not (maxDist > 0 and dist3D > maxDist) and dist3D < closestCriteria then closestCriteria = dist3D; bestTargetPos = enemyPos end end
                            end
                        end
                    end
                end

                if bestTargetPos then 
                    if not VirtualTargetPos then
                        VirtualTargetPos = Camera.CFrame.Position + (Camera.CFrame.LookVector * (Camera.CFrame.Position - bestTargetPos).Magnitude)
                    end

                    local spreadVal = self.State.AimbotSpread or 0
                    local spreadOffset = Vector3.new(0,0,0)
                    if spreadVal > 0 then
                        local time = tick()
                        spreadOffset = Vector3.new(math.sin(time*5), math.cos(time*4), 0) * (spreadVal / 5)
                    end

                    local RealDestination = bestTargetPos + Vector3.new(0, self.State.AimbotOffsetY, 0) + spreadOffset
                    
                    local smoothVal = self.State.AimbotSmoothness or 1

                    if smoothVal <= 1.2 then
                        VirtualTargetPos = RealDestination 
                    else
                        local speed = 1 / (smoothVal * 0.3) 
                        if speed > 1 then speed = 1 end
                        VirtualTargetPos = VirtualTargetPos:Lerp(RealDestination, speed)
                    end

                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, VirtualTargetPos)
                else
                    VirtualTargetPos = nil
                end
            end)
        end
    end
    
    
    function Chimera:ToggleAimbot(state)
    -- On nettoie l'ancienne connexion si elle existe
    if self.Connections.Aimbot then 
        self.Connections.Aimbot:Disconnect()
        self.Connections.Aimbot = nil 
    end

    if state then
        -- Fonction de recherche de cible
        local function getClosestTarget() 
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myRoot then return nil end
            
            local bestTargetPart = nil
            local closestDist = math.huge

            -- CAS 1 : MODE SÉLECTEUR ACTIF (On a une signature)
            if self.State.CurrentSignature then
                local sig = self.State.CurrentSignature
                
                -- On scanne le workspace pour trouver les objets correspondants
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and not IsMyOwn(obj) then
                        local match = false
                        
                        -- Vérif Humanoid
                        if sig.Type == "Humanoid" and obj:FindFirstChildOfClass("Humanoid") then 
                            match = true 
                        
                        -- Vérif Nom d'objet
                        elseif sig.Type == "PartName" then
                            -- On cherche si le modèle contient la part cliquée OU si c'est le modèle lui-même
                            if obj:FindFirstChild(sig.KeyPart) or obj.Name == sig.KeyPart then 
                                match = true 
                            end
                        end

                        if match then 
                            -- On définit quelle partie viser (RootPart ou PrimaryPart)
                            local targetPart = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChild(sig.KeyPart)
                            
                            if targetPart and not IsIgnoredPart(targetPart) and IsVisible(targetPart, obj) then 
                                local dist = (myRoot.Position - targetPart.Position).Magnitude
                                local maxDist = self.State.AimbotMaxDistance or 0 -- v4.9.2 : distance max
                                if not (maxDist > 0 and dist > maxDist) and dist < closestDist then 
                                    closestDist = dist
                                    bestTargetPart = targetPart 
                                end 
                            end
                        end
                    end
                end
                
                -- Si on est en mode sélecteur, on retourne ce qu'on a trouvé (ou rien). 
                -- On ne passe PAS aux joueurs si on ne trouve rien, pour respecter le "Hard Lock".
                return bestTargetPart

            -- CAS 2 : MODE PAR DÉFAUT (Pas de signature = On vise les joueurs)
            else
                local potentialEnemies = {}
                local potentialEverything = {}
                
                for _, p in ipairs(Players:GetPlayers()) do 
                    if p ~= LocalPlayer and p.Character then
                        local root = p.Character:FindFirstChild("HumanoidRootPart")
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        
                        if root and hum and hum.Health > 0 then
                            if not IsIgnoredPart(root) and IsVisible(root, p.Character) then 
                                table.insert(potentialEverything, root)
                                if not IsTeammate(p.Character) then 
                                    table.insert(potentialEnemies, root) 
                                end 
                            end
                        end
                    end 
                end
                
                -- Priorité aux ennemis, sinon on prend tout le monde
                local targetList = (#potentialEnemies > 0) and potentialEnemies or potentialEverything
                
                for _, root in ipairs(targetList) do 
                    local dist = (myRoot.Position - root.Position).Magnitude
                    local maxDist = self.State.AimbotMaxDistance or 0 -- v4.9.2 : distance max
                    if not (maxDist > 0 and dist > maxDist) and dist < closestDist then 
                        closestDist = dist
                        bestTargetPart = root 
                    end 
                end
                
                return bestTargetPart
            end
        end

        -- La boucle RenderStepped (Mouvement de la caméra)
        self.Connections.Aimbot = game:GetService("RunService").RenderStepped:Connect(function() 
            local targetPart = getClosestTarget()
            
            if targetPart then 
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    -- Mouse Assist (FOV Check)
                    local isValid = true
                    if self.State.MouseAssist then
                        local sPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        local mouse = LocalPlayer:GetMouse()
                        local dist2D = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(sPos.X, sPos.Y)).Magnitude
                        
                        if not onScreen or dist2D > (self.State.AimbotFOV or 200) then 
                            isValid = false 
                        end
                    end

                    if isValid then
                        local targetPos = targetPart.Position + Vector3.new(0, self.State.AimbotOffsetY or 0, 0)
                        
                        -- Calcul de la position caméra (Vue TPS/FPS fluide)
                        local pivotPoint = myRoot.Position + Vector3.new(0, 1.5, 0)
                        local curDist = (Camera.CFrame.Position - pivotPoint).Magnitude
                        if curDist < 2 then curDist = 2 end -- Distance min
                        
                        local dir = (targetPos - pivotPoint).Unit
                        
                        -- Application de la visée (Smooth ou Brut)
                        local newCFrame = CFrame.new(pivotPoint - (dir * curDist), targetPos)
                        
                        -- Tu peux ajouter un Lerp ici si tu veux du lissage, sinon c'est instantané
                        Camera.CFrame = newCFrame
                    end
                end
            end 
        end)
    end
end
