    -- 2. FONCTION DE RECHERCHE INTELLIGENTE
    local function GetBestTargetForCamLock()
        local mouseLocation = UserInputService:GetMouseLocation()
        local closest = nil
        local bestScore = math.huge 
        
        local candidates = {}
        
        -- A. Filtrage (Sélecteur vs Tout le monde)
        if self.State.CurrentSignature then
            local sig = self.State.CurrentSignature
            if sig.Type == "Humanoid" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then table.insert(candidates, p.Character) end
                end
            elseif sig.Type == "PartName" then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and not IsMyOwn(obj) then table.insert(candidates, obj) end
                end
            end
        else
            -- Pas de signature = on vise les joueurs ennemis
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then table.insert(candidates, p.Character) end
            end
        end

        -- B. Scan des candidats (Distance Souris + WallCheck)
        for _, model in ipairs(candidates) do
            if not IsMyOwn(model) and not IsTeammate(model) then
                
                -- Vérif Signature interne
                local match = true
                if self.State.CurrentSignature then
                    match = false
                    if self.State.CurrentSignature.Type == "Humanoid" and model:FindFirstChildOfClass("Humanoid") then match = true
                    elseif self.State.CurrentSignature.Type == "PartName" and (model:FindFirstChild(self.State.CurrentSignature.KeyPart) or model.Name == self.State.CurrentSignature.KeyPart) then match = true end
                end

                if match then
                    -- On cherche la partie à viser (Tête ou Root)
                    local part = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model.PrimaryPart
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    
                    if part and (not hum or hum.Health > 0) then
                        
                        -- C. Wall Check (Si activé dans Chimera)
                        local isVisible = true
                        if self.State.WallCheck then 
                            isVisible = IsVisible(part, model) -- Utilise ta fonction IsVisible locale
                        end

                        if isVisible then
                            -- v4.9.2 : Distance Max (0 = illimitée) — les cibles trop loin sont ignorées
                            local maxDist = self.State.AimbotMaxDistance or 0
                            if maxDist > 0 then
                                local myPos = (LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position) or Camera.CFrame.Position
                                if (myPos - part.Position).Magnitude > maxDist then isVisible = false end
                            end
                        end

                        if isVisible then
                            -- D. Calcul FOV (Écran)
                            local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local mag = (Vector2.new(mouseLocation.X, mouseLocation.Y) - Vector2.new(screen.X, screen.Y)).Magnitude
                                
                                -- Si dans le cercle et plus proche du curseur
                                if mag < bestScore and mag <= self.State.CamLockFOV then
                                    bestScore = mag
                                    closest = part
                                end
                            end
                        end
                    end
                end
            end
        end
        return closest
    end

