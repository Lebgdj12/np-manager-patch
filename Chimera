    -- =========================================================================
    -- 4. LOGIQUE DE CAPTURE
    -- =========================================================================
    local function NewLog(req, res)
        if not IsSpying then return end
        local data = {
            ID = os.clock(),
            Url = req.Url or "Unknown",
            Method = (req.Method or "GET"):upper(),
            Headers = req.Headers,
            Body = req.Body,
            Status = res and res.StatusCode or 0,
            Response = res and res.Body or "No Response"
        }
        table.insert(LogHistory, data)
        
        -- SAUVEGARDE SUR LE DISQUE
        SaveRequestToFile(data)

        if #LogHistory > MaxRequests then table.remove(LogHistory, 1) end
        if page.Visible then CreateRequestCard(data) end
    end

    if not getgenv()._ChimeraHttpHooked then
        getgenv()._ChimeraHttpHooked = true
        local oldReq; oldReq = hookfunction(request or http.request or http_request, function(options)
            local response = oldReq(options)
            if type(options) == "table" then task.spawn(NewLog, options, response) end
            return response
        end)
        local oldGet; oldGet = hookfunction(game.HttpGet, function(self, url, ...)
            local res = oldGet(self, url, ...)
            task.spawn(NewLog, {Url = url, Method = "GET"}, {StatusCode = 200, Body = res})
            return res
        end)
    end

    btnClear.Activated:Connect(function() LogHistory = {}; RefreshLogs() end)
    searchBox:GetPropertyChangedSignal("Text"):Connect(function() SearchTerm = searchBox.Text; RefreshLogs() end)
    page:GetPropertyChangedSignal("Visible"):Connect(function() if page.Visible then RefreshLogs() end end)
    
    RefreshLogs()
end
