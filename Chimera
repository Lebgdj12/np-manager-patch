function Chimera:RequestAI(msg)
    local r_func = request or http_request or (syn and syn.request) or (Fluxus and Fluxus.request)
    if not r_func then return "Erreur: Executor non supporté." end

    local HttpService = game:GetService("HttpService")
    local source = self.State.AI_Source
    local mood = self.State.AI_Mood
    local reply = ""

    -- 1. INITIALISATION DE LA MÉMOIRE (Si vide)
    if not self.State.AI_Memory then self.State.AI_Memory = {} end

    -- 2. CONSTRUCTION DES FORMATS DE MÉMOIRE
    -- Format A : Liste pour Nebula / SambaNova (Moderne)
    local memory_list = {}
    for _, m in pairs(self.State.AI_Memory) do
        table.insert(memory_list, {role = m.role, content = m.content})
    end

    -- Format B : Texte concaténé pour Chimera / Hercai (Legacy)
    local legacy_ctx = ""
    for _, m in pairs(self.State.AI_Memory) do
        local prefix = (m.role == "user") and "[P]: " or "[A]: "
        legacy_ctx = legacy_ctx .. prefix .. m.content:sub(1,80) .. " | " -- on tronque un peu pour pas saturer l'URL
    end

    -- =========================================================
    -- SOURCE : NEBULA-ULTRA (BOOSTER AVEC MÉMOIRE)
    -- =========================================================
    if source == "NEBULA-ULTRA" then
        local system_content = "Tu es Chimera AI. Persona: " .. mood_prompts[mood] .. ". Garde tes réponses courtes. Voici l'historique pour ton contexte."
        
        -- On assemble : System Prompt + Historique + Nouveau Message
        local full_messages = {{role = "system", content = system_content}}
        for _, m in ipairs(memory_list) do table.insert(full_messages, m) end
        table.insert(full_messages, {role = "user", content = msg})

        local s, r = pcall(function()
            return r_func({
                Url = "https://api.pawan.krd/v1/chat/completions",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json", ["Authorization"] = "Bearer pk-anonymous"},
                Body = HttpService:JSONEncode({
                    model = "gpt-4o-mini",
                    messages = full_messages,
                    temperature = 0.8
                })
            })
        end)

        if s and r.StatusCode == 200 then
            reply = HttpService:JSONDecode(r.Body).choices[1].message.content
        else
            source = "SAMBANOVA" -- Failover si Nebula crash
        end
    end

    -- =========================================================
    -- SOURCE : SAMBANOVA (ROTATION CLÉS AVEC MÉMOIRE)
    -- =========================================================
    if source == "SAMBANOVA" and reply == "" then
        local sys_prompt = "Persona: "..mood_prompts[mood]..". Answer briefly using the provided history."
        local startKey = self.State.CurrentKeyIndex or 1
        local totalKeys = #SAMBA_KEYS
        
        for i = 0, totalKeys - 1 do
            local attemptIndex = ((startKey + i - 1) % totalKeys) + 1
            local currentKey = SAMBA_KEYS[attemptIndex]
            
            -- Préparation payload
            local current_msgs = {{role = "system", content = sys_prompt}}
            for _, m in ipairs(memory_list) do table.insert(current_msgs, m) end
            table.insert(current_msgs, {role = "user", content = msg})

            local s, r = pcall(function()
                return r_func({
                    Url = "https://api.sambanova.ai/v1/chat/completions",
                    Method = "POST",
                    Headers = {["Authorization"] = "Bearer " .. currentKey, ["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode({model = "Meta-Llama-3.3-70B-Instruct", messages = current_msgs, temperature = 0.8})
                })
            end)

            if s and r.StatusCode == 200 then
                self.State.CurrentKeyIndex = attemptIndex
                reply = HttpService:JSONDecode(r.Body).choices[1].message.content
                break
            end
        end
    end

    -- =========================================================
    -- SOURCE : CHIMERA (ORIGINAL SYNERGY AVEC MÉMOIRE)
    -- =========================================================
    if source == "CHIMERA" and reply == "" then
        local data = {
            ["TYUIOPAS"] = "Ih'wbuthifkns~'nt'fqfnkfekb)", 
            ["UJIKOLPM"] = ChimeraAITranslate(legacy_ctx .. " [NOW]: " .. msg),
            ["PLMOKNJI"] = "4", ["QWERTYUI"] = "Abidni`", ["ZXCVBNMA"] = "?", ["bNAZkwdX"] = {}, 
            ["ZXCASDFG"] = "ink", ["MNBVCXZQ"] = "ufwofbk", ["GHFDSARE"] = "T~ibu`~'FN"
        }
        local s, r = pcall(function()
            return r_func({
                Url = "https://synergy.eu.pythonanywhere.com/bot",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end)
        if s and r.StatusCode == 200 then reply = HttpService:JSONDecode(r.Body).Cevap end
    end

    -- =========================================================
    -- SOURCE : HERCAI (ULTIME SECOURS)
    -- =========================================================
    if reply == "" then
        local s, res = pcall(function() 
            return game:HttpGet("https://hercai.onrender.com/v3/hercai?question=" .. HttpService:UrlEncode(legacy_ctx .. " " .. msg)) 
        end)
        if s and res then reply = HttpService:JSONDecode(res).reply end
    end

    -- 3. MISE À JOUR DE LA MÉMOIRE (User + Assistant)
    if reply ~= "" then
        -- On ajoute le message du joueur
        table.insert(self.State.AI_Memory, {role = "user", content = msg})
        -- On ajoute la réponse de l'IA
        table.insert(self.State.AI_Memory, {role = "assistant", content = reply})

        -- Limite de mémoire : on garde les 10 derniers messages (5 échanges)
        -- pour éviter les erreurs de "Token Limit" sur les APIs.
        if #self.State.AI_Memory > 10 then 
            table.remove(self.State.AI_Memory, 1) -- Enlève le plus vieux
            table.remove(self.State.AI_Memory, 1) -- Enlève sa réponse
        end
        return reply
    end

    return "Erreur de connexion. Réessaye."
end
