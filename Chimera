-- ═══ VUE LIBRE : glisser sur la carte pour regarder autour de soi ═══
-- La carte suit ton doigt / ta souris (comme Google Maps). Des que ton
-- perso bouge, la vue se re-centre doucement sur lui (géré dans la boucle).
-- Molette sur la carte = zoom avant / arriere.
local panLastInput = nil
local function bindPanSurface(surface)
        if not surface then return end
        surface.Active = true
        surface.InputBegan:Connect(function(input)
                if not CONFIG.PAN_ENABLED then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        isPanning = true
                        panLastInput = Vector2.new(input.Position.X, input.Position.Y)
                end
        end)
end
