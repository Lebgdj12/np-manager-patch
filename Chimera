    local function UpdateIntel(target)
        worldModel:ClearAllChildren()
        
        if target and target.Character then
            target.Character.Archivable = true
            local clone = target.Character:Clone()
            target.Character.Archivable = false
            for _, v in pairs(clone:GetDescendants()) do 
                if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Sound") or v:IsA("Tool") or v:IsA("ForceField") then v:Destroy() end 
            end
            clone.Parent = worldModel
            
            -- AUTO-FIT & CENTRAGE
            local cf, size = clone:GetBoundingBox()
            clone:PivotTo(CFrame.new() * (cf - cf.Position)) -- Centre parfait à 0,0,0
            
            local maxDimension = math.max(size.Y, size.X, size.Z)
            local fovRad = math.rad(15)
            local fitDistance = (maxDimension / 2) / math.tan(fovRad / 2)
            currentZoom = fitDistance * 1.2
            
            camOrbitX, camOrbitY = 0, 0.2
            local light = Instance.new("PointLight", clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart)
            light.Brightness = 2; light.Range = 40; light.Shadows = true
        end

        if target then
            lblID.Text = tostring(target.UserId)
            local timestamp = os.time() - (target.AccountAge * 86400)
            lblJoinDate.Text = os.date("%d/%m/%Y", timestamp)
            lblAge.Text = target.AccountAge .. " jours"
            
            task.spawn(function()
                local s, app = pcall(function() return Players:GetCharacterAppearanceInfoAsync(target.UserId) end)
                if s and app.assets then
                    local t = 0
                    for _, a in pairs(app.assets) do
                        local s2, i = pcall(function() return MarketplaceService:GetProductInfo(a.id, Enum.InfoType.Asset) end)
                        if s2 and i and i.PriceInRobux then t = t + i.PriceInRobux end
                    end
                    lblCost.Text = t .. " R$"
                else lblCost.Text = "N/A" end
            end)

            task.spawn(function()
                local c, s, p = 0, pcall(function() return Players:GetFriendsAsync(target.UserId) end)
                if s then
                    while true do for _ in pairs(p:GetCurrentPage()) do c=c+1 end; if p.IsFinished then break end; local okP = pcall(p.AdvanceToNextPageAsync, p); if not okP then break end end
                    lblFriends.Text = tostring(c)
                else lblFriends.Text = "?" end
            end)
        else
            lblID.Text = "N/A"; lblJoinDate.Text = "N/A"; lblAge.Text = "N/A"; lblCost.Text = "N/A"; lblFriends.Text = "N/A"
        end
    end

    task.spawn(function()
        while page and page.Parent do
            if self.State.target then
                local t = self.State.target
                local c = t.Character
                if c and c:FindFirstChild("Humanoid") then
                    lblStatus.Text = (c.Humanoid.Health<=0 and "Mort") or (c.Humanoid.Sit and "Assis") or "En vie"
                else lblStatus.Text = "-" end

                local fh = {}; for _, p in ipairs(Players:GetPlayers()) do if p ~= t then local okF, isF = pcall(t.IsFriendsWith, t, p.UserId); if okF and isF then table.insert(fh, p.DisplayName) end end end
                lblFriendsInGame.Text = #fh > 0 and (#fh.." ("..fh[1]:sub(1,10)..")") or "0"

                UpdateHeaderVisuals() -- FIX SCROLL : le canvas est désormais automatique (la boucle ne le recalcule plus, elle mourrait avec la page)
            else lblStatus.Text = "N/A"; lblFriendsInGame.Text = "N/A" end
            
            if self.State.target ~= lastTarget then lastTarget = self.State.target; UpdateIntel(lastTarget) end
            task.wait(0.5)
        end
    end)
end
function Chimera:ToggleAimbot(state) 
    -- UNIFICATION AIMBOT : ToggleAimbot était défini 3x dans l'historique -> on purge
    -- systématiquement TOUS les anciens moteurs de lock avant d'armer le bon
    pcall(function() RunService:UnbindFromRenderStep("ChimeraHardLock") end)
    pcall(function() RunService:UnbindFromRenderStep("ChimeraHardLockPriority") end)
    pcall(function() RunService:UnbindFromRenderStep("ChimeraCamLockV2") end)
    pcall(function() RunService:UnbindFromRenderStep("ChimeraTeamLock") end)
    self.State.aimbotEnabled = state
    self:ShowNotification("notif_feature_toggled", "Aimbot & TeamCheck", T(state and "notif_state_on" or "notif_state_off"))

    pcall(function() game:GetService("RunService"):UnbindFromRenderStep("ChimeraTeamLock") end)
    local oldTool = game.Players.LocalPlayer.Backpack:FindFirstChild("Aim Selector") or game.Players.LocalPlayer.Character:FindFirstChild("Aim Selector")
    if oldTool then oldTool:Destroy() end

    local CibleSignature = nil 
    local TargetCache = {}
    local LastScanTime = 0
    local ScanInterval = 1.0 

    if self.State.aimbotEnabled then 
        
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local Camera = workspace.CurrentCamera
        local RunService = game:GetService("RunService")
        local Workspace = game:GetService("Workspace")
        
        local SEARCH_RADIUS_3D = 2000 

        -- === FONCTION IS TEAMMATE AMÉLIORÉE (LE COEUR DU PROBLÈME) ===
        local function IsTeammate(model)
            -- Si le bouton Team Check est éteint, on tue tout le monde
            if not self.State.TeamCheck then return false end
            
            local player = Players:GetPlayerFromCharacter(model)
            
            -- CHECK 1 : SYSTÈME ROBLOX OFFICIEL (Jeux standards)
            if player then
                -- Même Team Object
                if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then return true end
                -- Même TeamColor
                if LocalPlayer.TeamColor and player.TeamColor and LocalPlayer.TeamColor == player.TeamColor then return true end
                -- Même propriété "Neutral" (Si Neutral est on, on s'attaque pas ?) -> Dépend des jeux, on ignore souvent.
            end

            -- Si le check officiel échoue ou si c'est un NPC, on passe au SCAN PROFOND
            
            -- Préparation de mes données d'équipe
            local myTeamColor = LocalPlayer.TeamColor.Color
            local myTeamName = LocalPlayer.Team and LocalPlayer.Team.Name or ""
            
            -- On cherche une valeur "Team" dans MON perso (pour les jeux custom)
            local myCustomTeam = LocalPlayer:GetAttribute("Team") or LocalPlayer:GetAttribute("Squad")
            if LocalPlayer.Character then
                local val = LocalPlayer.Character:FindFirstChild("Team") or LocalPlayer.Character:FindFirstChild("TeamName")
                if val then myCustomTeam = val.Value end
            end

            -- CHECK 2 : COULEUR DU PERSONNAGE (Jeux Tycoon/Guerre basiques)
            -- On regarde si la tête ou le torse de l'ennemi a la même couleur que MON équipe
            local targetBody = model:FindFirstChild("Head") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChildWhichIsA("BasePart")
            if targetBody and targetBody.Color == myTeamColor then
                return true -- C'est un allié par couleur !
            end

            -- CHECK 3 : ATTRIBUTS & VALUES (Jeux FPS avancés)
            local targetCustomTeam = model:GetAttribute("Team") or model:GetAttribute("Squad")
            local targetVal = model:FindFirstChild("Team") or model:FindFirstChild("TeamName")
            if targetVal then targetCustomTeam = targetVal.Value end

            if myCustomTeam and targetCustomTeam and myCustomTeam == targetCustomTeam then
                return true -- C'est un allié par variable cachée !
            end

            return false -- Si rien ne matche, c'est un ENNEMI
        end

        local function IsMyOwn(model)
            if not model then return false end
            if model == LocalPlayer.Character then return true end
            if model:IsDescendantOf(LocalPlayer.Character) then return true end
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.SeatPart and hum.SeatPart.Parent == model then return true end
            return false
        end

        local function GetBodyCenter(model)
            if not model then return nil end
            local centerPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Chest")
            if centerPart then return centerPart.Position end
            if model.PrimaryPart then return model.PrimaryPart.Position end
            return model:GetPivot().Position + Vector3.new(0, 1.5, 0)
        end

        local function GetMyPosition()
            if LocalPlayer.Character then return LocalPlayer.Character:GetPivot().Position
            else return Camera.CFrame.Position end
        end

        local function RefreshTargetCache()
            if not CibleSignature then return end
            local newCache = {}
            
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and not IsMyOwn(obj) then
                    
                    -- LE TEAM CHECK SE FAIT ICI
                    if not IsTeammate(obj) then
                        local match = false
                        if CibleSignature.Type == "Humanoid" then
                            local h = obj:FindFirstChildOfClass("Humanoid")
                            if h and h.Health > 0 then match = true end
                        elseif CibleSignature.Type == "PartName" then
                            if obj:FindFirstChild(CibleSignature.KeyPart) then match = true end
                        end
                        if match then table.insert(newCache, obj) end
                    end
                end
            end
            TargetCache = newCache
        end

        local Tool = Instance.new("Tool")
        Tool.RequiresHandle = false
        Tool.Name = "Aim Selector"
        Tool.ToolTip = "Clique pour calibrer"
        Tool.TextureId = "rbxassetid://2716591855"
        
        Tool.Activated:Connect(function()
            local hit = LocalPlayer:GetMouse().Target
            if hit then
                local model = hit:FindFirstAncestorOfClass("Model") or hit.Parent
                
                if model and not IsMyOwn(model) then
                    if model:FindFirstChildOfClass("Humanoid") then
                        CibleSignature = { Type = "Humanoid" }
                        Chimera:ShowNotification("notif_feature_toggled", "Cible", "Vivants")
                    else
                        local keyPart = model.PrimaryPart or hit
                        CibleSignature = { Type = "PartName", KeyPart = keyPart.Name }
                        Chimera:ShowNotification("notif_feature_toggled", "Cible", "Objets ("..keyPart.Name..")")
                    end
                    
                    local hl = Instance.new("Highlight")
                    hl.Parent = model; hl.FillColor = Color3.new(1,0,0); hl.OutlineColor = Color3.new(1,1,1)
                    game:GetService("Debris"):AddItem(hl, 1)
                    task.spawn(RefreshTargetCache)
                end
            end
        end)
        Tool.Parent = LocalPlayer.Backpack
        if LocalPlayer.Character then 
            local h = LocalPlayer.Character:FindFirstChild("Humanoid")
            if h then h:EquipTool(Tool) end
        end

        RunService:BindToRenderStep("ChimeraTeamLock", Enum.RenderPriority.Last.Value, function()
            if not self.State.aimbotEnabled then pcall(function() RunService:UnbindFromRenderStep("ChimeraTeamLock") end); return end

            if tick() - LastScanTime > ScanInterval then
                task.spawn(RefreshTargetCache)
                LastScanTime = tick()
            end

            local bestTargetPos = nil
            local closestDist3D = SEARCH_RADIUS_3D 
            local myPos = GetMyPosition()

            for _, model in pairs(TargetCache) do
                if model and model.Parent then
                    local enemyPos = GetBodyCenter(model)
                    local dist = (myPos - enemyPos).Magnitude
                    local maxDist = self.State.AimbotMaxDistance or 0 -- v4.9.3 FIX : distance max partagée (0 = illimitée)
                    if not (maxDist > 0 and dist > maxDist) and dist < closestDist3D then
                        closestDist3D = dist
                        bestTargetPos = enemyPos
                    end
                end
            end

            if bestTargetPos then
                local currentCamPos = Camera.CFrame.Position
                Camera.CFrame = CFrame.lookAt(currentCamPos, bestTargetPos)
            end
        end)
    end
    return true
end
