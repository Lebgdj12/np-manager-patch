    -- Si l'interface principale existe déjà
    local mainFrame = existingGui:FindFirstChild("MainFrame")
    local minimizedBtn = existingGui:FindFirstChild("MinimizedButton")
    
    if mainFrame and minimizedBtn then
        -- Cas 1 : L'interface est minimisée
        if not mainFrame.Visible and minimizedBtn.Visible then
            -- On anime le bouton minimisé vers le centre
            minimizedBtn.AnchorPoint = Vector2.new(0.5, 0.5) -- Pour centrer parfaitement
            TweenService:Create(minimizedBtn, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, 0, 0.5, 0)
            }):Play()
            
            -- Notification système (optionnel)
            local StarterGui = game:GetService("StarterGui")
            StarterGui:SetCore("SendNotification", {
                Title = "Chimera",
                Text = "Interface déjà ouverte (Minimisée)",
                Duration = 3
            })
            
-- Cas 2 : L'interface est ouverte (ou cachée mais pas minimisée)
        else
            mainFrame.Visible = true
            -- On s'assure que le contenu est visible
            local content = mainFrame:FindFirstChild("MainContent")
            if content then content.BackgroundTransparency = 0.3 end -- <--- CORRECTION : On met 0.3 direct
            
            -- On anime le cadre principal vers le centre
            mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
            TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, 0, 0.5, 0)
            }):Play()
            
            -- Notification système
            local StarterGui = game:GetService("StarterGui")
            StarterGui:SetCore("SendNotification", {
                Title = "Chimera",
                Text = "Interface recentrée !",
                Duration = 3
            })
        end
    end
    
    -- ON ARRÊTE TOUT ICI : Le script ne se relance pas
    return 
end
