        Create.Element("UICorner", {Parent = knob, CornerRadius = UDim.new(1, 0)})

        local isOn = defaultState or false
        
        local function SetState(state)
            isOn = state
            button:SetAttribute("IsOn", state)
            
            -- Couleurs (dégradé de marque)
