-- Fonction Mathématique pour trouver le point le plus proche sur une Part (Bounding Box)
-- Fonction Mathématique pour trouver le point le plus proche sur une Part
local function GetClosestPointOnPart(part, point)
    local cf = part.CFrame
    local rel = cf:PointToObjectSpace(point)
    local size = part.Size / 2
    
    -- On cherche le point le plus proche sur la boîte de collision
    local clamped = Vector3.new(
        math.clamp(rel.X, -size.X, size.X),
        math.clamp(rel.Y, -size.Y, size.Y),
        math.clamp(rel.Z, -size.Z, size.Z)
    )
    
    -- Conversion en coordonnées monde
    return cf:PointToWorldSpace(clamped)
end
function Chimera:ToggleAntiFall(state)
    self.State.AntiFall = state
    if self.State.AntiFallSmartTP == nil then self.State.AntiFallSmartTP = false end
    
    -- Cette notif reste (pour dire si tu as activé ou désactivé le module)
    self:ShowNotification("notif_feature_toggled", "Anti-Fall", T(state and "notif_state_on" or "notif_state_off"))

    if self.Connections.AntiFall then
        self.Connections.AntiFall:Disconnect()
        self.Connections.AntiFall = nil
    end

    if state then
        local lastSafeCFrame = nil 
        local lastRefY = nil       
        
        self.Connections.AntiFall = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            
            if not char or not root or not hum or hum.Health <= 0 then return end

            -- 1. Check Sol
            local rayParams = RaycastParams.new()
            rayParams.FilterDescendantsInstances = {char}
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.IgnoreWater = true 
            
            local ray = Workspace:Raycast(root.Position, Vector3.new(0, -10, 0), rayParams)
            local isSolidGround = (ray and ray.Instance and ray.Instance.CanCollide == true)
            
            -- 2. Check VOL
            local hasBodyMovers = root:FindFirstChildWhichIsA("BodyVelocity") or root:FindFirstChildWhichIsA("BodyGyro") or root:FindFirstChildWhichIsA("LinearVelocity")
            local isFlying = self.State.isFlying or hum.Sit or hum.PlatformStand or hasBodyMovers

            if isSolidGround then
                lastSafeCFrame = root.CFrame
                lastRefY = root.Position.Y
            elseif isFlying then
                lastRefY = root.Position.Y
                return 
            else
                -- [CHUTE]
                if lastRefY then
                    local fallDistance = lastRefY - root.Position.Y
                    
                    if fallDistance > 50 then
                        local targetCFrame = nil
                        local smartSuccess = false
                        
                        -- === LOGIQUE SMART TELEPORT ===
                        if self.State.AntiFallSmartTP then
                            local overlapParams = OverlapParams.new()
                            overlapParams.FilterDescendantsInstances = {char}
                            overlapParams.FilterType = Enum.RaycastFilterType.Exclude
                            
                            local parts = workspace:GetPartBoundsInRadius(root.Position, 300, overlapParams)
                            local closestDist = math.huge
                            local bestSpot = nil
                            
                            for _, part in ipairs(parts) do
                                if part:IsA("BasePart") and part.CanCollide == true and part.Transparency < 1 and not part.Name:lower():find("water") then
                                    
                                    -- Centre haut de la part
                                    local topCenter = part.Position + Vector3.new(0, part.Size.Y / 2, 0)
                                    
                                    -- Check Obstruction
                                    local roofRay = workspace:Raycast(topCenter, Vector3.new(0, 6, 0), rayParams)
                                    
                                    if not roofRay then
                                        local dist = (topCenter - root.Position).Magnitude
                                        
                                        if dist < closestDist then
                                            closestDist = dist
                                            bestSpot = topCenter
                                        end
                                    end
                                end
                            end
                            
                            if bestSpot then
                                targetCFrame = CFrame.new(bestSpot + Vector3.new(0, 3.5, 0))
                                smartSuccess = true
                            end
                        end
                        -- =============================

                        if not targetCFrame and lastSafeCFrame then
                            targetCFrame = lastSafeCFrame + Vector3.new(0, 4, 0)
                        end

                        if targetCFrame then
                            root.CFrame = targetCFrame
                            
                            root.AssemblyLinearVelocity = Vector3.new(0,0,0)
                            root.AssemblyAngularVelocity = Vector3.new(0,0,0)
                            
                            lastRefY = targetCFrame.Y
                            
                            if smartSuccess then 
                                lastSafeCFrame = targetCFrame 
                                -- J'AI SUPPRIMÉ LA NOTIFICATION ICI
                            end
                        end
                    end
                end
            end
        end)
    end
    return true
end
