        -- Libère TOUT à la destruction du HUD (rebuild / Panic) : connexions, gravité, objets
        ScreenGui.Destroying:Connect(function()
            isFlyOn = false
            isDestroyerOn = false
            stopDestroyerLoop(true)
            stopNoclip()
            if isGravityOn then workspace.Gravity = (Chimera.OriginalValues and Chimera.OriginalValues.Gravity) or 196.2 end
            cleanupFlyMovers()
            for _, data in pairs(ActiveModifiers) do pcall(function() data.Object[data.Property] = data.Original end) end
            table.clear(ActiveModifiers)
            for _, c in ipairs(flyConnections) do pcall(function() c:Disconnect() end) end
            table.clear(flyConnections)
        end)
    end)
end
