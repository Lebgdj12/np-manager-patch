                        pcall(function() if setclipboard and data.Url then setclipboard(data.Url) end end)
                        self:ShowNotification("notif_search_not_script")
                        return
                    end
                    self:ShowNotification("notif_search_script_downloading")
                    local code, isHtml = fetchScriptCode(data.RawUrl)
                    if not code then
                        if isHtml then
                            pcall(function() if setclipboard then setclipboard(data.RawUrl) end end)
                            self:ShowNotification("notif_search_not_script")
                        else
                            self:ShowNotification("notif_search_request_failed")
                        end
                        return
                    end
                    src = code
                end
                runLua(src)
            end)
        end

