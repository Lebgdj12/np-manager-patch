function Chimera:ToggleHeadPet(state)
    self:RevalidateTarget()
    local targetPlayer = self.State.target
    
    -- Désactivation
    if not state then
        self.State.HeadPetActive = false
        if self.SyncToggleUI then self:SyncToggleUI("HeadPet", false) end
        if self.Connections.HeadPetLoop then self.Connections.HeadPetLoop:Disconnect(); self.Connections.HeadPetLoop = nil end
        if self.State.activeHeadPetAnim then self.State.activeHeadPetAnim:Stop(); self.State.activeHeadPetAnim = nil end
        
        local char = game:GetService("Players").LocalPlayer.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                if root:FindFirstChild("milk") then root.milk:Destroy() end
                if root:FindFirstChild("real_milk") then root.real_milk:Destroy() end
            end
            if hum then
                local states = {Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Running, Enum.HumanoidStateType.Jumping} -- Réactivation basique
                for _, s in pairs(states) do hum:SetStateEnabled(s, true) end
            end
        end
        self:ShowNotification("notif_feature_toggled", "Head Pet", "Désactivé")
        return true
    end

    -- Activation
    if not targetPlayer or not targetPlayer.Character then 
        self:ShowNotification("notif_target_not_selected")
        return false 
    end

    self.State.HeadPetActive = true
    if self.SyncToggleUI then self:SyncToggleUI("HeadPet", true) end
    local char = game:GetService("Players").LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if not hum or not root then return false end

    -- 1. Animation
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://121572214"
    self.State.activeHeadPetAnim = hum:LoadAnimation(anim)
    self.State.activeHeadPetAnim:Play()
    self.State.activeHeadPetAnim:AdjustSpeed(0.1)
    self.State.activeHeadPetAnim.TimePosition = 0.6

    -- 2. Désactiver états
    local states = {Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Flying, Enum.HumanoidStateType.Freefall, Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.Landed, Enum.HumanoidStateType.Physics, Enum.HumanoidStateType.PlatformStanding, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Running, Enum.HumanoidStateType.RunningNoPhysics, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.StrafingNoPhysics, Enum.HumanoidStateType.Swimming}
    hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
    for _, s in pairs(states) do hum:SetStateEnabled(s, false) end

    -- 3. BodyMovers
    if root:FindFirstChild("milk") then root.milk:Destroy() end
    if root:FindFirstChild("real_milk") then root.real_milk:Destroy() end
    
    local bg = Instance.new("BodyGyro", root); bg.Name = "milk"; bg.D = 50; bg.P = 200; bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    local bp = Instance.new("BodyPosition", root); bp.Name = "real_milk"; bp.D = 50; bp.P = 200; bp.MaxForce = Vector3.new(9e9, 9e9, 9e9)

    -- 4. Boucle
    self.Connections.HeadPetLoop = game:GetService("RunService").Stepped:Connect(function()
        if not self.State.HeadPetActive then return end
        if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then self:ToggleHeadPet(false); return end
        if not self.State.activeHeadPetAnim.IsPlaying then self.State.activeHeadPetAnim:Play(); self.State.activeHeadPetAnim:AdjustSpeed(0.1); self.State.activeHeadPetAnim.TimePosition = 0.6 end
        
        local tRoot = targetPlayer.Character.HumanoidRootPart
        bp.Position = (tRoot.CFrame * CFrame.new(-3, -4.7, 3.5)).Position
        bg.CFrame = tRoot.CFrame
        
        for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
    end)
    
    self:ShowNotification("notif_feature_toggled", "Head Pet", "Activé sur " .. targetPlayer.Name)
    return true
end
