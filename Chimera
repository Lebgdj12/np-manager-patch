    -- simple tremblement de 1px marquait "moved" et le clic de restauration sur
    -- la pastille etait ignore -> impression que la pastille etait buggée.
    local function EnableDrag(frame, handle, saveKey)
        local dragging, dragStart, startPos, dragDist = false, nil, nil, 0
        -- v4.9.2 : fin de drag unique et idempotente (transparence + sauvegarde position)
        local function EndDrag()
            if not dragging then return end
