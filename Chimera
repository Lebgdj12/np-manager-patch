        local flingConn = UserInputService.InputBegan:Connect(function(i, g) if not g and i.KeyCode == Enum.KeyCode.X then flingActive = not flingActive end end)
        self.State.ObjectControllerTrollLoop = RunService.RenderStepped:Connect(function()
