        local knob = Create.Element("Frame", {Name = "Knob", Parent = switchTrack, Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 3, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Theme.Current.TextSecondary, ZIndex = 2}); Create.Element("UICorner", {Parent = knob, CornerRadius = UDim.new(1, 0)})
        local isOn = defaultState or false
        local trackGradFill = Create.Element("Frame", {Name = "GradFill", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = isOn and 0 or 1, BorderSizePixel = 0, ZIndex = 1, Parent = switchTrack}); Create.Element("UICorner", {Parent = trackGradFill, CornerRadius = UDim.new(1, 0)}); Create.Element("UIGradient", {Color = ColorSequence.new(Theme.Current.GradientA, Theme.Current.GradientB), Rotation = 90, Parent = trackGradFill})
        local function SetState(state)
            isOn = state
            button:SetAttribute("IsOn", state)
            if isOn then
                TweenService:Create(stroke, TweenInfo.new(0.3), {Color = Theme.Current.GradientB, Transparency = 0.2}):Play()
                TweenService:Create(trackGradFill, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
                TweenService:Create(knob, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -3, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = Theme.Current.TextPrimary}):Play()
                TweenService:Create(label, TweenInfo.new(0.3), {TextColor3 = Theme.Current.TextPrimary}):Play()
            else
                TweenService:Create(stroke, TweenInfo.new(0.3), {Color = Theme.Current.Secondary, Transparency = 0.65}):Play()
                TweenService:Create(switchTrack, TweenInfo.new(0.3), {BackgroundColor3 = Theme.Current.Background, BackgroundTransparency = 0.4}):Play()
                TweenService:Create(trackGradFill, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
                TweenService:Create(knob, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 3, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Theme.Current.TextSecondary}):Play()
                TweenService:Create(label, TweenInfo.new(0.3), {TextColor3 = Theme.Current.TextPrimary}):Play()
                TweenService:Create(button, TweenInfo.new(0.3), {BackgroundTransparency = 0.75, BackgroundColor3 = Theme.Current.Secondary}):Play()
            end
            if callback then pcall(callback, isOn) end
        end
        -- FIX BUG : init PUREMENT visuelle. Avant, "SetState(true)" appelait le callback au
        -- chargement de la page, ce qui activait la fonction derrière sans que l'utilisateur clique.
        if isOn then
            switchTrack.BackgroundColor3 = Theme.Current.Background; switchTrack.BackgroundTransparency = 0.4; trackGradFill.BackgroundTransparency = 0
            knob.Position = UDim2.new(1, -3, 0.5, 0); knob.AnchorPoint = Vector2.new(1, 0.5); knob.BackgroundColor3 = Theme.Current.TextPrimary
            label.TextColor3 = Theme.Current.TextPrimary
            stroke.Color = Theme.Current.GradientB; stroke.Transparency = 0.2
            button.BackgroundColor3 = Theme.Current.Secondary; button.BackgroundTransparency = 0.75
        end
        button.Activated:Connect(function() SetState(not isOn) end)
        local controller = {}
        function controller:SetState(newState) SetState(newState) end
        function controller:GetState() return isOn end
        return button, controller
    end

