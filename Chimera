            Parent = track, Size = UDim2.new(1, 0, 2, 0), Position = UDim2.new(0.5, 0, 0.5, 0), 
            AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Text = ""
        })

        -- LOGIQUE
        local dragging = false -- (déplacé ici : UpdateVisuals doit connaître l'état du drag)
        local function UpdateVisuals(val, fromInput)
            -- Valeur réelle (pour le callback)
            local actualValue = val
            
            -- Valeur visuelle (pour la barre, clampée entre 0% et 100%)
            -- Si on dépasse le max via textbox, la barre reste pleine à 100%
            local visualPct = math.clamp((val - min) / (max - min), 0, 1)
            
            -- Animation Ultra Smooth (instantanée pendant le drag : plus de latence)
            TweenService:Create(fill, TweenInfo.new(dragging and 0 or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(visualPct, 0, 1, 0)}):Play()
            TweenService:Create(infKnob, TweenInfo.new(dragging and 0 or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(visualPct, 0, 0.5, 0)}):Play()
            
            -- Mise à jour Texte (seulement si ça ne vient pas de l'input lui-même pour éviter de couper l'écriture)
            if not fromInput then
                -- On arrondit au 10ème pour l'affichage propre
                valueBox.Text = string.format("%.1f", actualValue)
            end
            
            pcall(callback, actualValue)
        end

        -- Interaction Slider (Souris)
        trigger.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                TweenService:Create(infKnobScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.15}):Play()
                local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                -- Le drag reste borné par min/max pour être utilisable
                UpdateVisuals(min + (max - min) * pos, false)
            end
        end)
        
        trigger.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                TweenService:Create(infKnobScale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                UpdateVisuals(min + (max - min) * pos, false)
            end
        end)

        -- Interaction TextBox (Illimitée)
        -- v4.9.4 : applique sur Entrée ET au clic ailleurs (plus besoin d'appuyer sur Entrée).
        -- Virgule acceptée comme séparateur décimal.
        valueBox.FocusLost:Connect(function()
            local n = tonumber((valueBox.Text:gsub(",", ".")))
            if n then 
                -- On envoie la valeur brute, SANS CLAMP
                UpdateVisuals(n, false) 
            else 
                valueBox.Text = tostring(default) 
            end
        end)

        -- Init
        UpdateVisuals(default, false)

        return {SetValue = function(self, v) UpdateVisuals(v, false) end}
    end

