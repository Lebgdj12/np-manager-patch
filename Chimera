-- ═══════════════════ COPIE DE LA MAP (VUE DU DESSUS) ═══════════════════

local function shouldKeepPart(part)
        if part == Workspace.Terrain then
                return false
        end
        if not part.Anchored then
                return false
        end
        if part.Transparency >= 0.95 then
                return false
        end
        local s = part.Size
        if s.X * s.Y * s.Z < CONFIG.MIN_PART_VOLUME then
                return false
        end
        -- ignore les dossiers d'effets (FX, particules, camera...)
        local ancestor = part.Parent
        while ancestor and ancestor ~= Workspace do
                if IGNORED_CONTAINER_NAMES[ancestor.Name] then
                        return false
                end
                ancestor = ancestor.Parent
        end
        return true
end

-- supprime scripts/sons/lights/etc des clones (rien ne tourne dans un viewport, gain de memoire)
local function stripClone(clone)
        local trash = {}
        for _, desc in ipairs(clone:GetDescendants()) do
                if STRIP_CLASS_NAMES[desc.ClassName] then
                        table.insert(trash, desc)
                end
        end
        for _, obj in ipairs(trash) do
                obj:Destroy()
        end
end

-- ═══ LOD AUTO : n'affiche que ce qui est assez gros pour l'ecran ═══
-- Les clones sont ranges par paliers de taille (dossiers LOD_0 a LOD_9).
-- Un palier dont les objets feraient moins de LOD_MIN_PX pixels a l'ecran
-- est mis en veille (Parent = nil) : zoomé tu ne vois que ce que tu zoomes,
-- dezoomé la vue est epuree et beaucoup plus legere a rendre.

local function bucketForSide(side)
        local b = math.floor(math.log(math.max(side, 0.1)) / math.log(2))
        if b < 0 then
                b = 0
        elseif b > 9 then
                b = 9
        end
        return b
end

local function ensureLodFolders()
        for _, f in pairs(lodFolders) do
                f:Destroy()
        end
        lodFolders = {}
        for b = 0, 9 do
                local folder = Instance.new("Folder")
                folder.Name = "LOD_" .. b
                folder.Parent = worldModel
                lodFolders[b] = folder
        end
end

local function updateLOD(studsPerPx)
        local hideBelow = CONFIG.LOD_MIN_PX * studsPerPx
        for b = 0, 9 do
                local folder = lodFolders[b]
                if folder then
                        -- palier b = objets de 2^b a 2^(b+1) studs de cote
                        local keep = (2 ^ (b + 1)) >= hideBelow
                        local target = keep and worldModel or nil
                        if folder.Parent ~= target then
                                folder.Parent = target
                        end
                end
        end
end

-- prepare un clone (nettoyage + palier de taille) et le tracke pour le refresh
local function finishClone(clone, source)
        stripClone(clone)
        clone.Anchored = true
        clone.CanCollide = false
        clone.CanQuery = false
        clone.CanTouch = false
        clone.CastShadow = false
        clone:SetAttribute(XRAY_ATTR, clone.Transparency)
        local s = clone.Size
        clone.Parent = lodFolders[bucketForSide(math.sqrt(s.X * s.Z))]
        if source then
                trackedClones[source] = clone
        end
        -- index du mode toits (liste triee par altitude)
        local entry = { part = clone, bottom = clone.Position.Y - s.Y * 0.5 }
        if isBuilding then
                table.insert(xraySorted, entry) -- tri global a la fin du build
        else
                xrayInsert(entry)
                if xrayEnabled then
                        xrayDirty = true
                end
        end
end

local function buildTerrainSnapshot()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if not terrain then return end
        local isEmpty = false
        pcall(function()
                isEmpty = terrain.IsEmpty
        end)
        if isEmpty then return end

        local half = math.min(CONFIG.TERRAIN_HALF, 16000)
        local minCorner = Vector3int16.new(-half, CONFIG.TERRAIN_MIN_Y, -half)
        local maxCorner = Vector3int16.new(half, CONFIG.TERRAIN_MAX_Y, half)
        local region = terrain:CopyRegion(minCorner, maxCorner)

        local terrainCopy = Instance.new("Terrain")
        terrainCopy:PasteRegion(region, minCorner, true)
        terrainCopy.Parent = worldModel
end

local function buildSnapshot()
        if isBuilding then return end
        isBuilding = true
        snapshotReady = false
        trackedClones = {}
        pendingAdd = {}
        pendingRemove = {}
        loadingLabel.Visible = true
        loadingLabel.Text = "Chargement de la carte…"
        task.wait()

        -- vide l'eventuelle ancienne carte (touche J)
        worldModel:ClearAllChildren()
        ensureLodFolders()
        xraySorted = {} -- la nouvelle carte est reconstruite : index a zero
        xrayLastIdx = 1
        xrayLastCut = nil
        xrayLastTarget = nil

        -- 1) on collecte tous les objets ancres de la map
        local entries = {}
        for _, inst in ipairs(Workspace:GetDescendants()) do
                if inst:IsA("BasePart") and shouldKeepPart(inst) then
                        local s = inst.Size
                        table.insert(entries, { part = inst, vol = s.X * s.Y * s.Z })
                end
        end
        for _, source in ipairs(CONFIG.EXTRA_SOURCES) do
                if typeof(source) == "Instance" then
                        for _, inst in ipairs(source:GetDescendants()) do
                                if inst:IsA("BasePart") and shouldKeepPart(inst) then
                                        local s = inst.Size
                                        table.insert(entries, { part = inst, vol = s.X * s.Y * s.Z })
                                end
                        end
                end
        end

        -- 2) trop d'objets ? on garde en priorite les plus gros (batiments, routes...)
        table.sort(entries, function(a, b)
                return a.vol > b.vol
        end)
        local total = math.min(#entries, CONFIG.MAX_PARTS)

        -- 3) clonage par petits lots pour ne pas freeze le jeu
        local done = 0
        for i = 1, total do
                local ok, clone = pcall(function()
                        return entries[i].part:Clone()
                end)
                if ok and clone then
                        finishClone(clone, entries[i].part)
                end
                done = done + 1
                if done % 150 == 0 then
                        loadingLabel.Text = string.format("Chargement de la carte… %d%%", math.floor(done / total * 100))
                        task.wait()
                end
        end

        -- 4) terrain (eau, relief...)
        if CONFIG.USE_TERRAIN then
                loadingLabel.Text = "Chargement du terrain…"
                task.wait()
                pcall(buildTerrainSnapshot)
        end

        -- 5) l'etat "toits" est reapplique d'un coup sur la nouvelle carte
        table.sort(xraySorted, function(a, b)
                return a.bottom < b.bottom
        end)
        xrayLastTarget = nil
        if xrayEnabled then
                local cut = currentCutY()
                if cut then
                        xrayLastCut = cut
                        local first = xrayLowerBound(cut)
                        local hidden = 0
                        for i = first, #xraySorted do
                                xraySorted[i].part.Transparency = 1
                                hidden = hidden + 1
                                if hidden % 800 == 0 then
                                        task.wait()
                                end
                        end
                        xrayLastIdx = first
                else
                        xrayLastCut = nil
                        xrayLastIdx = #xraySorted + 1
                end
        else
                xrayLastCut = nil
                xrayLastIdx = #xraySorted + 1
        end
        xrayDirty = false

        loadingLabel.Visible = false
        isBuilding = false
        snapshotReady = true
end

-- premier chargement (petit delai pour laisser la map se repliquer chez le joueur)
task.spawn(function()
        task.wait(CONFIG.INITIAL_DELAY)
        buildSnapshot()
end)

-- ═══ REFRESH AUTO TOUTES LES 5 SECONDES (optimisé) ═══
-- Plutot que de reconstruire toute la carte, on ecoute les objets qui
-- apparaissent / disparaissent (cout zero quand rien ne change) et on
-- applique le "differ" au prochain refresh, par petits lots. Marche aussi
-- avec StreamingEnabled : ce qui stream out est retire, ce qui revient
-- est rajoute, automatiquement.

Workspace.DescendantAdded:Connect(function(inst)
        if snapshotReady and inst:IsA("BasePart") and shouldKeepPart(inst) then
                pendingAdd[inst] = true
        end
end)

Workspace.DescendantRemoving:Connect(function(inst)
        if snapshotReady and trackedClones[inst] then
                pendingRemove[inst] = true
                pendingAdd[inst] = nil
        end
end)

local function applyDiff()
        -- 1) retirer les objets supprimes du jeu
        for source in pairs(pendingRemove) do
                pendingRemove[source] = nil
                local clone = trackedClones[source]
                if clone then
                        xrayRemove(clone)
                        clone:Destroy()
                        trackedClones[source] = nil
                end
        end
        -- 2) ajouter les nouveaux objets (budget par refresh pour rester fluide)
        local added = 0
        for source in pairs(pendingAdd) do
                pendingAdd[source] = nil
                local old = trackedClones[source]
                if old and old.Parent == nil then
                        -- FIX v2.4 : clone mort (suppression passee a la trappe
                        -- par l'event) → on nettoie l'index toits avant de
                        -- re-cloner, sinon l'objet restait absent de la carte
                        xrayRemove(old)
                        trackedClones[source] = nil
                        old = nil
                end
                if old == nil and source.Parent then
                        local ok, clone = pcall(source.Clone, source)
                        if ok and clone then
                                finishClone(clone, source)
                        end
                        added = added + 1
                        if added % 100 == 0 then
                                task.wait()
                        end
                        if added >= CONFIG.AUTO_REFRESH_MAX_ADD then
                                break -- le reste attendra le prochain refresh
                        end
                end
        end
end

task.spawn(function()
        while true do
                task.wait(CONFIG.AUTO_REFRESH_INTERVAL)
                if CONFIG.AUTO_REFRESH and snapshotReady and not isBuilding then
                        applyDiff()
                end
        end
end)

