        ZIndex = 5
    })
    button:SetAttribute("ThemeType", "SecondaryGlass")
    Create.Element("UICorner", { CornerRadius = UDim.new(1, 0), Parent = button })


    -- 3. FINITIONS VISUELLES
    -- Verre : fondu de TRANSPARENCE (pas de teinte) — la couleur reste EXACTEMENT
    -- Secondary (mappable par le sweep), la profondeur vient d'un dégradé d'opacité :
    -- plus solide en haut (accroche la lumière), plus aérien en bas.
    Create.Element("UIGradient", {
        Color = ColorSequence.new(Color3.new(1, 1, 1)),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.06),
            NumberSequenceKeypoint.new(1, 0.5)
        }),
        Rotation = 90,
        Parent = button
    })

    -- v4.9.16 : reflet de verre — hairline blanche en haut (lumière accrochée au repos).
    -- Blanc pur = invariant de thème (jamais remappé par le sweep).
    Create.Element("Frame", {
        Name = "GlareLine",
        Size = UDim2.new(0.4, 0, 0, 1),
        Position = UDim2.new(0.3, 0, 0, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = button
    })
    -- Bordure principale (Stroke)
    local stroke = Create.Element("UIStroke", {
        Name = "ButtonStroke",
        Color = Color3.new(1, 1, 1),
        Thickness = 1.4,
        Transparency = 0.7,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = button
    })

    -- v4.9.14 : voile de survol BLANC (invariant de thème : jamais remappé par le sweep)
    -- + échelle pressable. Le rendu reste "glass", la profondeur vient du mouvement.
    local wash = Create.Element("Frame", {
        Name = "HoverWash",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 6,
        Parent = button
    })
    Create.Element("UICorner", { CornerRadius = UDim.new(1, 0), Parent = wash })
    local scaler = Create.Element("UIScale", { Parent = button })
    -- Texte (Name par défaut conservé : le header cherche "Text" de temps en temps, on ne touche pas)
    local content = Create.Element("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = text:upper(),
        Font = Enum.Font.GothamBold,
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 14,
        ZIndex = 7,
        Parent = button
    })
    -- (v4.9.15 : texte blanc invariant — plus d'attribut TextSecondary qui le re-griserait au changement de thème)

    -- ==========================================
    -- LOGIQUE D'INTERACTION (v4.9.14 "Aurora") : voile de survol + lift + onde de clic.
    -- Le fond du bouton n'est PLUS jamais tweené : les surcharges de couleur des appelants
    -- (ex : bouton Clear en rouge) restent intactes, et le texte retrouve EXACTEMENT
    -- sa teinte capturée à l'entrée (marche aussi après un changement de thème à chaud).
    -- ==========================================
    local hovered = false
    local enterText = nil

    button.MouseEnter:Connect(function()
        hovered = true
        enterText = content.TextColor3
        TweenService:Create(wash, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0.88}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.38}):Play()
        TweenService:Create(content, TweenInfo.new(0.2), {TextColor3 = Color3.new(1, 1, 1)}):Play()
        TweenService:Create(scaler, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1.03}):Play()
    end)

    button.MouseLeave:Connect(function()
        hovered = false
        TweenService:Create(wash, TweenInfo.new(0.25), {BackgroundTransparency = 1}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 0.7}):Play()
        TweenService:Create(content, TweenInfo.new(0.25), {TextColor3 = enterText or Theme.Current.TextSecondary}):Play()
        TweenService:Create(scaler, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
    end)

    -- Pression : onde depuis le point cliqué + micro-écrasement UIScale (le layout ne bouge jamais)
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Create.Ripple(button, input.Position)
            TweenService:Create(scaler, TweenInfo.new(0.09, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 0.955}):Play()
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(scaler, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = hovered and 1.03 or 1}):Play()
        end
    end)

    -- Si un callback est passé, on le connecte
    if callback then
        button.Activated:Connect(callback) -- Activated : fiable souris + tactile, pas d'activation parasite au drag
    end

    return button -- ON RETOURNE LE BOUTON DIRECTEMENT
end
