    -- Convertit les liens de pages publiques en URL "brute" telechargeable
    -- v4.9.7 : IDEMPOTENT — si l'URL est DEJA une URL brute elle est renvoyee telle
    -- quelle. Avant, fetchScriptCode(data.RawUrl) re-passait l'URL brute dans la
    -- moulinette et la regle pastebin recapturait "raw" comme ID de paste :
    --   pastebin.com/raw/ULhYN7jU -> pastebin.com/raw/raw (404) -> execution ratee.
    -- C'est pour ca que "Executer" sur un resultat pastebin du Web ne faisait rien.
    -- (Verifie live : pastebin.com/raw/<ID> = 200 text/plain = le code Lua ;
    --  pastebin.com/<ID>/raw = 404 — la forme canonique est bien /raw/<ID>.)
    local function resolveRawUrl(u)
        u = tostring(u)
        local a, b
        -- rscripts d'abord : normalisation .txt de ses propres URLs brutes
        a = u:match("^https?://rscripts%.net/script/([^/]+)/?$")
        if a then
            if a:sub(-4) ~= ".txt" then a = a .. ".txt" end
            return "https://rscripts.net/raw/" .. a
        end
        a = u:match("^https?://rscripts%.net/raw/([^/]+)/?$")
        if a and a:sub(-4) ~= ".txt" then return "https://rscripts.net/raw/" .. a .. ".txt" end
        -- garde "deja brut" : aucune re-conversion (sinon /raw/raw)
        if u:find("pastebin%.com/raw/%w") or u:find("hastebin%.com/raw/%w")
            or u:find("raw%.githubusercontent%.com/") or u:find("gist%.githubusercontent%.com/")
            or u:find("rentry%.co/%w+/raw") or u:find("rawscripts%.net/raw/")
            or u:find("cdn%.jsdelivr%.net/gh/") or u:find("codeberg%.org/.-/raw/")
            or u:find("gitlab%.com/.-/raw/") then
            return u
        end
        -- pages publiques -> URL brute (pastebin.com/<ID> et pastebin.com/<ID>/raw
        -- sont tous deux convertis vers la forme canonique /raw/<ID>)
        a = u:match("^https?://pastebin%.com/(%w+)")
        if a then return "https://pastebin.com/raw/" .. a end
        a, b = u:match("^https?://github%.com/([^/]+/[^/]+)/blob/(.+)$")
        if a then return "https://raw.githubusercontent.com/" .. a .. "/" .. b end
        a = u:match("^https?://gist%.github%.com/([^/]+/%w+)")
        if a then return "https://gist.githubusercontent.com/" .. a .. "/raw" end
        a, b = u:match("^https?://gitlab%.com/(.-)/%-/blob/(.+)$")
        if a then return "https://gitlab.com/" .. a .. "/-/raw/" .. b end
        a = u:match("^https?://rentry%.co/(%w+)")
        if a then return "https://rentry.co/" .. a .. "/raw" end
        a = u:match("^https?://hastebin%.com/(%w+)")
        if a then return "https://hastebin.com/raw/" .. a end
        return u
    end

    -- v4.9.6 : résolution rscripts via l'API officielle (200, zéro anti-bot, UA
    -- Roblox OK, testé live). Les pages /script/<slug> indexées par les moteurs
    -- utilisent des slugs COURTS (ex "rael-hub-brookhaven-no-key-P3c0") alors que
    -- le vrai fichier est /raw/<slug>_<date>_<ID>.txt (slug canonique) -> on cherche
    -- les mots du slug dans l'API v2 et on télécharge son rawScript. Retourne code|nil.
    local function resolveRscriptsViaApi(pageUrl)
        local slug = tostring(pageUrl or ""):match("rscripts%.net/script/([^/]+)")
                  or tostring(pageUrl or ""):match("rscripts%.net/raw/([^/]+)")
        if not slug then return nil end
        slug = slug:gsub("%.txt$", ""):gsub("%-+", " ")
        local words = {}
        for w in slug:gmatch("%S+") do table.insert(words, w) end
        -- les tokens d'ID en fin de slug (P3c0, _1788947961637_Hs2JBZRuVa) polluent
        -- la recherche API -> on les retire (tous contiennent un chiffre)
        while #words > 1 and words[#words]:find("%d") do table.remove(words) end
        while #words > 5 do table.remove(words) end
        if #words == 0 then return nil end
        -- requête PROGRESSIVE : l'API v2 renvoie 0 script si un seul mot ne colle
        -- pas (ex "keyless sigmasaken HTAb" -> 0, mais "keyless sigmasaken" -> OK).
        -- On réessaie en retirant le dernier mot, 4 tentatives max.
        local best, bestScore
        local attempts = 0
        local n = #words
        while n >= 1 and attempts < 4 and not best do
            attempts = attempts + 1
            local qParts = {}
            for i = 1, n do qParts[i] = words[i] end
            local okF, body = pcall(function()
                return game:HttpGet("https://rscripts.net/api/v2/scripts?q=" .. HttpService:UrlEncode(table.concat(qParts, " ")), true)
            end)
            if okF and type(body) == "string" and #body >= 10 then
                local okJ, data = pcall(function() return HttpService:JSONDecode(body) end)
                if okJ and type(data) == "table" and type(data.scripts) == "table" then
                    -- meilleur match par nombre de mots du slug présents dans le
                    -- titre (>= 2 requis : évite d'exécuter un script sans rapport)
                    for _, s in ipairs(data.scripts) do
                        if type(s) == "table" and type(s.rawScript) == "string" and s.rawScript:sub(1, 8) == "https://" then
                            local t = tostring(s.title or ""):lower()
                            local score = 0
                            for _, w in ipairs(qParts) do
                                if #w >= 3 and t:find(w, 1, true) then score = score + 1 end
                            end
                            if score >= 2 and (not best or score > bestScore) then best, bestScore = s.rawScript, score end
                        end
                    end
                end
            end
            n = n - 1
        end
        if not best then return nil end
        if best:sub(-4) ~= ".txt" then best = best .. ".txt" end
        local okD, code = pcall(function() return game:HttpGet(best, true) end)
        if okD and type(code) == "string" and #code >= 10 then return code end
        return nil
    end

