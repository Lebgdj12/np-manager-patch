function Chimera:Panic()
    self:ShowNotification("notif_panic_activated")
    -- 1. Le HUD VFly d'abord : il garde ses propres états locaux (vol/destroyer/noclip/gravité)
    --    (FIX : avant, Panic détruisait seulement le GUI principal et laissait un HUD orphelin voler)
    if self.UI.VFlyScreenGui then pcall(function() self.UI.VFlyScreenGui:Destroy() end) end
    if self.VFlySetEnabled then pcall(self.VFlySetEnabled, false) end
    -- 2. Toutes les features à état
    if self.State.isFlying then self:ToggleFly(false) end
    if self.State.isNoclip then self:ToggleNoclip(false) end
    if self.State.infiniteJumpEnabled then self:ToggleInfiniteJump(false) end
    if self.State.orbitEnabled then self:ToggleOrbit(false) end
    if self.State.carToggleActivated then self:ToggleCarMode(false) end
    if self.State.killBrickEnabled then self:ToggleKillbrick(false) end
    if self.State.invis_on then self:ToggleInvisible(false) end
    if self.State.ShiftLockActive then self:ToggleShiftLock(false) end
    if self.State.rotating then self:ToggleRotate(false) end
    if self.State.aimbotEnabled then self:ToggleAimbot(false) end
    if self.State.isSpectating then self:ToggleSpectate(false) end
    if self.State.spamTpActive then self:ToggleSpamTp(false) end
    if self.State.trackPlayerActive then self:ToggleTrackPlayer(false) end
    if self.State.teleportAllActive then self:ToggleTeleportAll(false) end
    if self.State.antifallEnabled and self.ToggleAntiFall then pcall(self.ToggleAntiFall, self, false) end
    if self.State.headPetActive and self.ToggleHeadPet then pcall(self.ToggleHeadPet, self, false) end
    if not self.State.lift_scriptDisabled then self:StopPlayerLift() end
    if self.State.bringing then self.State.bringing = false end
    if self.State.freecamActive and self.ToggleFreecam then pcall(self.ToggleFreecam, self, false) end
    if self.UI.AimbotScreenGui then pcall(function() self.UI.AimbotScreenGui:Destroy() end) end
    -- 3. Nettoyage de TOUS les binds aimbot (les 3 générations de moteur de lock)
    pcall(function() RunService:UnbindFromRenderStep("ChimeraHardLock") end)
    pcall(function() RunService:UnbindFromRenderStep("ChimeraHardLockPriority") end)
    pcall(function() RunService:UnbindFromRenderStep("ChimeraCamLockV2") end)
    pcall(function() RunService:UnbindFromRenderStep("ChimeraTeamLock") end)
    -- 4. La chaise invisible orpheline
    local oldChair = Workspace:FindFirstChild("invischair_" .. LocalPlayer.UserId)
    if oldChair then oldChair:Destroy() end
    task.wait(0.5)
    if self.ScreenGui and self.ScreenGui.Parent then self.ScreenGui:Destroy() end
end
function Chimera:CreateLaserGun()
    if self.State.laserGunCreated then self:ShowNotification(T("notif_lasergun_already_created")); return end

    local function sandbox(var, func)
        local env = getfenv(func)
        local new_env = setmetatable({}, {
            __index = function(self, k)
                if k == "script" then return var else return env[k] end
            end
        })
        setfenv(func, new_env)
        return func
    end
    
    local Tool = Create.Element("Tool", { Name = "HyperlaserGun", TextureId = "http://www.roblox.com/asset/?id=130093050", GripPos = Vector3.new(0, -0.1, 0.75), CanBeDropped = false })
    local Handle = Create.Element("Part", { Name = "Handle", Parent = Tool, Size = Vector3.new(0.58, 1.34, 2.48), Position = Vector3.new(0.04, 0, 0.07), BottomSurface = Enum.SurfaceType.Smooth, TopSurface = Enum.SurfaceType.Smooth, BrickColor = BrickColor.new("Medium stone grey") })
    Create.Element("SpecialMesh", { Parent = Handle, MeshId = "http://www.roblox.com/asset/?id=130099641", Scale = Vector3.new(0.65, 0.65, 0.65), TextureId = "http://www.roblox.com/asset/?id=130093033" })
    Create.Element("Sound", { Name = "Fire", Parent = Handle, SoundId = "http://www.roblox.com/asset?id=130113322" })
    Create.Element("PointLight", { Parent = Handle, Color = Color3.new(0, 1, 1), Range = 6 })

    local laserScript = Create.Element("Script", { Parent = Tool })

    local sandboxedFunction = sandbox(laserScript, function()
        local Tool = script.Parent
        local Handle = Tool:WaitForChild("Handle")
        local Debris = game:GetService("Debris")
        
        Tool.Equipped:Connect(function(Mouse)
            Mouse.Button1Down:Connect(function()
                if Mouse.Target then
                    local targetPart = Mouse.Target
                    local laser = Instance.new("Part")
                    laser.Anchored = true
                    laser.CanCollide = false
                    laser.Material = Enum.Material.Neon
                    laser.BrickColor = BrickColor.new("Bright red")
                    laser.Size = Vector3.new(0.2, 0.2, (Handle.Position - Mouse.Hit.p).magnitude)
                    laser.CFrame = CFrame.new(Handle.Position, Mouse.Hit.p) * CFrame.new(0, 0, -laser.Size.Z / 2)
                    laser.Parent = workspace
                    Debris:AddItem(laser, 0.1)
                    
                    if Handle:FindFirstChild("Fire") then Handle.Fire:Play() end
                    
                    if targetPart:IsA("BasePart") then
                        task.spawn(function()
                            for transparency = 0, 1, 0.05 do
                                if not targetPart or not targetPart.Parent then break end
                                targetPart.Transparency = transparency
                                task.wait(0.05)
                            end
                            if targetPart and targetPart.Parent then targetPart:Destroy() end
                        end)
                    end
                end
            end)
        end)
    end)
    
    spawn(sandboxedFunction)
    
    Tool.Parent = LocalPlayer:FindFirstChild("Backpack")
    pcall(function() if Tool.Parent then Tool:MakeJoints() end end)
    
    self.State.laserGunCreated = true
    self:ShowNotification(T("notif_lasergun_created"))
end

