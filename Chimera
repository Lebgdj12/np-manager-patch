        AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false
    })
    Create.Element("UIListLayout", {Parent = markdownContainer, Padding = UDim.new(0, 8)})

    -- BOUTON REVERT (2 <-> 3)
    local revertBtn = Create.Element("ImageButton", {
        Parent = headerLine, Size = UDim2.new(0, 18, 0, 18), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        BackgroundTransparency = 1, Image = "rbxassetid://138133190015277", ImageColor3 = Theme.Current.TextSecondary, Visible = false, ZIndex = 20
    })
    
    revertBtn.Activated:Connect(function()
        if not textStep3 then return end -- Si pas de traduction, le bouton ne fait rien
        
        isShowingStep3 = not isShowingStep3
        
        -- LOGIQUE CIBLÉE : On alterne entre (2) Décodé et (3) Traduit
        -- L'original (1) est oublié ici.
        if isShowingStep3 then
            msgLabel.Text = textStep3
            msgLabel.TextColor3 = Theme.Current.Accent
            revertBtn.ImageColor3 = Theme.Current.Accent
        else
            msgLabel.Text = textStep2
            msgLabel.TextColor3 = Theme.Current.TextPrimary -- Blanc/Gris clair pour le décodé
            revertBtn.ImageColor3 = Theme.Current.TextSecondary
        end

        if Chimera.State.ChatAutoScroll then targetFrame.CanvasPosition = Vector2.new(0, 999999) end
    end)

    -- 2. PIPELINE DE TRAITEMENT
    task.spawn(function()
    
    -- [[ DÉTECTION ET DÉCOUPAGE MARKDOWN ]]
        if channelOverride == "ai" and (message:find("```") or message:find("#")) then
            msgLabel.Visible = false 
            sequentialContainer.Visible = true
            local lastPos = 1
            -- On parcourt le message pour trouver les blocs de code
            for startIdx, lang, code, endIdx in message:gmatch("()```([%w%d]*)%s*\n?(.-)```()") do
                -- A. On traite tout ce qu'il y a AVANT le code
                local textBefore = message:sub(lastPos, startIdx - 1)
                for line in textBefore:gmatch("[^\n]+") do
                    local h, cont = line:match("^(#+)%s*(.*)")
                    addAnimatedText(sequentialContainer, h and cont or line, h ~= nil, h and #h or 0)
                end
                -- B. On insère le bloc de code (entre les deux textes)
                addCodeBlock(sequentialContainer, code, lang)
                lastPos = endIdx
            end
            -- C. On traite tout ce qu'il y a APRES le dernier bloc de code
            local textAfter = message:sub(lastPos)
            for line in textAfter:gmatch("[^\n]+") do
                local h, cont = line:match("^(#+)%s*(.*)")
                addAnimatedText(sequentialContainer, h and cont or line, h ~= nil, h and #h or 0)
            end
            return -- On arrête là pour l'IA, le reste du code original est préservé mais ignoré pour ce message
        end
        -- A. Animation d'écriture (Affiche le texte brut temporairement)
        local len = utf8.len(textStep1); local step = 4
        for i = 1, len, step do
            -- On n'anime que si on n'a pas encore fini le traitement
            if not isShowingStep3 and textStep2 == textStep1 then
                msgLabel.Text = string.sub(textStep1, 1, math.min(i, #textStep1))
                if Chimera.State.ChatAutoScroll and targetFrame.Visible then targetFrame.CanvasPosition = Vector2.new(0, targetFrame.AbsoluteCanvasSize.Y) end
            end
            RunService.Heartbeat:Wait()
        end
        -- Fin anim : on affiche le brut en attendant le traitement
        if textStep2 == textStep1 then msgLabel.Text = textStep1 end

        -- === B. TRAITEMENT ===
        local processingText = textStep1
        local decodeTag = ""
        local hasDecoded = false
        
        -- ÉTAPE 1 -> 2 : DÉCODAGE
        local decoded, method = SmartDecodeText(processingText)
        if decoded then
            processingText = decoded
            decodeTag = " <font color='#00FF00'>"..method.."</font>"
            hasDecoded = true
        end
        
        -- On sauvegarde l'état 2 (Texte propre + tag de décodage éventuel)
        textStep2 = processingText .. decodeTag

        -- Si on a décodé, on l'affiche tout de suite (remplace le brut)
        if hasDecoded then
            msgLabel.Text = textStep2
            msgLabel.TextColor3 = Theme.Current.TextPrimary
        end

        -- ÉTAPE 2 -> 3 : TRADUCTION
        if Chimera.State.ChatTranslate and channelOverride ~= "exploit" and playerName ~= Players.LocalPlayer.DisplayName then
            local trans = TranslateEngine:Translate(processingText, Chimera.State.ChatTranslateLang)
            
            -- Si la traduction est différente du texte (donc utile)
            if trans and trans:lower() ~= processingText:lower() then
                -- On construit l'état 3 (Texte traduit + Tag décodage + Tag Traduction)
                textStep3 = trans .. decodeTag .. " <font color='#FFA500'>[TR]</font>"
                
                -- On bascule automatiquement sur l'état 3
                isShowingStep3 = true
                msgLabel.Text = textStep3
                msgLabel.TextColor3 = Theme.Current.Accent
                
                -- On active le bouton pour revenir à l'état 2
                revertBtn.Visible = true
                revertBtn.ImageColor3 = Theme.Current.Accent
            end
        end
        
        if Chimera.State.ChatAutoScroll and targetFrame.Visible then targetFrame.CanvasPosition = Vector2.new(0, targetFrame.AbsoluteCanvasSize.Y) end
    end)

    local clickArea = Create.Element("TextButton", {Parent = msgRow, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 5})
    clickArea.MouseEnter:Connect(function() TweenService:Create(hoverBg, TweenInfo.new(0.2), {BackgroundTransparency = 0.95}):Play() end)
    clickArea.MouseLeave:Connect(function() TweenService:Create(hoverBg, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play() end)
    clickArea.Activated:Connect(function() 
        if setclipboard then 
            -- Copie intelligente (sans balises)
            local txtToCopy = isShowingStep3 and textStep3 or textStep2
            setclipboard(txtToCopy:gsub("<[^>]+>", "")) 
        end
        Chimera:ShowNotification("notif_copied_to_clipboard") 
    end)
    
    Create.Element("UIPadding", {Parent = msgRow, PaddingBottom = UDim.new(0, 10)})
    if Chimera.State.ChatAutoScroll and targetFrame.Visible then task.defer(function() targetFrame.CanvasPosition = Vector2.new(0, targetFrame.AbsoluteCanvasSize.Y) end) end
    return msgRow
end
function Chimera:InitChatSpyListener()
    local function onChatted(player, message)
        if player == game.Players.LocalPlayer then return end
        self:AddChatMessage(player.DisplayName, message, "global")
    end
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do p.Chatted:Connect(function(m) onChatted(p, m) end) end
    game:GetService("Players").PlayerAdded:Connect(function(p) p.Chatted:Connect(function(m) onChatted(p, m) end) end)

    local LogService = game:GetService("LogService")
    LogService.MessageOut:Connect(function(message, messageType)
        local startPos = message:find("active://")
        if not startPos then return end
        local textStart = startPos + #"active://"
        
        local extractedText = message:sub(textStart)
        extractedText = extractedText:gsub("^[\n\r\t\s]+", "") -- Trim Start
        local stackPositions = {extractedText:find("\n%s*Stack Begin"), extractedText:find("\n%s*Script '"), extractedText:find("\n%s*Stack End"), extractedText:find("\n%s*%.%.%.")}
        local cutPosition = nil
        for _, pos in ipairs(stackPositions) do if pos and (not cutPosition or pos < cutPosition) then cutPosition = pos end end
        if cutPosition then extractedText = extractedText:sub(1, cutPosition - 1) end
        
        extractedText = extractedText:gsub("[\n\r\t\s]+$", ""):gsub("[,%.]+$", "")
        
        -- NETTOYAGE DES GUILLEMETS ' (Si présents aux extrémités)
        if extractedText:sub(1,1) == "'" and extractedText:sub(-1,-1) == "'" then
            extractedText = extractedText:sub(2, -2)
        end

        if extractedText and #extractedText >= 2 and not extractedText:match("^Line %d+") then
            local decodedText = extractedText
            if #extractedText > 20 then pcall(function() local d = base64decode(extractedText); if d and #d > 0 then decodedText = d end end) end
            
            if ExploitChatCache.LastMessageTime[decodedText] and (os.time() - ExploitChatCache.LastMessageTime[decodedText] < 1) then return end
            ExploitChatCache.LastMessageTime[decodedText] = os.time()
            
            local name, msg = decodedText:match("^([^:]+):%s*(.*)")
            if name and msg then self:AddChatMessage(name, msg, "exploit")
            else self:AddChatMessage("System", decodedText, "exploit") end
        end
    end)
end
