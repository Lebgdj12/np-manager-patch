-- pseudos : SUPPRIMES de l'UI. En v2.2 ils sont dessines EN 3D dans le
-- monde des blips (lettres Neon) et colles par updateNames3D, dans la meme
-- frame que la camera → zero decalage possible, meme en rotation rapide.

local function updateNorth(topCFrame, vsize)
        -- direction du nord (0,0,-1) vue par la camera du dessus
        local rel = topCFrame:Vector3ToObjectSpace(Vector3.new(0, 0, -1))
        local rad = math.atan2(rel.X, rel.Y)
        local radius = math.min(vsize.X, vsize.Y) * 0.5 - 12
        -- OPTI v2.4 : n'ecrit la position QUE si l'angle ou le rayon changent
        -- vraiment (camera immobile = zero allocation UDim2 par frame)
        if lastNorthAngle and lastNorthRadius
                and math.abs(rad - lastNorthAngle) < 0.002
                and math.abs(radius - lastNorthRadius) < 0.5 then
                return
        end
        lastNorthAngle = rad
        lastNorthRadius = radius
        northLabel.Position = UDim2.fromOffset(
                vsize.X * 0.5 + math.sin(rad) * radius,
                vsize.Y * 0.5 - math.cos(rad) * radius
        )
end

local function updateHealthBar(dt)
        if not healthBarBg then return end
        -- OPTI v2.4 : maj throttle (toutes les 0.12s) + n'ecrit QUE si la
        -- valeur change vraiment (la vie ne bouge pas a chaque frame)
        healthTimer = healthTimer + dt
        if healthTimer < 0.12 then return end
        healthTimer = 0
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.MaxHealth > 0 then
                if not healthBarBg.Visible then
                        healthBarBg.Visible = true
                end
                local ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                if lastHealthRatio == nil
                        or math.abs(ratio - lastHealthRatio) > 0.003 then
                        healthFill.Size = UDim2.fromScale(ratio, 1)
                        lastHealthRatio = ratio
                        -- vert -> orange -> rouge selon la vie
                        local bucket = 0
                        if ratio > 0.5 then
                                bucket = 2
                        elseif ratio > 0.25 then
                                bucket = 1
                        end
                        if bucket ~= lastHealthBucket then
                                lastHealthBucket = bucket
                                if bucket == 2 then
                                        healthFill.BackgroundColor3 = Color3.fromRGB(97, 204, 92)
                                elseif bucket == 1 then
                                        healthFill.BackgroundColor3 = Color3.fromRGB(228, 178, 72)
                                else
                                        healthFill.BackgroundColor3 = Color3.fromRGB(214, 82, 72)
                                end
                        end
                end
        else
                if healthBarBg.Visible then
                        healthBarBg.Visible = false
                end
                lastHealthRatio = nil
                lastHealthBucket = nil
        end
end

-- ajuste la taille de la minimap en pixels reels de l'ecran
-- (pas de UIScale : c'est ce qui rendait le rendu 3D flou/pixelisé)
local function updateResolution(camera)
        local f = math.clamp(camera.ViewportSize.Y / 720, 0.75, 1.75)
        local w = math.floor(CONFIG.WIDTH * f)
        local h = math.floor((CONFIG.HEIGHT_UI + (CONFIG.SHOW_HEALTH_BAR and 14 or 0)) * f)
        if mapRoot.Size.X.Offset ~= w or mapRoot.Size.Y.Offset ~= h then
                mapRoot.Size = UDim2.fromOffset(w, h)
        end
end

RunService.RenderStepped:Connect(function(dt)
        -- zoom fluide (+ snap : arrete les micro-ajustements quand c'est fini,
        -- sinon le lerp infini force les viewports a se redessiner sans arret)
        zoomCurrent = zoomCurrent + (zoomTarget - zoomCurrent) * math.min(dt * 8, 1)
        if math.abs(zoomTarget - zoomCurrent) < 0.05 then
                zoomCurrent = zoomTarget
        end

        local camera = Workspace.CurrentCamera
        if camera then
                updateResolution(camera)
        end

        local character = LocalPlayer.Character
        local myRoot = character and character:FindFirstChild("HumanoidRootPart")
        if not myRoot or not camera then
                return
        end

        -- direction regardee, projetee au sol
        local look = camera.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.001 then
                flat = Vector3.new(0, 0, -1)
        else
                flat = flat.Unit
        end
        if not CONFIG.ROTATE_WITH_PLAYER then
                flat = Vector3.new(0, 0, -1) -- nord toujours en haut
        end

        -- rotation adoucie : les mouvements de camera ne secouent plus la carte
        if CONFIG.SMOOTH_ROTATION then
                if not smoothFlat then
                        smoothFlat = flat
                else
                        smoothFlat = smoothFlat:Lerp(flat, math.min(dt * 10, 1))
                        if smoothFlat.Magnitude < 0.001 then
                                smoothFlat = flat
                        end
                        smoothFlat = smoothFlat.Unit
                end
        else
                smoothFlat = flat
        end
        flat = smoothFlat

        -- vue libre : des que tu bouges, la carte se re-centre doucement sur toi
        if panOffset.Magnitude > 0.05 then
                if not isPanning then
                        local moved = not lastPanRootPos
                                or (myRoot.Position - lastPanRootPos).Magnitude > 0.15
                        if moved then
                                panOffset = panOffset:Lerp(
                                        Vector3.zero,
                                        math.min(dt * CONFIG.PAN_RECENTER_SPEED, 1)
                                )
                        end
                end
        else
                panOffset = Vector3.zero
        end
        lastPanRootPos = myRoot.Position

        -- camera "vue du dessus", centree un peu devant nous (comme GTA)
        -- (+ le decalage de la vue libre si tu as glisse la carte)
        local camHeight = zoomCurrent / math.tan(math.rad(CONFIG.FOV * 0.5))
        local forwardShift = 2 * zoomCurrent * (CONFIG.ARROW_Y - 0.5)
        local center = myRoot.Position + flat * forwardShift + panOffset
        local topCFrame = CFrame.lookAt(center + Vector3.new(0, camHeight, 0), center, flat)

        -- LE FIX ANTI-DESYNC : la carte ET les blips utilisent EXACTEMENT la
        -- meme camera, mise a jour dans la meme frame. Les blips font partie
        -- du rendu 3D => ils restent colles a la carte, meme en rotation.
        -- OPTI v2.4 : si RIEN n'a bouge (AFK, camera fixe, zoom stable), on
        -- ne reecrit pas les cameras → on ne redeclenche pas le rendu des
        -- viewports pour rien (GPU au repos quasi nul).
        if topCFrame ~= lastTopCFrame then
                viewportCamera.CFrame = topCFrame
                blipCamera.CFrame = topCFrame
                lastTopCFrame = topCFrame
        end

        -- taille 3D des blips pour qu'ils gardent la meme taille a l'ecran
        local containerH = mapContainer.AbsoluteSize.Y
        local containerSize = mapContainer.AbsoluteSize
        if containerH > 2 then
                local studsPerPx = (2 * zoomCurrent) / containerH
                updateBlips3D(studsPerPx)
                -- pseudos 3D : colles dans la meme frame que la camera (zero desync)
                updateNames3D(studsPerPx, flat)
                -- LOD : met en veille les objets trop petits pour le zoom actuel
                lodTimer = lodTimer + dt
                if CONFIG.LOD_ENABLED and lodTimer >= CONFIG.LOD_INTERVAL then
                        lodTimer = 0
                        updateLOD(studsPerPx)
                end
        end

        -- mode toits : balayage INTELLIGENT — ne travaille que sur le delta
        -- reel, zero calcul quand rien ne bouge (meme en permanence activé)
        xrayTimer = xrayTimer + dt
        if xrayTimer >= 0.12 then
                xrayTimer = 0
                sweepXray()
        end

        updateNorth(topCFrame, containerSize)
        updateHealthBar(dt)
end)

