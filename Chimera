    --        esp script github" il renvoie DIRECTEMENT des liens pastebin.com,
    --        scriptpastebin.com, scriptblox.com, rscripts.net, github.com...
    --        Écho anti-junk natif : <title> = "Requête - ZapMeta" + h1 "Web
    --        results for <strong>Requête</strong>". Liens DIRECTS (zéro redirect).
    --        Marche aussi sur les requêtes génériques ("candy" -> walmart/wiki) et
    --        francophones ("script aimbot roblox français").
    --   v4.9.7 — PAGINATION TROUVÉE : le pager HTML utilise &pg=N (les paramètres
    --     p=/page= sont bien ignorés par le serveur, c'est pour ça qu'elle était
    --     passée inaperçue lors de la 2e campagne). Validé LIVE sur 4 requêtes x
    --     pg 1-3 : 9 + 9 + 2 = 20 résultats uniques, zéro chevauchement inter-pages,
    --     écho anti-junk présent sur CHAQUE page, burst 3x stable, vid optionnel,
    --     fin d'index détectable (pg=4/5 = 200 mais 0 carte, pg=6+ = 404).
    --   MORTS / inutilisables le même jour (2e campagne) : Bing RSS (200 mais
    --     sert les résultats d'AUTRES requêtes — encore pire que le HTML), Yahoo
    --     (500), Google gbv=1 (coquille JS sans résultats), Brave (429), Mojeek
    --     et DDG html/lite (timeout datacenter, instables entre 2 séries),
    --     MetaGer/Swisscows/search.ch/yioop (rendu JS), WebCrawler/Entireweb/
    --     Ecosia/yep (403), dogpile (202), 4get (formulaire), teclis (400),
    --     ask/aol/exactseek/oscobo (404), zapmeta /adv/ (formulaire sans results).
    -- =========================================================================

    local function stripTags(s)
        s = tostring(s):gsub("<[^>]+>", " ")
        s = s:gsub("%s+", " ")
        return s
    end

    local function urlDecode(s)
        s = tostring(s):gsub("%+", " ")
        return (s:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end))
    end

    local function isChallengePage(body)
        -- v4.6 : on ne teste que les 4 premiers Ko. Les pages challenge (Anubis,
        -- Cloudflare) sont petites avec le marqueur tout en haut. Le mot "captcha"
        -- au MILIEU d'une vraie page de resultats (dict i18n de Brave, 281 Ko)
        -- ne doit PAS faire passer le meilleur moteur pour un anti-bot.
        local head = body:sub(1, 4000):lower()
        local marks = { "proof%-of%-work", "anubis", "making sure you're not a bot",
            "just a moment", "cf%-browser%-verification", "attention required",
            "unusual traffic", "captcha", "access denied" }
        for _, m in ipairs(marks) do
            if head:find(m) then return true end
        end
        return false
    end

    local function extractDomain(u)
        return tostring(u):match("^https?://([^/]+)") or "web"
    end

    -- ZAPMETA (v4.9.6, fallback v4.9.8) : structure BEM stable, classes NON
    -- obfusquées (contrairement à Seznam) :
    --   <article class="organic-results__item organic-results-item">
    --     <h2 class="organic-results__title"><a href="URL_DIRECTE" ...>Titre</a></h2>
    --     <div class="organic-results__display-url">pastebin.com › xxx</div>
    --     <p class="organic-results__description">Snippet</p>
    --   </article>
    -- Premier href du bloc = lien résultat (l'ancre h2 vient toujours en premier).
    -- Liens internes/menus ZapMeta exclus par domaine.
    local function parseZapmeta(body)
        local out = {}
        for block in body:gmatch('<article class="organic%-results__item[^>]->(.-)</article>') do
            local url = block:match('href="(https?://.-)"')
            local h2 = block:match("<h2[^>]->(.-)</h2>")
            local rawTitle = h2 and h2:match("<a[^>]->(.-)</a>")
            if url and rawTitle and not url:find("zapmeta%.com") then
                local title = stripTags(rawTitle)
                local snip = block:match('<p class="organic%-results__description">(.-)</p>') or ""
                if title:match("%S") then
                    table.insert(out, {
                        Title = decodeHtmlEntities(title),
                        Subtitle = extractDomain(url) .. "  •  " .. decodeHtmlEntities(stripTags(snip)),
                        Url = decodeHtmlEntities(urlDecode(url))
                    })
                end
            end
        end
        return out
    end

    -- YAHOO JAPON (v4.9.8, moteur principal) : parse des cartes organiques.
    -- On splitte sur l'exact <div class="sw-Card Algo"> jusqu'à </section>
    -- (chaque carte a UNE section) : ça exclut les panneaux Yahoo internes
    -- (AnswerExploreUniversal / AnswerAiNavigation) et les éventuelles pubs,
    -- qui utilisent d'autres classes. href = lien DIRECT (tracking dans ping).
    local function parseYahoo(body)
        local out = {}
        for block in body:gmatch('<div class="sw%-Card Algo">(.-)</section>') do
            local url = block:match('<a href="(https?://[^"]+)" class="sw%-Card__titleInner"')
            local rawTitle = block:match('<h3 class="sw%-Card__titleMain[^>]->(.-)</h3>')
            if url and rawTitle and not url:find("yahoo%.co%.jp") then
                local title = stripTags(rawTitle)
                local snip = block:match('<p class="sw%-Card__summary">(.-)</p>') or ""
                if title:match("%S") then
                    table.insert(out, {
                        Title = decodeHtmlEntities(title),
                        Subtitle = extractDomain(url) .. "  •  " .. decodeHtmlEntities(stripTags(snip)),
                        Url = decodeHtmlEntities(urlDecode(url))
                    })
                end
            end
        end
        return out
    end

    -- v4.9.9 : parse du rendu MARKDOWN r.jina.ai (canal de secours UA Roblox,
    -- voir le bloc 3.5). Structure par résultat :
    --   ### [Titre](https://URL_DIRECTE)
    --   (ligne vide)
    --   **Snippet en gras** suite du snippet
    -- Le titre jina contient des sous-liens ![Image N](blob:...) et un fil
    -- d'Ariane « 1. https://domaine 2. >chemin » -> nettoyage. Le VRAI lien est
    -- le DERNIER ](...) de la ligne : pattern greedy (.+) ancré en $ -> les
    -- ](blob:...) intermédiaires restent dans le titre, captés puis nettoyés.
    local function parseYahooMarkdown(body)
        local out = {}
        local lines = {}
        for l in body:gmatch("[^\n]+") do lines[#lines + 1] = l end
        for i = 1, #lines do
            local line = lines[i]
            if line:sub(1, 4) == "### " then
                local rawTitle, url = line:match("^###%s*%[(.+)%]%((https?://[^)%s]+)%)%s*$")
                if rawTitle and url and not url:find("yahoo%.co%.jp") and url:sub(1, 5) ~= "blob:" then
                    local title = rawTitle
                        :gsub("%!%[[^%]]*%]%([^%)]*%)", " ")   -- ![Image N](blob:...)
                        :gsub("%*%*", "")                      -- gras markdown
                        :gsub("%s*%d+%.%s+https?://%S+.*$", "") -- fil d'Ariane numéroté
                        :gsub("%s+https?://%S+$", "")          -- domaine nu en fin de titre
                    title = stripTags(title)
                    if title:match("%S") then
                        -- snippet : 1re ligne non vide « propre » après le titre
                        -- (on casse sur un autre titre, une image, un lien seul,
                        -- une puce de lien, un séparateur)
                        local snip = ""
                        for j = i + 1, math.min(i + 6, #lines) do
                            local n = lines[j]
                            if n:match("%S") then
                                if n:sub(1, 1) == "#" or n:match("^%[") or n:match("^%!%[")
                                    or n:match("^%-%-%-")
                                    or (n:sub(1, 1) == "*" and n:find("](", 1, true)) then break end
                                snip = n
                                break
                            end
                        end
                        table.insert(out, {
                            Title = decodeHtmlEntities(title),
                            Subtitle = extractDomain(url) .. "  •  " .. decodeHtmlEntities(stripTags((snip:gsub("%*%*", "")))),
                            Url = decodeHtmlEntities(urlDecode(url))
                        })
                    end
                end
            end
        end
        return out
    end

    -- Détection soft-block générique : la requête doit figurer dans le <title> ou
    -- l'input name="q" de la page (ZapMeta affiche TOUJOURS la requête dans son
    -- title "... - ZapMeta" et son h1 "Web results for ...", testé live 6/6 ->
    -- si un jour ce n'est plus le cas, on affiche "aucun résultat" au lieu de
    -- résultats d'une autre requête comme Bing RSS le fait. Yahoo Japon met la
    -- requête dans son title 「...」の検索結果, testé live 5/5 -> compatible).
    local function queryMatchesPage(term, body)
        local words = {}
        for w in tostring(term):lower():gmatch("%S+") do
            if #w >= 3 then words[#words + 1] = w end
        end
        if #words == 0 then return true end -- requête trop courte : pas de vérification fiable
        local head = body:sub(1, 60000):lower()
        -- v4.9.8 : input name="q" (ZapMeta) OU name="p" (Yahoo Japon), value avant
        -- ou après name= (Yahoo : <input name="p" ... value="requête">)
        local qv = head:match('name="q"[^>]-value="([^"]*)"') or head:match('value="([^"]*)"[^>]-name="q"')
                or head:match('name="p"[^>]-value="([^"]*)"') or head:match('value="([^"]*)"[^>]-name="p"') or ""
        -- v4.9.8 : <title[^>]> — le <title> de Yahoo porte un attribut
        -- (data-next-head), le vieux pattern <title> strict ne le voyait plus
        local title = head:match("<title[^>]->(.-)</title>") or ""
        -- v4.9.9 : rendu markdown r.jina.ai — dans ce format il n'y a NI <title>
        -- NI input HTML ; la requête vit dans les marqueurs texte « Title: ... »
        -- et « URL Source: ... » (2 premières lignes du rendu jina). ATTENTION :
        -- head est déjà LOWERCASED -> les patterns sont en minuscules (piège du
        -- même genre que le <title data-next-head> de v4.9.8).
        local mdTitle = head:match("^title:%s*([^\n]*)") or head:match("\ntitle:%s*([^\n]*)") or ""
        local mdSrc = head:match("^url source:%s*([^\n]*)") or head:match("\nurl source:%s*([^\n]*)") or ""
        local function pctDec(s)
            return (tostring(s):gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end):gsub("%+", " "))
        end
        local hay = decodeHtmlEntities(pctDec(qv) .. " " .. pctDec(title) .. " " .. pctDec(mdTitle) .. " " .. pctDec(mdSrc)):lower()
        for _, w in ipairs(words) do
            if not hay:find(w, 1, true) then return false end
        end
        return true
    end

    -- =========================================================================
    -- v4.7 : MOTEURS API ROBLOX DEDIES — reverifies LIVE le 13/09 (curl, UA Roblox) :
    --   rscripts.net  : SITE = Cloudflare 403 (HTML), MAIS /api/v2/scripts?q=&page=N
    --                   = 200 JSON SANS anti-bot, et /raw/*.txt = 200 text/plain.
    --                   Le .txt est un STUB (risk notice + loadstring pastebin/github
    --                   en multi-hop) -> la chaine aboutit reellement (40 Ko de Lua).
    --                   ~1/3 des resultats = keySystem -> geres par le flag Key.
    --   scriptblox.com: /api/script/search?q= &page=N = 200 JSON (verifie),
    --                   champ script = loader loadstring(HttpGet("..."))()
    -- =========================================================================
    local function parseRscripts(body)
        local out = {}
        local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or type(data) ~= "table" or type(data.scripts) ~= "table" then return out end
        for _, s in ipairs(data.scripts) do
            if type(s) == "table" then
                local raw = tostring(s.rawScript or "")
                if raw:sub(1, 8) == "https://" then
                    local gameName = ""
                    if type(s.game) == "table" and type(s.game.title) == "string" then gameName = s.game.title end
                    local sub = "RScripts  •  " .. gameName
                    if s.keySystem == true then sub = sub .. "  •  key system" end
                    if s.mobileReady == true then sub = sub .. "  •  mobile OK" end
                    table.insert(out, {
                        Title = tostring(s.title or "RScripts script"),
                        Subtitle = sub,
                        Url = raw,
                        -- v4.9.6 FIX : RawUrl manquant -> le bouton Exécuter tombait
                        -- dans la branche "pas un script" (copie URL) au lieu de
                        -- télécharger le .txt et lancer loadstring dessus.
                        RawUrl = raw,
                        -- v4.9.3 : le keySystem RScripts bloque le play (notif claire)
                        -- au lieu d'exécuter un stub qui demande une cle et sort sans rien dire.
                        Key = (s.keySystem == true)
                    })
                end
            end
        end
        -- v4.9.3 : les NO KEY d'abord (ceux qui s'executent direct), puis plafond 14.
        -- Avant, le plafonnage pendant la construction pouvait tout remplir de keySystem.
        table.sort(out, function(a, b) return (a.Key == false) and (b.Key == true) end)
        while #out > 14 do table.remove(out) end
        return out
    end

    local function parseScriptBlox(body)
        local out = {}
        local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or type(data) ~= "table" or type(data.result) ~= "table" or type(data.result.scripts) ~= "table" then return out end
        for _, s in ipairs(data.result.scripts) do
            if type(s) == "table" and type(s.script) == "string" and #out < 14 then
                -- le loader contient l'URL brute : loadstring(game:HttpGet("https://..."))()
                -- v4.7 : capture prioritaire ENTRE QUOTES (les slugs legitimes peuvent
                -- contenir apostrophes et parentheses), fallback sans quote nettoye
                local url = s.script:match('"([^"]*https?://[^"]*)"')
                         or s.script:match("'([^']*https?://[^']*)'")
                         or s.script:match('https?://[^"%s]+')
                if url then
                    url = url:gsub("[%)%]%}%,]+$", "")
                    local gameName = ""
                    if type(s.game) == "table" and type(s.game.name) == "string" then gameName = s.game.name end
                    if s.isUniversal == true then gameName = "Tous les jeux" end
                    local sub = "ScriptBlox  •  " .. gameName
                    if s.key == true then sub = sub .. "  •  key system" end
                    table.insert(out, {
                        Title = tostring(s.title or "ScriptBlox script"),
                        Subtitle = sub,
                        Url = url
                    })
                end
            end
        end
        return out
    end

    -- FIX v4.5 : FILTRE RAW — l'utilisateur veut UNIQUEMENT des liens chargeables par
    -- loadstring(game:HttpGet(url))() (pastebin raw, github raw, gist raw...)
    local RAW_PATTERNS = {
        "raw%.githubusercontent%.com/", "pastebin%.com/raw/", "gist%.githubusercontent%.com/",
        "rscripts%.net/raw/",
        "rentry%.co/.-/raw", "hastebin%.com/raw/", "rawscripts%.net/raw/",
        "cdn%.jsdelivr%.net/gh/", "codeberg%.org/.-/raw/", "gitlab%.com/.-/raw/",
    }
    local function toRawUrl(u)
        local okR, raw = pcall(resolveRawUrl, u)
        return (okR and type(raw) == "string") and raw or u
    end

    local function isRawUrl(u)
        u = toRawUrl(u)
        for _, p in ipairs(RAW_PATTERNS) do
            if u:find(p) then return true end
        end
        return false
    end

    -- v4.9.9 : recherche web = YAHOO JAPON (moteur principal, DEUX canaux — HTML
    -- direct puis rendu r.jina.ai, voir bloc 3.5) + ZAPMETA (fallback, voir
    -- runZapmetaSearch v4.9.7 ci-dessous). page = numéro de page (1 par défaut)
    -- ; offset Yahoo = (page-1)*10+1 (&b=). seenUrls = URLs déjà affichées dans
    -- la GUI -> déduplication au fil des "Charger plus". hasMore = marqueur réel
    -- de pagination (aria-label="次のページ" en HTML, lien [次へ] en markdown) OU
    -- page pleine (>= 8 cartes).
    local function runYahooSearch(term, page, seenUrls)
        page = tonumber(page) or 1
        local q = HttpService:UrlEncode(term)
        local suffix = ""
        if page > 1 then suffix = "&b=" .. tostring((page - 1) * 10 + 1) end
        -- Canal 1 : HTML direct (server-rendered SI l'exécuteur fournit request()
        -- avec un UA Chrome — fetchBody s'en charge).
        -- Canal 2 : r.jina.ai (rendu Chrome côté jina, indépendant de l'UA local)
        -- -> sauve les exécuteurs SANS request() où game:HttpGet part en UA
        -- Roblox et où Yahoo répond le shell JS sans cartes (retour terrain :
        -- « Web • ZapMeta » systématique). Pas de ré-encodage : jina relaie
        -- l'URL entière (p= ET &b=) telle quelle (validé live).
        local candidates = {
            { url = "https://search.yahoo.co.jp/search?p=" .. q .. suffix, md = false },
            { url = "https://r.jina.ai/https://search.yahoo.co.jp/search?p=" .. q .. suffix, md = true },
        }
        local sawFetch = false
        for _, c in ipairs(candidates) do
            local okF, body = fetchBody(c.url, "text/html,application/xhtml+xml")
            if okF and type(body) == "string" and #body > 200 then
                sawFetch = true
                if not isChallengePage(body) then
                    -- garde anti-junk : la requête doit être dans la page (title
                    -- HTML, input p=, ou marqueurs Title:/URL Source: en markdown)
                    if queryMatchesPage(term, body) then
                        local okP, results = pcall(c.md and parseYahooMarkdown or parseYahoo, body)
                        if okP and type(results) == "table" and #results > 0 then
                            -- déduplication (page courante + pages déjà affichées)
                            -- + badge RAW (liens chargeables HttpGet) — contrat
                            -- identique ZapMeta v4.9.7
                            local seen, clean = {}, {}
                            if type(seenUrls) == "table" then
                                for k in pairs(seenUrls) do seen[k] = true end
                            end
                            for _, r in ipairs(results) do
                                if r.Url and not seen[r.Url] and #clean < 16 then
                                    seen[r.Url] = true
                                    if seenUrls then seenUrls[r.Url] = true end
                                    if isRawUrl(r.Url) then
                                        r.RawUrl = toRawUrl(r.Url)
