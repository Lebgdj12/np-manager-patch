            BackgroundTransparency = 1, Text = name, Font = Theme.Fonts.Header,
            TextColor3 = Theme.Current.TextSecondary, TextSize = 12
        })

        -- Indicateur Lumineux
        local bar = Create.Element("Frame", {
            Parent = btn, Size = UDim2.new(0, 0, 0, 3),
            Position = UDim2.new(0.5, 0, 1, -1), AnchorPoint = Vector2.new(0.5, 1),
            BackgroundColor3 = Theme.Current.Accent, BorderSizePixel = 0
        })
        Create.Element("UICorner", {Parent = bar, CornerRadius = UDim.new(1, 0)})
        
        -- État Interne
        local isActive = false
        if initialCheck then isActive = initialCheck() end
        
        -- Mise à jour visuelle
        local function UpdateVisual(state)
            isActive = state
            local targetColor = state and Theme.Current.Accent or Theme.Current.TextSecondary
            local targetBg = state and Color3.fromRGB(25, 25, 35) or Color3.fromRGB(15, 15, 20)
            local targetBarSize = state and UDim2.new(0.6, 0, 0, 3) or UDim2.new(0, 0, 0, 3)
            
            TweenService:Create(icon, TweenInfo.new(0.3), {ImageColor3 = targetColor}):Play()
            TweenService:Create(label, TweenInfo.new(0.3), {TextColor3 = targetColor}):Play()
            TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = targetBg}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.3), {
                Color = targetColor, 
                Transparency = state and 0.5 or 0.8
            }):Play()
            TweenService:Create(bar, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Size = targetBarSize}):Play()
        end
        
        if isActive then UpdateVisual(true) end

        btn.Activated:Connect(function()
            local newState = not isActive
            local success = pcall(function() callback(newState) end)
            if success then UpdateVisual(newState) end
        end)
        
        btn.MouseEnter:Connect(function() if not isActive then TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.4}):Play() end end)
        btn.MouseLeave:Connect(function() if not isActive then TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.8}):Play() end end)
        
        return btn
