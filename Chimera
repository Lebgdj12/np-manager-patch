-- ═══════════════════ BLIPS 3D (JOUEURS) ═══════════════════
-- Toi : une fleche blanche contour noir (comme GTA).
-- Les autres : une pastille de la couleur de leur equipe + un trait qui
-- montre leur direction. Le tout est un petit paquet de parts Neon rendues
-- par la 2e vue 3D : position EXACTE, rotation synchronisee avec la carte.

local blips = {}

local BLIP_COLORS = {
        Color3.fromRGB(122, 190, 255),
        Color3.fromRGB(255, 170, 110),
        Color3.fromRGB(158, 235, 148),
        Color3.fromRGB(255, 128, 158),
        Color3.fromRGB(198, 160, 255),
        Color3.fromRGB(120, 230, 218),
        Color3.fromRGB(255, 218, 108),
}

local BLIP_OUTLINE_COLOR = Color3.fromRGB(14, 15, 21)
local ARROW_SEGMENTS = 6 -- la fleche est un triangle "empile" de barres fines

local function colorForPlayer(pl)
        if pl.Team then
                return pl.Team.TeamColor.Color:Lerp(Color3.new(1, 1, 1), 0.3)
        end
        return BLIP_COLORS[(pl.UserId % #BLIP_COLORS) + 1]
end

-- cree une part 3D invisible pour l'instant, posee tres loin (hors champ)
local function newBlipPart(name, shape, color, material)
        return create("Part", {
                Name = name,
                Shape = shape,
                Anchored = true,
                CanCollide = false,
                CanQuery = false,
                CanTouch = false,
                CastShadow = false,
                Transparency = 1,
                Color = color,
                Material = material,
                TopSurface = Enum.SurfaceType.Smooth,
                BottomSurface = Enum.SurfaceType.Smooth,
                Size = Vector3.new(1, 1, 1),
                CFrame = CFrame.new(0, -100000, 0),
                Parent = blipWorld,
        })
end

-- ta fleche : triangle oriente vers l'avant (-Z), pivot = position du perso
local function buildArrowSpecs(pl)
        local specs = {}
        local fillParts = {}
        local width = 7.5
        local length = 11
        local segH = length / ARROW_SEGMENTS

        for i = 1, ARROW_SEGMENTS do
                local t = (i - 0.5) / ARROW_SEGMENTS
                local w = width * (1 - t) + 0.5
                local z = length / 2 - (i - 0.5) * segH

                -- contour sombre (en dessous, plus large => liseré autour)
                local outline = newBlipPart(pl.Name .. "_Out" .. i, Enum.PartType.Block, BLIP_OUTLINE_COLOR, Enum.Material.SmoothPlastic)
                table.insert(specs, {
                        part = outline,
                        baseSize = Vector3.new(w + 2.8, 1.6, segH + 0.7),
                        rel = CFrame.new(0, 0, z),
                })

                -- remplissage blanc neon (au dessus)
                local fill = newBlipPart(pl.Name .. "_Fill" .. i, Enum.PartType.Block, Color3.fromRGB(255, 255, 255), Enum.Material.Neon)
                table.insert(specs, {
                        part = fill,
                        baseSize = Vector3.new(w, 1.6, segH + 0.2),
                        rel = CFrame.new(0, 1.0, z),
                })
                table.insert(fillParts, fill)
        end

        return specs, fillParts, length
end

-- pastille des autres joueurs : rond + trait de direction, pivot = position
local function buildDiskSpecs(pl)
        local specs = {}
        local fillParts = {}
        local diskD = 8.5
        local rimD = diskD + 3.2
        local col = colorForPlayer(pl)

        -- liseré sombre
        local rim = newBlipPart(pl.Name .. "_Rim", Enum.PartType.Cylinder, BLIP_OUTLINE_COLOR, Enum.Material.SmoothPlastic)
        table.insert(specs, {
                part = rim,
                baseSize = Vector3.new(1.4, rimD, rimD),
                rel = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90)),
        })

        -- pastille couleur
        local disk = newBlipPart(pl.Name .. "_Disk", Enum.PartType.Cylinder, col, Enum.Material.Neon)
        table.insert(specs, {
                part = disk,
                baseSize = Vector3.new(2.4, diskD, diskD),
                rel = CFrame.new(0, 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
        })

        -- trait de direction (montre ou il regarde)
        local tick = newBlipPart(pl.Name .. "_Tick", Enum.PartType.Block, col, Enum.Material.Neon)
        table.insert(specs, {
                part = tick,
                baseSize = Vector3.new(1.8, 1.2, 4.4),
                rel = CFrame.new(0, 1.5, -(diskD / 2 + 1.4)),
        })
        table.insert(fillParts, disk)
        table.insert(fillParts, tick)

        return specs, fillParts, rimD
end

-- ═══ PSEUDOS EN 3D (bypass de la limite "pas de texte dans un viewport") ═══
-- Roblox interdit les TextLabels/BillboardGui DANS un ViewportFrame. Bypass :
-- on REDESSINE chaque pseudo en 3D, lettre par lettre, avec des barres Neon
-- (police bitmap 3x5, pixels fusionnes en rectangles pour limiter le nombre
-- de parts) + un fond sombre. Le pseudo vit dans le MEME monde 3D que les
-- blips, rendu par la MEME camera → decalage impossible, meme en rotation
-- tres rapide. La taille a l'ecran reste constante a tout zoom.

local FONT_3X5 = {
        A = {"010","101","111","101","101"}, B = {"110","101","110","101","110"},
        C = {"011","100","100","100","011"}, D = {"110","101","101","101","110"},
        E = {"111","100","110","100","111"}, F = {"111","100","110","100","100"},
        G = {"011","100","101","101","011"}, H = {"101","101","111","101","101"},
        I = {"111","010","010","010","111"}, J = {"001","001","001","101","010"},
        K = {"101","110","100","110","101"}, L = {"100","100","100","100","111"},
        M = {"101","111","111","101","101"}, N = {"110","101","101","101","101"},
        O = {"010","101","101","101","010"}, P = {"110","101","110","100","100"},
        Q = {"010","101","101","010","001"}, R = {"110","101","110","101","101"},
        S = {"011","100","010","001","110"}, T = {"111","010","010","010","010"},
        U = {"101","101","101","101","111"}, V = {"101","101","101","101","010"},
        W = {"101","101","111","111","101"}, X = {"101","101","010","101","101"},
        Y = {"101","101","010","010","010"}, Z = {"111","001","010","100","111"},
        ["0"] = {"111","101","101","101","111"}, ["1"] = {"010","110","010","010","111"},
        ["2"] = {"110","001","010","100","111"}, ["3"] = {"111","001","011","001","111"},
        ["4"] = {"101","101","111","001","001"}, ["5"] = {"111","100","110","001","110"},
        ["6"] = {"011","100","110","101","010"}, ["7"] = {"111","001","010","010","010"},
        ["8"] = {"111","101","010","101","111"}, ["9"] = {"010","101","011","001","010"},
        ["_"] = {"000","000","000","000","111"}, ["-"] = {"000","000","111","000","000"},
        [" "] = {"000","000","000","000","000"},
}
local UNKNOWN_GLYPH = {"010","010","000","010","010"} -- caractere non reconnu
local GLYPH_W, GLYPH_H, GLYPH_GAP = 3, 5, 1
local NAME_COLOR = Color3.fromRGB(255, 255, 255)
local NAME_BG_COLOR = Color3.fromRGB(10, 12, 18)
local NAME_PARK_Y = -100000 -- le pseudo est gare tres loin en attendant

-- decoupe un pseudo en rectangles (pixels fusionnes horizontalement puis
-- verticalement) : moins de parts pour un dessin identique
local function nameToRuns(name)
        if #name > CONFIG.NAME_MAX_CHARS then
                name = string.sub(name, 1, CONFIG.NAME_MAX_CHARS - 2) .. ".."
        end
        local glyphs = {}
        local totalW = 0
        for i = 1, #name do
                local ch = string.sub(name, i, i)
                local g = FONT_3X5[ch] or FONT_3X5[string.upper(ch)] or UNKNOWN_GLYPH
                table.insert(glyphs, g)
                totalW = totalW + GLYPH_W + (i < #name and GLYPH_GAP or 0)
        end
        if totalW == 0 then
                return nil, 0
        end

        -- a quelle lettre appartient chaque colonne
        local colGlyph, colBit = {}, {}
        local c = 1
        for _, g in ipairs(glyphs) do
                for b = 1, GLYPH_W do
                        colGlyph[c] = g
                        colBit[c] = b
                        c = c + 1
                end
                c = c + GLYPH_GAP
        end

        -- fusion horizontale des pixels allumes, rangee par rangee
        local runs = {}
        for row = 1, GLYPH_H do
                local runStart = nil
                for col = 1, totalW + 1 do
                        local on = false
                        if col <= totalW and colGlyph[col] then
                                on = string.sub(colGlyph[col][row], colBit[col], colBit[col]) == "1"
                        end
                        if on and not runStart then
                                runStart = col
                        elseif not on and runStart then
                                table.insert(runs, { x = runStart - 1, y = row - 1, w = col - runStart, h = 1 })
                                runStart = nil
                        end
                end
        end

        -- fusion verticale des rectangles alignes (gain de parts)
        table.sort(runs, function(a, b)
                if a.x ~= b.x then return a.x < b.x end
                if a.y ~= b.y then return a.y < b.y end
                return a.w < b.w
        end)
        local merged = {}
        for _, r in ipairs(runs) do
                local last = merged[#merged]
                if last and last.x == r.x and last.w == r.w and last.y + last.h == r.y then
                        last.h = last.h + 1
                else
                        table.insert(merged, { x = r.x, y = r.y, w = r.w, h = r.h })
                end
        end
        return merged, totalW
end

-- construit le pseudo 3D d'un joueur : fond sombre + lettres Neon blanches
local function buildNameModel(pl)
        local runs, totalW = nameToRuns(pl.DisplayName)
        if not runs or totalW == 0 then
                return nil
        end
        local model = Instance.new("Model")
        model.Name = "Name_" .. pl.Name

        local bg = create("Part", {
                Name = "BG", Shape = Enum.PartType.Block,
                Anchored = true, CanCollide = false, CanQuery = false,
                CanTouch = false, CastShadow = false,
                Material = Enum.Material.SmoothPlastic,
                Color = NAME_BG_COLOR, Transparency = 0.25,
                Size = Vector3.new(totalW + 2, 1.2, GLYPH_H + 2),
                CFrame = CFrame.new(0, NAME_PARK_Y, 0),
                Parent = model,
        })

        for _, r in ipairs(runs) do
                local ox = r.x + r.w / 2 - totalW / 2
                local oz = r.y + r.h / 2 - GLYPH_H / 2
                local p = create("Part", {
                        Name = "L", Shape = Enum.PartType.Block,
                        Anchored = true, CanCollide = false, CanQuery = false,
                        CanTouch = false, CastShadow = false,
                        Material = Enum.Material.Neon,
                        Color = NAME_COLOR,
                        Size = Vector3.new(r.w, 1.2, r.h),
                        CFrame = CFrame.new(ox, NAME_PARK_Y + 1.4, oz),
                        Parent = model,
                })
        end

        -- pivot fixe au centre du fond : ScaleTo/PivotTo restent previsibles
        model.WorldPivot = CFrame.new(0, NAME_PARK_Y, 0)
        model.Parent = blipWorld
        return { model = model, scale = 0, lastPos = nil }
end

local function ensureBlip(pl)
        if blips[pl] then return end
        local isSelf = (pl == LocalPlayer)
        local specs, fillParts, baseLen
        if isSelf then
                specs, fillParts, baseLen = buildArrowSpecs(pl)
        else
                specs, fillParts, baseLen = buildDiskSpecs(pl)
        end
        -- pseudo REDESSINE EN 3D (lettres Neon) au-dessus du point
        local nameModel = nil
        if not isSelf and CONFIG.SHOW_PLAYER_NAMES then
                nameModel = buildNameModel(pl)
        end

        blips[pl] = {
                specs = specs,
                fillParts = fillParts,
                baseLen = baseLen,
                isSelf = isSelf,
                team = pl.Team,
                active = false,
                nameModel = nameModel,
                lastScale = nil, -- opti v2.4 : memoire du dernier etat ecrit
                lastPos = nil,   -- (on ne reecrit que ce qui change vraiment)
                lastLook = nil,
        }
end

local function destroyBlip(pl)
        local data = blips[pl]
        if data then
                for _, spec in ipairs(data.specs) do
                        spec.part:Destroy()
                end
                if data.nameModel then
                        data.nameModel.model:Destroy()
                end
                blips[pl] = nil
        end
end

-- taille a l'ecran constante : la taille 3D des blips grandit avec le zoom
-- (studsPerPx = combien de studs du monde tiennent dans 1 pixel affiché)
-- OPTI v2.4 : plus AUCUNE ecriture inutile. Avant, chaque frame reecrivait
-- Size + CFrame + Transparency de toutes les parts de tous les blips (des
-- milliers d'ecritures/seconde meme quand tout est immobile). Desormais on
-- ne reecrit que ce qui a VRAIMENT change : taille (zoom), position,
-- orientation (rotation du perso), visibilite (mort/respawn), equipe.
local function updateBlips3D(studsPerPx)
        for pl, data in pairs(blips) do
                local character = pl.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                        -- taille 3D pour garder la meme taille a l'ecran a tout zoom
                        local targetPx = data.isSelf and CONFIG.SELF_ARROW_PX or CONFIG.BLIP_SIZE
                        local scale = (targetPx * studsPerPx) / data.baseLen
                        if scale < 0.05 then
                                scale = 0.05
                        end

                        -- reecrit les tailles SEULEMENT si le zoom a bouge (2%)
                        if not data.lastScale
                                or math.abs(scale - data.lastScale) > data.lastScale * 0.02 then
                                for _, spec in ipairs(data.specs) do
                                        spec.part.Size = spec.baseSize * scale
                                end
                                data.lastScale = scale
                        end

                        -- reecrit les positions SEULEMENT si le perso bouge/tourne
                        local pos = rootPart.Position
                        local look = rootPart.CFrame.LookVector
                        local flatLook = Vector3.new(look.X, 0, look.Z)
                        if flatLook.Magnitude < 0.001 then
                                flatLook = Vector3.new(0, 0, -1)
                        else
                                flatLook = flatLook.Unit
                        end
                        local moved = not data.lastPos
                                or (pos - data.lastPos).Magnitude > 0.03
                        local turned = not data.lastLook
                                or (flatLook - data.lastLook).Magnitude > 0.002
                        if moved or turned then
                                local lift = pos + Vector3.new(0, CONFIG.BLIP_LIFT, 0)
                                local origin = CFrame.lookAt(lift, lift + flatLook)
                                for _, spec in ipairs(data.specs) do
                                        spec.part.CFrame = origin * spec.rel
                                end
                                data.lastPos = pos
                                data.lastLook = flatLook
                        end

                        -- couleur d'equipe mise a jour (deja bloquee par comparaison)
                        if not data.isSelf and data.team ~= pl.Team then
                                data.team = pl.Team
                                local col = colorForPlayer(pl)
                                for _, part in ipairs(data.fillParts) do
                                        part.Color = col
                                end
                        end

                        -- visibilite : ecrite une seule fois au changement d'etat
                        if not data.active then
                                for _, spec in ipairs(data.specs) do
                                        spec.part.Transparency = 0
                                end
                                data.active = true
                        end
                elseif data.active then
                        -- perso absent (mort / respawn) : on cache le blip
                        for _, spec in ipairs(data.specs) do
                                spec.part.Transparency = 1
                        end
                        data.active = false
                end
        end
end

-- colle les pseudos 3D sur les blips : mis a jour dans la MEME frame que la
-- camera (meme RenderStepped, meme orientation de carte) → decalage impossible.
-- v2.3 : taille VARIABLE selon le zoom — gros en zoomé, minuscules en dezoomé.
local function updateNames3D(studsPerPx, flat)
        if not CONFIG.SHOW_PLAYER_NAMES then return end
        local right = Vector3.new(-flat.Z, 0, flat.X)
        local rotated = not namesFlat or (flat - namesFlat).Magnitude > 0.0005
        namesFlat = flat
        -- plus on dezoom, plus les pseudos rapetissent, mais courbe plus douce
        -- (exposant 0.35 au lieu de 0.45) + plancher a 7 px → toujours lisibles,
        -- meme a fond dezoomé (fini le "mush" pixelise illisible)
        local shrink = (CONFIG.VIEW_RANGE / zoomCurrent) ^ 0.35
        local namePx = math.clamp(CONFIG.NAME_HEIGHT_PX * shrink, CONFIG.NAME_MIN_PX, CONFIG.NAME_MAX_PX)
        local pxPerUnit = namePx / GLYPH_H
        local offPx = CONFIG.BLIP_SIZE * 0.5 + 2.5 + ((GLYPH_H + 2) / 2) * pxPerUnit

        for pl, data in pairs(blips) do
                local nm = data.nameModel
                if nm then
                        local rootPart = nil
                        if data.active then
                                local character = pl.Character
                                rootPart = character and character:FindFirstChild("HumanoidRootPart")
                        end
                        if rootPart then
                                -- taille selon le zoom (recalculee quand le zoom bouge)
                                local scale = pxPerUnit * studsPerPx
                                local rescaled = false
                                if math.abs(scale - nm.scale) > nm.scale * 0.05 + 0.0001 then
                                        nm.model:ScaleTo(scale)
                                        nm.scale = scale
                                        rescaled = true
                                end
                                -- on ne bouge le pseudo QUE si besoin (perso immobile + carte
                                -- immobile + zoom stable = zero calcul, gros gain en agglutinement)
                                local moved = not nm.lastPos or (rootPart.Position - nm.lastPos).Magnitude > 0.03
                                if moved or rotated or rescaled then
                                        local pos = rootPart.Position
                                                + Vector3.new(0, CONFIG.BLIP_LIFT + 1, 0)
                                                + flat * (offPx * studsPerPx)
                                        nm.model:PivotTo(CFrame.fromMatrix(pos, right, Vector3.yAxis))
                                        nm.lastPos = rootPart.Position
                                end
                                if not nm.model.Parent then
                                        nm.model.Parent = blipWorld
                                end
                        elseif nm.model.Parent then
                                nm.model.Parent = nil -- perso absent (mort / respawn) : pseudo cache
                        end
                end
        end
end

