            if getgenv().replicatesignal then replicatesignal(LocalPlayer.ConnectDiedSignalBackend) end
        end)
        pcall(function() StarterGui:SetCore("ResetButtonCallback", ResetBindable) end)
    end)
    return "WAITING"
end
