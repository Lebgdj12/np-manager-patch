    -- 3. LOGIQUE RECHERCHE (v4.8 : ScriptBlox / RScripts en API dediees + Web =
    --    vrais moteurs parses, anti-challenge : si un moteur est bloque on passe
    --    automatiquement au suivant)
    -- =========================================================================
    local function fetchBody(url, acceptType)
        -- Priorite a request() avec un User-Agent navigateur (les moteurs web l'exigent),
        -- sinon on retombe sur game:HttpGet (accepte par ScriptBlox).
        local httpRequest
        pcall(function() if typeof(syn) == "table" and syn.request then httpRequest = syn.request end end)
        if not httpRequest then httpRequest = http_request or request end
        if httpRequest then
            local okR, resp = pcall(httpRequest, {Url = url, Method = "GET", Headers = {
                ["User-Agent"] = browsers.Chrome,
                ["Accept"] = acceptType or "application/json",
                ["Accept-Language"] = "fr-FR,fr;q=0.9,en;q=0.8"
            }})
            if okR and type(resp) == "table" and resp.Body then return true, tostring(resp.Body) end
        end
        return pcall(function() return game:HttpGet(url, true) end)
    end

    local function parseSource(body)
        -- Retourne (liste, hasMore, errKind)
        if body:find("<!DOCTYPE") or body:find("<!doctype") or body:find("<html") or body:find("<body") then
            return nil, false, "blocked"
        end
        local okJson, payload = pcall(HttpService.JSONDecode, HttpService, body)
        if not okJson or type(payload) ~= "table" then return nil, false, "invalid" end
        local out = {}

        if currentSource == "ScriptBlox" then
            local resultTable = payload.result
            if type(resultTable) ~= "table" or type(resultTable.scripts) ~= "table" then return nil, false, "invalid" end
            for _, s in ipairs(resultTable.scripts) do
                if type(s) == "table" and s.title then
                    local gameName = (type(s.game) == "table" and s.game.name) or "Inconnu"
                    if s.isUniversal then gameName = "Tous les jeux" end
                    table.insert(out, {
                        Title = decodeHtmlEntities(s.title),
                        Subtitle = "ScriptBlox  •  " .. decodeHtmlEntities(gameName),
                        Script = (type(s.script) == "string") and s.script or "",
                        RawUrl = nil,
                        Key = (s.key == true),
                        Verified = (s.verified == true),
                        Universal = (s.isUniversal == true),
                        Url = "https://scriptblox.com/script/" .. tostring(s.slug or "")
                    })
                end
            end
            return out, (type(resultTable.nextPage) == "number"), nil
        else
            -- v4.8 : seules les sources API arrivent ici ; RScripts et Web ont chacune
            -- leur branche dediee dans performSearch (parseRscripts / runZapmetaSearch).
            return nil, false, "invalid"
        end
    end

    -- =========================================================================
    -- 3.5 SOURCE WEB (v4.9.9) : YAHOO JAPON moteur principal + ZAPMETA en fallback
    --   YAHOO JAPON — campagne de tests LIVE du 19/09 (curl, requêtes réelles de
    --   scripts Roblox, burst 5x) :
    --     search.yahoo.co.jp/search?p=<REQUETE>&b=<OFFSET>
    --       - ATENTION : le paramètre de requête est p= (comme l'ancien Yahoo) —
    --         avec q= le serveur répond 302 vers la home sans résultats.
    --       - b= = offset de pagination : b=1 (défaut), b=11 (page 2), b=21...
    --         (~10 cartes/page, pager de 10 pages, validé live pages 1-5).
    --       - 200 SANS aucun cookie ni session préalable (le 302 initial du test
