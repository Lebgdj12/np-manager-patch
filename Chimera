function Chimera:UpdateIndicatorState(isAnimated)
    if not self.ActivePage or not self.Pages[self.ActivePage] then return end

    local selector = self.UI.SidebarSelector
    local activeButton = self.Pages[self.ActivePage].Button
    
    if selector and activeButton then
        selector.Visible = true
        
        -- On calcule la destination
        local targetY = activeButton.Position.Y.Offset + 6 -- +6 pour centrer
        
        if isAnimated then
            -- 1. Animation de "Stretch" (S'étirer)
            -- La bulle devient plus fine (35px au lieu de 48) et plus haute (65px)
            local stretchInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(selector, stretchInfo, {
                Size = UDim2.new(0, 35, 0, 65)
            }):Play()
            
            -- 2. Le mouvement avec Rebond
            local moveInfo = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            local moveTween = TweenService:Create(selector, moveInfo, {
                Position = UDim2.new(0.5, 0, 0, targetY)
            })
            moveTween:Play()
            
            -- 3. Remise à la forme normale à l'arrivée
            task.delay(0.2, function()
                TweenService:Create(selector, TweenInfo.new(0.3, Enum.EasingStyle.Elastic), {
                    Size = UDim2.new(0, 48, 0, 48)
                }):Play()
            end)
        else
            selector.Position = UDim2.new(0.5, 0, 0, targetY)
            selector.Size = UDim2.new(0, 48, 0, 48)
        end
        
        -- Update des icônes (Blanc si actif, gris sinon)
        for name, data in pairs(self.Pages) do
            local isTarget = (name == self.ActivePage)
            TweenService:Create(data.Icon, TweenInfo.new(0.3), {ImageColor3 = isTarget and Color3.new(1,1,1) or Theme.Current.TextSecondary}):Play()
            TweenService:Create(data.Label, TweenInfo.new(0.3), {TextColor3 = isTarget and Color3.new(1,1,1) or Theme.Current.TextSecondary}):Play()
        end
    end
end

function Chimera:AnimatePageIn(page)
    if not page or not page:IsA("ScrollingFrame") then return end
    
    local i = 0
    for _, child in ipairs(page:GetChildren()) do
        if child:IsA("GuiObject") and child:GetAttribute("ThemeType") == "PrimaryGlass" then
            i = i + 1
            local originalPos = child.Position
            -- On part d'un peu plus bas
            child.Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset, originalPos.Y.Scale, originalPos.Y.Offset + 15)
            child.BackgroundTransparency = 1
            
            task.delay(i * 0.03, function() -- Délai très court entre chaque carte
                TweenService:Create(child, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { 
                    Position = originalPos, 
                    BackgroundTransparency = 0.2 -- Ou ta transparence de thème
                }):Play()
            end)
        end
    end
end
function Chimera:SwitchToPage(name)
    if not self.Pages[name] or self.ActivePage == name then return end
    
    local oldPageName = self.ActivePage
    local oldPageData = self.Pages[oldPageName]
    local newPageData = self.Pages[name]
    
    -- 1. SORTIE DE L'ANCIENNE PAGE (Disparition rapide)
    if oldPageData then
        local oldPage = oldPageData.Page
        oldPageData.LastScrollPosition = oldPage.CanvasPosition
        
        -- On la décale très peu et on la cache direct
        TweenService:Create(oldPage, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 0, 0, -10), -- Monte un tout petit peu
        }):Play()
        
        task.delay(0.1, function() oldPage.Visible = false end)
    end
    
    self.ActivePage = name
    
    -- 2. ENTRÉE DE LA NOUVELLE PAGE (L'effet Pépito)
    local newPage = newPageData.Page
    newPage.Visible = true
    -- FIX SCROLL : restaure la position de scroll sauvegardée (elle était perdue à chaque switch)
    task.defer(function()
        if newPage.Visible and newPageData.LastScrollPosition then
            newPage.CanvasPosition = newPageData.LastScrollPosition
        end
    end)
    -- On la fait partir d'un peu plus bas
    newPage.Position = UDim2.new(0, 0, 0, 15)
    
    -- Animation "Back" ultra rapide (Rebond sec)
    local entryTween = TweenService:Create(newPage, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    })
    entryTween:Play()
    
    -- 3. ANIMATION DES ÉLÉMENTS (Cascade rapide)
    -- On ne le fait que la première fois pour pas que ce soit lourd
    if not newPageData.hasAnimatedIn then
        self:AnimatePageIn(newPage)
        newPageData.hasAnimatedIn = true
    end
    
    -- 4. MISE À JOUR DE LA BULLE (Qui s'étire)
    self:UpdateIndicatorState(true)
end
function Chimera:ToggleSidebar(sidebarContainer, contentArea) 
    self.SidebarExpanded = not self.SidebarExpanded
    local targetWidth = self.SidebarExpanded and 160 or 60
    
    -- On TWEEN QUE LA LARGEUR, on ne touche JAMAIS à la position Y ni à l'AnchorPoint
    TweenService:Create(sidebarContainer, Theme.Animations.Get(), { 
        Size = UDim2.new(0, targetWidth, 0.8, 0) 
    }):Play()
    
    -- Ajustement dynamique du contenu
    TweenService:Create(contentArea, Theme.Animations.Get(), { 
        Position = UDim2.new(0, targetWidth + 15, 0, 50),
        Size = UDim2.new(1, -(targetWidth + 30), 1, -50)
    }):Play()

    -- Animation des icônes pour le mode étendu
    for _, pageData in pairs(self.Pages) do 
        if self.SidebarExpanded then
            TweenService:Create(pageData.Icon, Theme.Animations.Get(), { Position = UDim2.new(0, 30, 0.5, 0) }):Play()
            TweenService:Create(pageData.Label, Theme.Animations.Get(), { TextTransparency = 0, Position = UDim2.new(0, 55, 0.5, 0) }):Play()
        else
            TweenService:Create(pageData.Icon, Theme.Animations.Get(), { Position = UDim2.new(0.5, 0, 0.5, 0) }):Play()
            TweenService:Create(pageData.Label, Theme.Animations.Get(), { TextTransparency = 1 }):Play()
        end
    end 
end
function Chimera:UpdateCanvasSize(scrollingFrame)
    task.defer(function()
        if not scrollingFrame or not scrollingFrame.Parent then return end
        local layout = scrollingFrame:FindFirstChildOfClass("UIListLayout") or scrollingFrame:FindFirstChildOfClass("UIGridLayout")
        
        if layout then
            local contentHeight = layout.AbsoluteContentSize.Y
            -- FIX SCROLL : on inclut le padding du bas (le dernier élément était coupé)
            local pad = scrollingFrame:FindFirstChildOfClass("UIPadding")
            local bottomPad = pad and pad.PaddingBottom.Offset or 0
            -- FIX SCROLL UISCALE : AbsoluteContentSize est en pixels écran -> si un UIScale
            -- ancêtre agrandit l'UI, le canvas devenait BEAUCOUP trop long (scroll infini à vide).
            local scale = 1
            local p = scrollingFrame.Parent
            while p and p ~= workspace do
                local s = p:FindFirstChildOfClass("UIScale")
                if s then scale = scale * s.Scale end
                p = p.Parent
            end
            if scale < 0.05 then scale = 1 end
            scrollingFrame.CanvasSize = UDim2.fromOffset(0, (contentHeight + bottomPad + 10) / scale)
        end
    end)
end
