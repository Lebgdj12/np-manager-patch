                label.TextColor3 = Theme.Current.TextSecondary
                stroke.Color = Theme.Current.Secondary; stroke.Transparency = 0.65
                switchStroke.Transparency = 0.7
            end
        end
        function controller:GetState() return isOn end
        return button, controller
    end

