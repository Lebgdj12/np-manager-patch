function Chimera:ToggleFreecam(state)
    state = state and true or false
    self.State.freecamActive = state
    local UserInput = game:GetService("UserInputService")
    local RunSrv = game:GetService("RunService")

    -- Nettoyage systematique des connexions/boutons (propre a chaque appel)
    if self.Connections.Freecam then pcall(function() self.Connections.Freecam:Disconnect() end); self.Connections.Freecam = nil end
    if self.Connections.FreecamInput then pcall(function() self.Connections.FreecamInput:Disconnect() end); self.Connections.FreecamInput = nil end
    if self.State.freecamUpBtn then pcall(function() self.State.freecamUpBtn:Destroy() end); self.State.freecamUpBtn = nil end
    if self.State.freecamDownBtn then pcall(function() self.State.freecamDownBtn:Destroy() end); self.State.freecamDownBtn = nil end

    if not state then
        -- RESTORE COMPLET : camera + personnage + anchor part
        -- (si le perso a respawné pendant le freecam, on rend quand meme la camera au NOUVEAU humanoid)
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if self.State.freecamAnchoredChar == char and char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.Anchored = false end
            end
            if hum then Camera.CameraSubject = hum end
            Camera.CameraType = Enum.CameraType.Custom
        end)
        if self.State.freecamPart then pcall(function() self.State.freecamPart:Destroy() end); self.State.freecamPart = nil end
        self.State.freecamAnchoredChar = nil
        self:ShowNotification("notif_feature_toggled", "Freecam", T("notif_state_off"))
        return true
    end

    -- CONSTRUCTION
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hrp) then
        self.State.freecamActive = false
        self:ShowNotification("notif_freecam_nochar")
        return false
    end

    self.State.freecamSpeed = self.State.freecamSpeed or 60
    local anchor = Instance.new("Part")
    anchor.Name = "ChimeraFreecamAnchor"
    anchor.Size = Vector3.new(1, 1, 1)
    anchor.Transparency = 1
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanQuery = false
    anchor.CanTouch = false
    anchor.CFrame = hrp.CFrame + Vector3.new(0, 4, 0)
    anchor.Parent = Workspace
    self.State.freecamPart = anchor
    self.State.freecamAnchoredChar = char

    hrp.Anchored = true -- le perso reste sur place pendant l'exploration
    Camera.CameraSubject = anchor

    -- Boutons tactiles MONTE / DESCEND (mobile + souris)
    local holder = self.ScreenGui or PlayerGui
    local function makeVBtn(txt, posY)
        local b = Create.Element("TextButton", {
            Name = "FreecamVBtn" .. txt, Parent = holder, Size = UDim2.new(0, 46, 0, 46),
            Position = UDim2.new(1, -75, 0.5, posY), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Theme.Current.Secondary, BackgroundTransparency = 0.25,
            Text = txt, Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = Theme.Current.TextPrimary,
            AutoButtonColor = false, ZIndex = 60, Visible = true
        })
        b:SetAttribute("ThemeType", "SecondaryGlass")
        Create.Element("UICorner", {CornerRadius = UDim.new(1, 0), Parent = b})
        local st = Create.Element("UIStroke", {Parent = b, Color = Theme.Current.Accent, Thickness = 1.2, Transparency = 0.55})
        st:SetAttribute("ThemeType", "AccentStroke")
        return b
    end
    local upBtn = makeVBtn("▲", -60)
    local downBtn = makeVBtn("▼", 10)
    self.State.freecamUpBtn = upBtn
    self.State.freecamDownBtn = downBtn

    local verticalInput = 0
    upBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then verticalInput = 1 end end)
    downBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then verticalInput = -1 end end)
    self.Connections.FreecamInput = UserInput.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then verticalInput = 0 end
    end)

    -- BOUCLE DE DEPLACEMENT
    self.Connections.Freecam = RunSrv.RenderStepped:Connect(function(dt)
        if not self.State.freecamActive then return end
        local cam = Workspace.CurrentCamera
        local camCF = cam.CFrame
        local moveDir = Vector3.new(0, 0, 0)
        local mode = Chimera.State.flyKeyMode or "WASD"
        local Fwd = (mode == "ZQSD" and Enum.KeyCode.Z or Enum.KeyCode.W)
        local Left = (mode == "ZQSD" and Enum.KeyCode.Q or Enum.KeyCode.A)
        if UserInput:IsKeyDown(Fwd) or UserInput:IsKeyDown(Enum.KeyCode.Up) then moveDir = moveDir + camCF.LookVector end
        if UserInput:IsKeyDown(Enum.KeyCode.S) or UserInput:IsKeyDown(Enum.KeyCode.Down) then moveDir = moveDir - camCF.LookVector end
        if UserInput:IsKeyDown(Left) or UserInput:IsKeyDown(Enum.KeyCode.Left) then moveDir = moveDir - camCF.RightVector end
        if UserInput:IsKeyDown(Enum.KeyCode.D) or UserInput:IsKeyDown(Enum.KeyCode.Right) then moveDir = moveDir + camCF.RightVector end
        if UserInput:IsKeyDown(Enum.KeyCode.Space) or UserInput:IsKeyDown(Enum.KeyCode.ButtonA) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInput:IsKeyDown(Enum.KeyCode.LeftControl) or UserInput:IsKeyDown(Enum.KeyCode.ButtonB) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        -- Mobile : le joystick gauche pilote l'ancre via MoveDirection
        if moveDir.Magnitude < 0.01 and char and char.Parent and hum and hum.MoveDirection.Magnitude > 0 then
            local md = hum.MoveDirection
            moveDir = Vector3.new(md.X, 0, md.Z)
        end
        moveDir = moveDir + Vector3.new(0, verticalInput, 0)
        if moveDir.Magnitude > 0.01 then
            local boost = UserInput:IsKeyDown(Enum.KeyCode.LeftShift) and 2.5 or 1
            anchor.CFrame = anchor.CFrame + (moveDir.Unit * self.State.freecamSpeed * boost * dt)
        end
    end)

    self:ShowNotification("notif_freecam_on", 7)
    return true
end
