-- -- Table des noms de couleurs originaux
local chatColorNames = {"Bright red", "Bright blue", "Earth green", "Bright violet", "Bright orange", "Bright yellow", "Light reddish violet", "Brick yellow"}

local function GetOriginalRobloxColor(name)
    local len = #name
    local sum = 0
    
    for i = 1, len do
        local charCode = string.byte(string.sub(name, i, i))
        local reverseIndex = len - i + 1
        
        -- Cette partie est CRUCIALE pour l'algorithme original
        if len % 2 == 1 then
            reverseIndex = reverseIndex - 1
        end
        
        if reverseIndex % 4 >= 2 then
            sum = sum - charCode
        else
            sum = sum + charCode
        end
    end
    
    -- Calcul de l'index (Roblox fait sum % 8 + 1)
    local index = (sum % #chatColorNames) + 1
    local colorName = chatColorNames[index]
    
    return BrickColor.new(colorName).Color
end

