function Chimera:StartLoadingSequence(platform, launcherFrame, launcherGui)
    local ContentProvider = game:GetService("ContentProvider")
    local skipRequested = false -- Variable pour suivre si le bouton Skip a été cliqué

    -- 1. Transformation du Launcher en écran de chargement
    local buttons = {}
    for _, child in ipairs(launcherFrame:GetChildren()) do
        if child:IsA("TextButton") then table.insert(buttons, child) end
        if child.Name == "Subtitle" then child.Visible = false end
    end
    
    for _, btn in ipairs(buttons) do
        TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 0)}):Play()
        local txt = btn:FindFirstChild("Text") or btn:FindFirstChildOfClass("TextLabel")
        if txt then TweenService:Create(txt, TweenInfo.new(0.3), {TextTransparency = 1}):Play() end
    end
    task.wait(0.3)
    for _, btn in ipairs(buttons) do btn.Visible = false end

    -- 2. Création de la barre de chargement
    local loadingBarContainer = Create.Element("Frame", {
        Name = "LoadingContainer", Parent = launcherFrame,
        Size = UDim2.new(0.8, 0, 0, 6), Position = UDim2.new(0.5, 0, 0.6, 0), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Current.Secondary, BackgroundTransparency = 0.5
    })
    Create.Element("UICorner", {CornerRadius = UDim.new(1, 0), Parent = loadingBarContainer})
    
    local loadingBarFill = Create.Element("Frame", {
        Name = "Fill", Parent = loadingBarContainer,
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Current.Accent
    })
    Create.Element("UICorner", {CornerRadius = UDim.new(1, 0), Parent = loadingBarFill})

    local statusText = Create.Element("TextLabel", {
        Parent = launcherFrame,
        Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0.5, 0, 0.75, 0), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1, Font = Theme.Fonts.Code, Text = "Initialisation...",
        TextColor3 = Theme.Current.TextSecondary, TextSize = 12
    })

    -- 2.5 Création du bouton SKIP
    local skipButton = Create.Button(launcherFrame, "Skip", 999, function()
        skipRequested = true
    end, UDim2.new(0, 60, 0, 25))
    skipButton.Position = UDim2.new(0.5, 0, 0.85, 0)
    skipButton.AnchorPoint = Vector2.new(0.5, 0.5)
    -- Style spécifique pour le bouton Skip (discret)
    skipButton.BackgroundColor3 = Theme.Current.Secondary
    skipButton.BackgroundTransparency = 0.5
    -- On cherche le Stroke et on ne modifie la transparence QUE s'il existe
local sStroke = skipButton:FindFirstChild("UIStroke")
if sStroke then 
    sStroke.Transparency = 0.8 
end
    local skipText = skipButton:FindFirstChild("Text")
    if skipText then skipText.TextSize = 10 end

    -- Fonction de mise à jour de la progression qui vérifie si on a demandé le skip
    local function UpdateProgress(percent, text)
        if skipRequested then return end -- Si skip demandé, on ne met plus à jour via cette fonction
        statusText.Text = text
        TweenService:Create(loadingBarFill, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {Size = UDim2.new(percent, 0, 1, 0)}):Play()
        task.wait(0.05) -- Petit délai pour l'animation
    end

    -- 3. PRÉCHARGEMENT DES ASSETS (Lancement en tâche de fond)
    -- On lance le préchargement, mais on ne l'attend pas si on skip.
    task.spawn(function()
        local assetsToLoad = {}
        for _, id in pairs(Theme.Icons) do table.insert(assetsToLoad, id) end
        table.insert(assetsToLoad, "rbxassetid://115144477221204") 
        table.insert(assetsToLoad, "rbxassetid://2716591855")
        table.insert(assetsToLoad, "http://www.roblox.com/asset/?id=130093050")
        table.insert(assetsToLoad, "http://www.roblox.com/asset/?id=130093033")
        
        local players = game:GetService("Players"):GetPlayers()
        for i = 1, math.min(#players, 10) do
            local p = players[i]
            local tempThumb = Instance.new("ImageLabel")
            local okT, thumbT = pcall(game:GetService("Players").GetUserThumbnailAsync, game:GetService("Players"), p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48); if okT then tempThumb.Image = thumbT end
            table.insert(assetsToLoad, tempThumb)
        end
        
        pcall(function() ContentProvider:PreloadAsync(assetsToLoad) end)
    end)

    -- Séquence de chargement avec vérification du Skip
    if not skipRequested then UpdateProgress(0.1, "Préchargement des assets graphiques...") end
    
    -- Construction de l'interface (Essentielle, ne peut pas être skippée totalement, mais on accélère)
    if not skipRequested then UpdateProgress(0.2, "Configuration de l'environnement...") end
    self.OriginalValues.Gravity = workspace.Gravity
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    self.OriginalValues.WalkSpeed = hum.WalkSpeed
    self.OriginalValues.JumpPower = hum.JumpPower
    self.Platform = platform

    if not skipRequested then UpdateProgress(0.3, "Construction du cadre principal...") end
    self.ScreenGui = Create.Element("ScreenGui", { Name = "ChimeraUI", Parent = PlayerGui, ResetOnSpawn = false, DisplayOrder = 1 })
    
    -- Lancement de la construction de l'UI principale
    -- On utilise task.spawn pour que Init ne bloque pas la détection du clic sur Skip si c'est long
    task.spawn(function()
        self:Init(platform, true)
    end)

    -- Attente des modules (avec vérification du skip à chaque étape)
    local function SafeWait(condition)
        while not condition() do
            if skipRequested then return true end -- Si skip, on sort de la boucle immédiatement
            task.wait()
        end
        return false -- Pas skippé
    end

    if not skipRequested then UpdateProgress(0.4, "Chargement du module Home...") end
    SafeWait(function() return self.Pages["Home"] end)
    
    if not skipRequested then UpdateProgress(0.5, "Chargement du module Player & Avatars...") end
    SafeWait(function() return self.Pages["Player"] end)
    
    if not skipRequested then UpdateProgress(0.6, "Chargement du module Visuals...") end
    SafeWait(function() return self.Pages["Visuals"] end)
    
    if not skipRequested then UpdateProgress(0.7, "Chargement du module Searcher...") end
    SafeWait(function() return self.Pages["Searcher"] end)
    
    if not skipRequested then UpdateProgress(0.8, "Initialisation ChatSpy & HttpSpy...") end
    SafeWait(function() return self.Pages["ChatSpy"] and self.Pages["HttpSpy"] end)
    
    if not skipRequested then 
        UpdateProgress(0.9, "Vérification des assets...")
        task.wait(0.2) 
    end
    
    -- Si on a cliqué sur Skip, on force la barre à 100% et on change le texte
    if skipRequested then
        statusText.Text = "Skipping..."
        loadingBarFill.Size = UDim2.new(1, 0, 1, 0)
        -- On s'assure que Init a eu le temps de créer les pages minimales
        -- (Init est rapide, donc généralement c'est déjà bon, mais par sécurité)
        if not self.Pages["Home"] then
             -- Petit délai de sécurité si le skip est pressé instantanément
             task.wait(0.5) 
        end
    else
        UpdateProgress(1, "Lancement de Chimera...")
        task.wait(0.5)
    end

    -- 5. Transition finale
    if skipButton then skipButton:Destroy() end -- On retire le bouton
    
    TweenService:Create(launcherFrame, Theme.Animations.Get(), { Size = UDim2.new(0,0,0,0), Position = UDim2.new(0.5,0,0.5,0), BackgroundTransparency = 1 }):Play()
    task.wait(Theme.Animations.Speed)
    launcherGui:Destroy()
    
    if self.MainFrame then
        self.MainFrame.Visible = true
        local mainFrameContent = self.MainFrame:FindFirstChild("MainContent")
        if mainFrameContent then
            mainFrameContent.BackgroundTransparency = 1
            local openTween = TweenService:Create(self.MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = self.State.BaseSize, Position = self.State.OriginalPosition})
            openTween:Play()
            task.wait(0.2)
            TweenService:Create(mainFrameContent, Theme.Animations.Get(), {BackgroundTransparency = Theme.Glass.Transparency}):Play()
        end
    end
    
    self:AnnounceInConsole("CHIMERA v2.4 - PRÊT (Assets Préchargés).", Theme.Current.Success)
end
