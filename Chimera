    Create.Element("UIStroke", {Parent = previewContainer, Color = Theme.Current.Accent, Thickness = 1, Transparency = 0.6})
    
    local previewLabel = Create.Element("TextLabel", {
        Parent = previewContainer, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1, Text = "Aperçu en direct...", Font = Theme.Fonts.Code,
        TextColor3 = Theme.Current.Accent, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    })

    local inputContainer = Create.Element("Frame", {
        Parent = inputCard, Size = UDim2.new(1, 0, 0, 50), Position = UDim2.new(0, 0, 0, 85), BackgroundTransparency = 1
    })
    
    local inputBox = Create.Element("TextBox", {
        Parent = inputContainer, Size = UDim2.new(1, -60, 1, 0), 
        BackgroundColor3 = Theme.Current.Secondary, TextColor3 = Theme.Current.TextPrimary,
        PlaceholderText = "Entrez votre message...", Font = Theme.Fonts.Body, TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false
    })
    Create.Element("UICorner", {Parent = inputBox, CornerRadius = UDim.new(0, 8)})
    Create.Element("UIPadding", {Parent = inputBox, PaddingLeft = UDim.new(0, 15)})
    
    local sendBtn = Create.Element("ImageButton", {
        Parent = inputContainer, Size = UDim2.new(0, 50, 0, 50), Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = Theme.Current.Accent, Image = "rbxassetid://7072718300", ImageColor3 = Theme.Current.TextPrimary
    })
    Create.Element("UICorner", {Parent = sendBtn, CornerRadius = UDim.new(0, 8)})

    -- LOGIQUE D'ENVOI STRICTE
    local function SendMessage()
        local message = inputBox.Text
        if message == "" then return end
        
        local finalMsg = ApplyBypass(message)
        
        -- CHECK FILTER (CRUCIAL)
        statusLabel.Text = "⏳ VÉRIFICATION DU FILTRE..."
        statusContainer.BackgroundColor3 = Theme.Current.Warning; statusLabel.TextColor3 = Theme.Current.Warning
        task.wait(0.1)
        
        if not CheckIfFiltered(finalMsg) then
            statusLabel.Text = "⛔ BLOQUÉ : TAGS DÉTECTÉS !"
            statusContainer.BackgroundColor3 = Theme.Current.Error; statusLabel.TextColor3 = Theme.Current.Error
            
            -- Shake Effect
            for i = 1, 5 do inputBox.Position = UDim2.new(0, math.random(-5,5), 0, 0); task.wait(0.05) end
            inputBox.Position = UDim2.new(0, 0, 0, 0)
            return -- STOP : ON N'ENVOIE PAS
        end
        
        -- SI OK : ENVOI
        statusLabel.Text = "✓ ENVOI SÉCURISÉ..."
        statusContainer.BackgroundColor3 = Theme.Current.Success; statusLabel.TextColor3 = Theme.Current.Success

        TweenService:Create(sendBtn, TweenInfo.new(0.1), {Size = UDim2.new(0, 45, 0, 45)}):Play()
        task.wait(0.1)
        TweenService:Create(sendBtn, TweenInfo.new(0.1), {Size = UDim2.new(0, 50, 0, 50)}):Play()

        if TextChatService and TextChatService:FindFirstChild("TextChannels") and TextChatService.TextChannels.RBXGeneral then
            pcall(function() TextChatService.TextChannels.RBXGeneral:SendAsync(finalMsg) end)
        else
            game.Players:Chat(finalMsg)
        end
        
        inputBox.Text = ""
        previewLabel.Text = "Message envoyé avec succès."
        
        -- MODIFICATION ICI : DELAI REDUIT A 0.8 SECONDES
        task.delay(0.8, function() 
            statusLabel.Text = "✓ PRÊT À ENVOYER"
            statusContainer.BackgroundColor3 = Theme.Current.Success
            statusLabel.TextColor3 = Theme.Current.Success 
        end)
    end

    sendBtn.Activated:Connect(SendMessage)
    inputBox.FocusLost:Connect(function(enter) if enter then SendMessage() end end)
    
    inputBox:GetPropertyChangedSignal("Text"):Connect(function()
        if inputBox.Text == "" then
            previewLabel.Text = "Aperçu en direct..."
            previewLabel.TextColor3 = Theme.Current.TextSecondary
        else
            previewLabel.Text = ApplyBypass(inputBox.Text)
            previewLabel.TextColor3 = Theme.Current.Accent
        end
    end)

    -- =========================================================================
    -- 2. UI : SÉLECTEUR DE STYLE
    -- =========================================================================
    local stylesCard = Create.Card(page, "Styles de Bypass", 2)
    local stylesGrid = Create.Element("Frame", {
        Parent = stylesCard, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1
    })
    Create.Element("UIGridLayout", {
        Parent = stylesGrid, CellPadding = UDim2.new(0, 10, 0, 10), 
        CellSize = UDim2.new(0.31, 0, 0, 80), HorizontalAlignment = Enum.HorizontalAlignment.Center
    })

    local fontButtons = {}

    for i, font in ipairs(chatBypassFonts) do
        local btn = Create.Element("TextButton", {
            Parent = stylesGrid, BackgroundColor3 = Theme.Current.Secondary, BackgroundTransparency = 0.6,
            Text = "", AutoButtonColor = false
        })
        Create.Element("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 8)})
        local stroke = Create.Element("UIStroke", {Parent = btn, Color = Theme.Current.Secondary, Thickness = 1.5, Transparency = 0.5})
        
        Create.Element("TextLabel", {
            Parent = btn, Size = UDim2.new(1, 0, 0.6, 0), Position = UDim2.new(0, 0, 0.1, 0),
            BackgroundTransparency = 1, Text = font.Preview, Font = Theme.Fonts.Title,
            TextColor3 = Theme.Current.TextPrimary, TextSize = 20, TextTruncate = Enum.TextTruncate.AtEnd
        })
        
        Create.Element("TextLabel", {
            Parent = btn, Size = UDim2.new(1, 0, 0.3, 0), Position = UDim2.new(0, 0, 0.7, 0),
            BackgroundTransparency = 1, Text = font.Name, Font = Theme.Fonts.Body,
            TextColor3 = Theme.Current.TextSecondary, TextSize = 10, TextTruncate = Enum.TextTruncate.AtEnd
        })

        btn.Activated:Connect(function()
            currentFont = font
            for idx, b in pairs(fontButtons) do
                local isSelected = (idx == i)
                local s = b:FindFirstChild("UIStroke")
                TweenService:Create(b, TweenInfo.new(0.3), {BackgroundColor3 = isSelected and Theme.Current.Primary or Theme.Current.Secondary, BackgroundTransparency = isSelected and 0.3 or 0.6}):Play()
                TweenService:Create(s, TweenInfo.new(0.3), {Color = isSelected and Theme.Current.Accent or Theme.Current.Secondary, Transparency = isSelected and 0 or 0.5}):Play()
            end
            if inputBox.Text ~= "" then previewLabel.Text = ApplyBypass(inputBox.Text) end
            self:ShowNotification("notif_bypass_font_selected", font.Name)
        end)
        
        table.insert(fontButtons, btn)
        if i == 1 then
            btn.BackgroundTransparency = 0.3; btn.BackgroundColor3 = Theme.Current.Primary
            stroke.Color = Theme.Current.Accent; stroke.Transparency = 0
        end
    end

    self:UpdateCanvasSize(page)
end
