            TweenService:Create(fill, TweenInfo.new(dragging and 0 or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(visualPct, 0, 1, 0)}):Play()
            TweenService:Create(infKnob, TweenInfo.new(dragging and 0 or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(visualPct, 0, 0.5, 0)}):Play()
            if not fromInput then valueBox.Text = string.format("%.1f", val) end
            pcall(callback, val)
        end
        trigger.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; TweenService:Create(infKnobScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.15}):Play(); local pos = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1); UpdateVisuals(min + (max - min) * pos, false) end end)
        trigger.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false; TweenService:Create(infKnobScale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play() end end)
        UserInputService.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then local pos = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1); UpdateVisuals(min + (max - min) * pos, false) end end)
        -- v4.9.4 : applique sur Entrée ET au clic ailleurs ; virgule acceptée
        valueBox.FocusLost:Connect(function() local n = tonumber((valueBox.Text:gsub(",", "."))); if n then UpdateVisuals(n, false) else valueBox.Text = tostring(default) end end)
        UpdateVisuals(default, false)
        return {SetValue = function(self, v) UpdateVisuals(v, false) end}
    end

    -- 2. Toggle Vibrant
    local function CreateVibrantToggle(parent, text, callback, defaultState)
        local button = Create.Element("TextButton", {Parent = parent, Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = Theme.Current.Secondary, BackgroundTransparency = 0.75, Text = "", AutoButtonColor = false, LayoutOrder = 2})
