    local function Encrypt(str) local res={}; for i=1,#str do local b=string.byte(str,i); local k=string.byte(CRYPT_KEY,(i-1)%#CRYPT_KEY+1); table.insert(res,string.format("%02X",bit32.bxor(b,k))) end; return "CHM-"..table.concat(res) end
    local function Decrypt(str) if not str:match("^CHM%-") then return nil end; str=str:sub(5); local res={}; for i=1,#str/2 do local hex=str:sub((i-1)*2+1,(i-1)*2+2); local b=tonumber(hex,16); if not b then return nil end; local k=string.byte(CRYPT_KEY,(i-1)%#CRYPT_KEY+1); table.insert(res,string.char(bit32.bxor(b,k))) end; return table.concat(res) end

