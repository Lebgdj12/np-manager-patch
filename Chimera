        -- garde anti-junk : si la page ne correspond pas à la requête (cache d'un
        -- autre utilisateur...), on n'affiche rien.
        if not queryMatchesPage(term, body) then return nil, false, "empty" end
        local okP, results = pcall(parseZapmeta, body)
        if not okP or type(results) ~= "table" or #results == 0 then return nil, false, "empty" end
        -- déduplication (page courante + pages déjà affichées) + badge RAW
